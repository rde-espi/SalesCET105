<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoFinalCet105.Mobile.Views.NovaMarcacaoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F8F5EF"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="24,35,24,25"
        RowDefinitions="Auto,*">

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*"
            Margin="0,0,0,25">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="#191919"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="40"
                HeightRequest="40"
                Clicked="Voltar_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="AGENDAR"
                    TextColor="#BEA256"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="2" />

                <Label
                    Text="Nova marcação"
                    TextColor="#191919"
                    FontSize="26"
                    FontAttributes="Bold" />

            </VerticalStackLayout>

        </Grid>

        <!-- Formulário -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="16">

                <Label
                    Text="Escolha o serviço"
                    TextColor="#191919"
                    FontSize="14"
                    FontAttributes="Bold" />

                <Border
                    BackgroundColor="White"
                    Stroke="#E5DDD1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <Picker
                        Title="Selecionar serviço"
                        ItemsSource="{Binding Servicos}"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedItem="{Binding ServicoSelecionado}"
                        TextColor="#191919"
                        TitleColor="#817A70" />

                </Border>

                <!-- Informações do serviço selecionado -->
                <Border
                    IsVisible="{Binding ServicoSelecionado}"
                    Margin="0,5,0,0"
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#E5DDD1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="{Binding ServicoSelecionado.Nome}"
                            TextColor="#191919"
                            FontSize="18"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding ServicoSelecionado.Descricao}"
                            TextColor="#817A70"
                            FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="{Binding ServicoSelecionado.DuracaoMinutos,
                                StringFormat='Duração: {0} min'}"
                                TextColor="#535333"
                                FontSize="13" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ServicoSelecionado.Preco,
                                StringFormat='{}{0:F2} €'}"
                                TextColor="#BEA256"
                                FontSize="15"
                                FontAttributes="Bold" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- PROFISSIONAL -->
                <VerticalStackLayout
    IsVisible="{Binding TemServicoSelecionado}"
    Spacing="10"
    Margin="0,10,0,0">

                    <Label
        Text="Escolha o profissional"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <Border
        BackgroundColor="White"
        Stroke="#E5DDD1"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14"
        Padding="12,4">

                        <Picker
            Title="Selecionar profissional"
            ItemsSource="{Binding Funcionarios}"
            ItemDisplayBinding="{Binding NomeCompleto}"
            SelectedItem="{Binding FuncionarioSelecionado}"
            TextColor="#191919"
            TitleColor="#817A70" />

                    </Border>

                    <ActivityIndicator
        IsVisible="{Binding ACarregarFuncionarios}"
        IsRunning="{Binding ACarregarFuncionarios}"
        Color="#BEA256"
        HorizontalOptions="Center" />

                </VerticalStackLayout>
                <!-- DATA -->
                <VerticalStackLayout
    IsVisible="{Binding TemFuncionarioSelecionado}"
    Spacing="10"
    Margin="0,10,0,0">

                    <Label
        Text="Escolha a data"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <Border
        BackgroundColor="White"
        Stroke="#E5DDD1"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14"
        Padding="12,4">

                        <DatePicker
            Date="{Binding DataSelecionada}"
            MinimumDate="{Binding DataMinima}"
            Format="dd/MM/yyyy"
            TextColor="#191919" />

                    </Border>

                </VerticalStackLayout>
                <!-- HORÁRIOS -->
                <VerticalStackLayout
    IsVisible="{Binding TemFuncionarioSelecionado}"
    Spacing="10"
    Margin="0,10,0,0">

                    <Label
        Text="Escolha o horário"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <ActivityIndicator
        IsVisible="{Binding ACarregarHorarios}"
        IsRunning="{Binding ACarregarHorarios}"
        Color="#BEA256"
        HorizontalOptions="Center" />

                    <CollectionView
        ItemsSource="{Binding HorariosDisponiveis}"
        SelectedItem="{Binding HorarioSelecionado}"
        SelectionMode="Single"
        ItemsLayout="HorizontalList"
        HeightRequest="65">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                    Margin="0,0,10,0"
                    Padding="18,10"
                    BackgroundColor="White"
                    Stroke="#D8B071"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                                    <Label
                        Text="{Binding ., StringFormat='{0:HH:mm}'}"
                        TextColor="#191919"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

                <!-- CONFIRMAÇÃO -->
                <VerticalStackLayout
    IsVisible="{Binding HorarioSelecionado}"
    Spacing="16"
    Margin="0,12,0,20">

                    <!-- Observações -->
                    <Label
        Text="Observações"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <Border
        BackgroundColor="White"
        Stroke="#E5DDD1"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14"
        Padding="12">

                        <Editor
            Text="{Binding Observacoes}"
            Placeholder="Observações adicionais (opcional)"
            PlaceholderColor="#817A70"
            TextColor="#191919"
            AutoSize="TextChanges"
            MinimumHeightRequest="80" />

                    </Border>

                    <!-- Resumo -->
                    <Border
        Margin="0,5,0,0"
        Padding="18"
        BackgroundColor="#191919"
        Stroke="#191919"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="10">

                            <Label
                Text="RESUMO DA MARCAÇÃO"
                TextColor="#D8B071"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="2" />

                            <Label
                Text="{Binding ServicoSelecionado.Nome}"
                TextColor="White"
                FontSize="18"
                FontAttributes="Bold" />

                            <Label
                Text="{Binding FuncionarioSelecionado.NomeCompleto,
                StringFormat='Profissional: {0}'}"
                TextColor="#F8F5EF"
                FontSize="13" />

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                    Grid.Column="0"
                    Text="{Binding HorarioSelecionado,
                    StringFormat='{0:dd/MM/yyyy · HH:mm}'}"
                    TextColor="#F8F5EF"
                    FontSize="13"
                    FontAttributes="Bold" />

                                <Label
                    Grid.Column="1"
                    Text="{Binding ServicoSelecionado.Preco,
                    StringFormat='{}{0:F2} €'}"
                    TextColor="#D8B071"
                    FontSize="15"
                    FontAttributes="Bold" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Confirmar -->
                    <Button
        Text="Confirmar marcação"
        IsEnabled="{Binding PodeConfirmar}"
        BackgroundColor="#D8B071"
        TextColor="#191919"
        FontAttributes="Bold"
        HeightRequest="52"
        Command="{Binding ConfirmarMarcacaoCommand}"
        CornerRadius="14" />
                    <Label
    IsVisible="{Binding TemSucesso}"
    Text="{Binding MensagemSucesso}"
    TextColor="#BEA256"
    FontSize="14"
    FontAttributes="Bold"
    HorizontalTextAlignment="Center" />

                    <ActivityIndicator
        IsVisible="{Binding AGuardar}"
        IsRunning="{Binding AGuardar}"
        Color="#BEA256"
        HorizontalOptions="Center" />

                </VerticalStackLayout>

                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="#BEA256"
                    HorizontalOptions="Center"
                    Margin="0,15,0,0" />

                <Label
                    IsVisible="{Binding TemErro}"
                    Text="{Binding MensagemErro}"
                    TextColor="#A94442"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
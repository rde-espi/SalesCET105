<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjetoFinalCet105.Mobile.Views.NovaMarcacaoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F8F5EF"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="24,35,24,25"
        RowDefinitions="Auto,*">

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*"
            Margin="0,0,0,25">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="#191919"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="40"
                HeightRequest="40"
                Clicked="Voltar_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="AGENDAR"
                    TextColor="#BEA256"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="2" />

                <Label
                    Text="Nova marcação"
                    TextColor="#191919"
                    FontSize="26"
                    FontAttributes="Bold" />

            </VerticalStackLayout>

        </Grid>

        <!-- Formulário -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="16">

                <Label
                    Text="Escolha o serviço"
                    TextColor="#191919"
                    FontSize="14"
                    FontAttributes="Bold" />

                <Border
                    BackgroundColor="White"
                    Stroke="#E5DDD1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,4">

                    <Picker
                        Title="Selecionar serviço"
                        ItemsSource="{Binding Servicos}"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedItem="{Binding ServicoSelecionado}"
                        TextColor="#191919"
                        TitleColor="#817A70" />                  
                </Border>

                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="#BEA256"
                    HorizontalOptions="Center"
                    Margin="0,6,0,0"
                    WidthRequest="28"
                    HeightRequest="28" />

                <!-- Informações do serviço selecionado -->
                <Border
                    IsVisible="{Binding ServicoSelecionado}"
                    Margin="0,5,0,0"
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#E5DDD1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="{Binding ServicoSelecionado.Nome}"
                            TextColor="#191919"
                            FontSize="18"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding ServicoSelecionado.Descricao}"
                            TextColor="#817A70"
                            FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="{Binding ServicoSelecionado.DuracaoMinutos,
                                StringFormat='Duração: {0} min'}"
                                TextColor="#535333"
                                FontSize="13" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ServicoSelecionado.Preco,
                                StringFormat='{}{0:F2} €'}"
                                TextColor="#BEA256"
                                FontSize="15"
                                FontAttributes="Bold" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- PROFISSIONAL -->
                <VerticalStackLayout
    IsVisible="{Binding TemServicoSelecionado}"
    Spacing="10"
    Margin="0,10,0,0">

                    <Label
        Text="Escolha o profissional"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <Border
        BackgroundColor="White"
        Stroke="#E5DDD1"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14"
        Padding="12,4">

                        <Picker
            Title="Selecionar profissional"
            ItemsSource="{Binding Funcionarios}"
            ItemDisplayBinding="{Binding NomeCompleto}"
            SelectedItem="{Binding FuncionarioSelecionado}"
            TextColor="#191919"
            TitleColor="#817A70" />

                    </Border>

                    <ActivityIndicator
        IsVisible="{Binding ACarregarFuncionarios}"
        IsRunning="{Binding ACarregarFuncionarios}"
        Color="#BEA256"
        HorizontalOptions="Center" />

                </VerticalStackLayout>


                <!-- DATAS DISPONÍVEIS -->
                <VerticalStackLayout
    Spacing="10"
    IsVisible="{Binding TemFuncionarioSelecionado}">

                    <Label
        Text="Escolha uma data disponível"
        FontSize="13"
        FontAttributes="Bold"
        TextColor="#535333" />

                    <!-- A PROCURAR DATAS -->
                    <VerticalStackLayout
        Spacing="8"
        IsVisible="{Binding ACarregarDatas}">

                        <ActivityIndicator
            IsRunning="{Binding ACarregarDatas}"
            Color="#BEA256"
            HorizontalOptions="Center"
            WidthRequest="28"
            HeightRequest="28" />

                        <Label
            Text="A procurar datas disponíveis..."
            FontSize="12"
            TextColor="#817A70"
            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- DATAS ENCONTRADAS -->
                    <CollectionView
                        ItemsSource="{Binding DatasDisponiveis}"
                        SelectedItem="{Binding DataDisponivelSelecionada}"
                        SelectionMode="Single"
                        IsVisible="{Binding TemDatasDisponiveis}"
                        HeightRequest="105">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Horizontal"
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                    Padding="14,10"
                    MinimumWidthRequest="92"
                    BackgroundColor="#F8F5EF"
                    Stroke="#D8B071"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                                        <HorizontalStackLayout
                            Spacing="4"
                            HorizontalOptions="Center">

                                            <Label
                                Text="{Binding Dia}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#191919" />

                                            <Label
                                Text="{Binding Mes}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#BEA256"
                                VerticalTextAlignment="Center" />

                                        </HorizontalStackLayout>

                                        <Label
                            Text="{Binding DiaSemana}"
                            FontSize="11"
                            TextColor="#535333"
                            HorizontalTextAlignment="Center" />

                                        <Label
                            Text="{Binding TextoHorarios}"
                            FontSize="10"
                            TextColor="#817A70"
                            HorizontalTextAlignment="Center" />

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>



                <!-- HORÁRIOS -->
                <VerticalStackLayout
    IsVisible="{Binding TemFuncionarioSelecionado}"
    Spacing="10"
    Margin="0,10,0,0">

                    <Label
        Text="Escolha o horário"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <ActivityIndicator
        IsVisible="{Binding ACarregarHorarios}"
        IsRunning="{Binding ACarregarHorarios}"
        Color="#BEA256"
        HorizontalOptions="Center" />

                    <CollectionView
        ItemsSource="{Binding HorariosDisponiveis}"
        SelectedItem="{Binding HorarioSelecionado}"
        SelectionMode="Single"
        ItemsLayout="HorizontalList"
        HeightRequest="65">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                    Margin="0,0,10,0"
                    Padding="18,10"
                    BackgroundColor="White"
                    Stroke="#D8B071"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">

                                    <Label
                        Text="{Binding ., StringFormat='{0:HH:mm}'}"
                        TextColor="#191919"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

                <!-- CONFIRMAÇÃO -->
                <VerticalStackLayout
    IsVisible="{Binding HorarioSelecionado}"
    Spacing="16"
    Margin="0,12,0,20">

                    <!-- Observações -->
                    <Label
        Text="Observações"
        TextColor="#191919"
        FontSize="14"
        FontAttributes="Bold" />

                    <Border
        BackgroundColor="White"
        Stroke="#E5DDD1"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14"
        Padding="12">

                        <Editor
            Text="{Binding Observacoes}"
            Placeholder="Observações adicionais (opcional)"
            PlaceholderColor="#817A70"
            TextColor="#191919"
            AutoSize="TextChanges"
            MinimumHeightRequest="80" />

                    </Border>

                    <!-- Resumo -->
                    <Border
        Margin="0,5,0,0"
        Padding="18"
        BackgroundColor="#191919"
        Stroke="#191919"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="10">

                            <Label
                Text="RESUMO DA MARCAÇÃO"
                TextColor="#D8B071"
                FontSize="10"
                FontAttributes="Bold"
                CharacterSpacing="2" />

                            <Label
                Text="{Binding ServicoSelecionado.Nome}"
                TextColor="White"
                FontSize="18"
                FontAttributes="Bold" />

                            <Label
                Text="{Binding FuncionarioSelecionado.NomeCompleto,
                StringFormat='Profissional: {0}'}"
                TextColor="#F8F5EF"
                FontSize="13" />

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                    Grid.Column="0"
                    Text="{Binding HorarioSelecionado,
                    StringFormat='{0:dd/MM/yyyy · HH:mm}'}"
                    TextColor="#F8F5EF"
                    FontSize="13"
                    FontAttributes="Bold" />

                                <Label
                    Grid.Column="1"
                    Text="{Binding ServicoSelecionado.Preco,
                    StringFormat='{}{0:F2} €'}"
                    TextColor="#D8B071"
                    FontSize="15"
                    FontAttributes="Bold" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Confirmar -->
                    <Button
        Text="Confirmar marcação"
        IsEnabled="{Binding PodeConfirmar}"
        BackgroundColor="#D8B071"
        TextColor="#191919"
        FontAttributes="Bold"
        HeightRequest="52"
        Command="{Binding ConfirmarMarcacaoCommand}"
        CornerRadius="14" />
                                      
                </VerticalStackLayout>                

                <Label
                    IsVisible="{Binding TemErro}"
                    Text="{Binding MensagemErro}"
                    TextColor="#A94442"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- LOADING OVERLAY -->
        <Grid
    Grid.RowSpan="2"
    IsVisible="{Binding AGuardar}"
    BackgroundColor="#80000000"
    InputTransparent="False"
    ZIndex="100">

            <Border
        Padding="28,24"
        BackgroundColor="#191919"
        Stroke="#D8B071"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        HorizontalOptions="Center"
        VerticalOptions="Center">

                <VerticalStackLayout
            Spacing="14"
            HorizontalOptions="Center">

                    <ActivityIndicator
                IsRunning="{Binding AGuardar}"
                Color="#D8B071"
                WidthRequest="38"
                HeightRequest="38" />

                    <Label
                Text="A confirmar marcação..."
                TextColor="#FFFFFF"
                FontSize="14"
                HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

        </Grid>
        <!-- SUCESSO DA MARCAÇÃO -->
        <Grid
    Grid.RowSpan="2"
    IsVisible="{Binding TemSucesso}"
    BackgroundColor="#99000000"
    InputTransparent="False"
    ZIndex="110">

            <Border
        Margin="30"
        Padding="30"
        BackgroundColor="#F8F5EF"
        Stroke="#D8B071"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 22"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        MaximumWidthRequest="380">

                <VerticalStackLayout
            Spacing="16"
            HorizontalOptions="Fill">

                    <Border
                WidthRequest="58"
                HeightRequest="58"
                BackgroundColor="#191919"
                Stroke="#D8B071"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 29"
                HorizontalOptions="Center">

                        <Label
                    Text="✓"
                    TextColor="#D8B071"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                    </Border>

                    <Label
                Text="Marcação Efetuada!"
                TextColor="#191919"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

                    <Label
                Text="A sua marcação foi efetuada com sucesso."
                TextColor="#817A70"
                FontSize="14"
                HorizontalTextAlignment="Center" />

                    <Button
                Text="Ver as minhas marcações"
                BackgroundColor="#191919"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="14"
                Clicked="VerMarcacoes_Clicked" />

                </VerticalStackLayout>

            </Border>

        </Grid>
    </Grid>

</ContentPage>
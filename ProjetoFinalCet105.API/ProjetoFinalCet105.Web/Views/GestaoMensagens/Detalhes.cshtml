@model ProjetoFinalCet105.Web.Models.ConversaViewModel

@{
    ViewData["Title"] = "Detalhes da conversa";
    Layout = "_AdminLayout";

    var clienteInicial = !string.IsNullOrWhiteSpace(Model.ClienteNome)
        ? Model.ClienteNome.Substring(0, 1).ToUpper()
        : "C";

    var funcionarioInicial = !string.IsNullOrWhiteSpace(Model.FuncionarioNome)
        ? Model.FuncionarioNome.Substring(0, 1).ToUpper()
        : "P";
}

<div class="ib-categories-page">

    <!-- CABEÇALHO -->
    <div class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">COMUNICAÇÃO</span>
            <h1>Detalhes da conversa</h1>
            <p>Consulte o histórico de comunicação entre o cliente e o profissional.</p>
        </div>

        <a asp-controller="GestaoMensagens"
           asp-action="Index"
           class="ib-category-back-btn">
            Voltar
        </a>
    </div>

    <!-- PARTICIPANTES -->
    <div class="ib-category-panel ib-chat-participants-panel">

        <div class="ib-chat-participants">

            <!-- CLIENTE -->
            <div class="ib-chat-participant">

                <div class="ib-employee-avatar">
                    <span class="ib-employee-initials">
                        @clienteInicial
                    </span>
                </div>

                <div>
                    <small>Cliente</small>
                    <strong>@Model.ClienteNome</strong>
                </div>

            </div>

            <div class="ib-chat-participant-arrow">
                <svg viewBox="0 0 24 24"
                     width="25"
                     height="25"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path d="M7 7h11l-3-3" />
                    <path d="M17 17H6l3 3" />
                </svg>
            </div>

            <!-- PROFISSIONAL -->
            <div class="ib-chat-participant">

                <div class="ib-employee-avatar">
                    <span class="ib-employee-initials">
                        @funcionarioInicial
                    </span>
                </div>

                <div>
                    <small>Profissional</small>
                    <strong>@Model.FuncionarioNome</strong>
                </div>

            </div>

            <div class="ib-chat-created">
                <small>Conversa iniciada</small>
                <strong>@Model.DataCriacao.ToString("dd/MM/yyyy")</strong>
                <span>@Model.DataCriacao.ToString("HH:mm")</span>
            </div>

        </div>

    </div>

    <!-- HISTÓRICO -->
    <div class="ib-category-panel ib-chat-panel">

        <div class="ib-category-panel-header">

            <div>
                <span class="ib-section-eyebrow">SUPERVISÃO</span>
                <h2>Histórico da conversa</h2>
                <p>Mensagens trocadas entre cliente e profissional.</p>
            </div>

            <div class="ib-chat-readonly-badge">
                <svg viewBox="0 0 24 24"
                     width="15"
                     height="15"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7">
                    <path d="M12 17v.01" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                </svg>

                Apenas leitura
            </div>

        </div>

        @if (Model.Mensagens == null || !Model.Mensagens.Any())
        {
            <div class="ib-mensagens-empty">

                <div class="ib-mensagens-empty-icon">
                    <svg viewBox="0 0 24 24"
                         width="27"
                         height="27"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6">
                        <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                    </svg>
                </div>

                <strong>Sem mensagens</strong>
                <span>Ainda não existem mensagens nesta conversa.</span>

            </div>
        }
        else
        {
            <div class="ib-chat-history">

                @foreach (var mensagem in Model.Mensagens.OrderBy(m => m.DataEnvio))
                {
                    var mensagemCliente =
                        mensagem.RemetenteId == Model.ClienteId;

                    <div class="ib-chat-message @(mensagemCliente ? "cliente" : "profissional")">

                        <div class="ib-chat-message-sender">
                            @(mensagemCliente ? Model.ClienteNome : Model.FuncionarioNome)
                        </div>

                        <div class="ib-chat-bubble">

                            <p>@mensagem.Texto</p>

                            <div class="ib-chat-message-meta">

                                <span>
                                    @mensagem.DataEnvio.ToString("dd/MM/yyyy · HH:mm")
                                </span>

                                @if (mensagem.Lida)
                                {
                                    <span class="ib-chat-read-status">
                                        <svg viewBox="0 0 24 24"
                                             width="15"
                                             height="15"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">
                                            <path d="M2 12l5 5L17 7" />
                                            <path d="M9 12l5 5L22 7" />
                                        </svg>

                                        Lida
                                    </span>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        <!-- AVISO SUPERVISÃO -->
        <div class="ib-chat-supervision-note">

            <svg viewBox="0 0 24 24"
                 width="17"
                 height="17"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" />
                <path d="M12 8h.01" />
            </svg>

            <span>
                Modo de supervisão — esta conversa está disponível apenas para consulta.
            </span>

        </div>

    </div>

</div>
@{
    ViewData["Title"] = "Sobre o projeto";
    Layout = "_PublicLayout";
}

<section class="ib-about-page">

    <header class="ib-about-hero">

        <span class="ib-section-eyebrow">SOBRE O PROJETO</span>

       <div class="ib-about-brand">
    <img src="~/images/logo.png"
         alt="Infinity Beauty - Center Spa Wellness" />
</div>

        <p class="ib-about-lead">
            Um projeto académico pensado e desenvolvido
            como uma experiência real.
        </p>

    </header>


    <div class="ib-about-content">

        <section class="ib-about-intro">

            <p>
                O <strong>Infinity Beauty – Center Spa Wellness</strong>
                é um projeto académico desenvolvido no âmbito do curso de
                <strong>Técnico/a de Programação de Sistemas de Informação (TPSI)</strong>,
                com o objetivo de aplicar, de forma integrada, os conhecimentos
                e competências adquiridos ao longo da formação.
            </p>

            <p>
                Desenvolvido por <strong>Reinaldo Espindola Souza</strong>,
                o projeto representa a criação de uma solução digital para
                a gestão de um centro de estética e bem-estar, procurando
                aproximar o contexto académico das necessidades e desafios
                de uma aplicação real.
            </p>

        </section>


        <div class="ib-about-divider"></div>


        <section class="ib-about-section">

            <span class="ib-section-eyebrow">
                DESENVOLVIMENTO
            </span>

            <h2>Da aprendizagem à aplicação prática.</h2>

            <p>
                A plataforma integra diferentes áreas de utilização,
                permitindo a gestão de serviços, profissionais, clientes,
                marcações, disponibilidades, avaliações e informação de
                apoio à gestão.
            </p>

            <p>
                O Infinity Beauty procura demonstrar a aplicação prática
                de conceitos de programação, desenvolvimento Web,
                bases de dados, arquitetura de software e experiência
                do utilizador, reunidos numa solução coerente,
                funcional e orientada para diferentes perfis de utilização.
            </p>

        </section>


        <section class="ib-about-academic">

            <div class="ib-about-academic-heading">
                <span class="ib-section-eyebrow">
                    CONTEXTO ACADÉMICO
                </span>

                <h2>Ficha do projeto</h2>
            </div>

            <dl class="ib-about-facts">

                <div>
                    <dt>Projeto</dt>
                    <dd>Infinity Beauty – Center Spa Wellness</dd>
                </div>

                <div>
                    <dt>Autor</dt>
                    <dd>Reinaldo Espindola Souza</dd>
                </div>

                <div>
                    <dt>Formação</dt>
                    <dd>
                        Técnico/a de Programação de Sistemas
                        de Informação (TPSI)
                    </dd>
                </div>

                <div>
                    <dt>Entidade formadora</dt>
                    <dd>CINEL</dd>
                </div>

                <div>
                    <dt>Natureza</dt>
                    <dd>Projeto académico</dd>
                </div>

            </dl>

        </section>


        <aside class="ib-about-notice">

            <span class="ib-about-notice-mark">IB</span>

            <div>
                <strong>Projeto de caráter académico</strong>

                <p>
                    O Infinity Beauty foi desenvolvido para fins
                    de aprendizagem e demonstração. As marcas,
                    serviços, profissionais, preços, marcações e
                    restantes informações apresentadas na aplicação
                    destinam-se à demonstração das funcionalidades
                    implementadas.
                </p>
            </div>

        </aside>

    </div>

</section>
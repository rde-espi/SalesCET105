async function carregarDatasDisponiveis() {

    datasDisponiveisContainer.innerHTML =
        "<p>A carregar datas disponíveis...</p>";

    horariosSection.hidden = true;
    horariosDisponiveisContainer.innerHTML = "";

    dataHoraInput.value = "";
    continuarDataHoraButton.disabled = true;

    try {

        const response = await fetch(
            `/MarcacoesCliente/DatasDisponiveis` +
            `?funcionarioId=${funcionarioInput.value}` +
            `&servicoId=${servicoInput.value}`
        );

        if (!response.ok) {
            throw new Error("Erro ao carregar datas.");
        }

        const datas = await response.json();

        if (!datas || datas.length === 0) {

            datasDisponiveisContainer.innerHTML =
                `<div class="ib-booking-availability-empty">
                    Não existem datas disponíveis nos próximos 30 dias.
                 </div>`;

            return;
        }

        datasDisponiveisContainer.innerHTML = "";

        datas.forEach(item => {

            const card = document.createElement("button");

            card.type = "button";
            card.className = "ib-booking-date-card";
            card.dataset.data = item.data;

            card.innerHTML = `
                <span class="ib-booking-date-weekday">
                    ${item.diaSemana}
                </span>

                <strong class="ib-booking-date-day">
                    ${item.dia}
                </strong>

                <span class="ib-booking-date-month">
                    ${item.mes}
                </span>

                <span class="ib-booking-card-check"
                      aria-hidden="true">
                    ✓
                </span>
            `;

            card.addEventListener("click", async function () {

                document
                    .querySelectorAll(".ib-booking-date-card")
                    .forEach(item =>
                        item.classList.remove("selected"));

                this.classList.add("selected");

                dataHoraInput.value = "";

                continuarDataHoraButton.disabled = true;
await carregarHorariosDisponiveis(
    this.dataset.data
);
            });

            datasDisponiveisContainer.appendChild(card);

        });

    }
    catch (error) {

        datasDisponiveisContainer.innerHTML =
            `<div class="ib-booking-availability-empty">
                Não foi possível carregar as datas disponíveis.
             </div>`;

    }
}

async function carregarHorariosDisponiveis(dataSelecionada) {

    horariosSection.hidden = false;

    horariosDisponiveisContainer.innerHTML =
        "<p>A carregar horários disponíveis...</p>";

    dataHoraInput.value = "";
    continuarDataHoraButton.disabled = true;

    try {

        const response = await fetch(
            `/MarcacoesCliente/HorariosDisponiveis` +
            `?funcionarioId=${funcionarioInput.value}` +
            `&servicoId=${servicoInput.value}` +
            `&data=${dataSelecionada}`
        );

        if (!response.ok) {
            throw new Error("Erro ao carregar horários.");
        }

        const horarios = await response.json();

        if (!horarios || horarios.length === 0) {

            horariosDisponiveisContainer.innerHTML =
                `<div class="ib-booking-availability-empty">
                    Não existem horários disponíveis para esta data.
                 </div>`;

            return;
        }

        horariosDisponiveisContainer.innerHTML = "";

        horarios.forEach(horario => {

            const dataHora = new Date(horario);

            const horaFormatada =
                dataHora.toLocaleTimeString("pt-PT", {
                    hour: "2-digit",
                    minute: "2-digit"
                });

            const button = document.createElement("button");

            button.type = "button";
            button.className = "ib-booking-time-card";
            button.dataset.dataHora = horario;
            button.textContent = horaFormatada;

            button.addEventListener("click", function () {

                document
                    .querySelectorAll(".ib-booking-time-card")
                    .forEach(item =>
                        item.classList.remove("selected"));

                this.classList.add("selected");

                dataHoraInput.value =
                    this.dataset.dataHora;

                continuarDataHoraButton.disabled = false;

            });

            horariosDisponiveisContainer.appendChild(button);

        });

    }
    catch (error) {

        horariosDisponiveisContainer.innerHTML =
            `<div class="ib-booking-availability-empty">
                Não foi possível carregar os horários disponíveis.
             </div>`;
    }
}

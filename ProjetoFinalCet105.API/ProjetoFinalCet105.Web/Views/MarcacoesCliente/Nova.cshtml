@model ProjetoFinalCet105.Web.Models.NovaMarcacaoClienteViewModel

@{
    ViewData["Title"] = "Nova marcação";
    Layout = "~/Views/Shared/_ClienteLayout.cshtml";
}

<div class="ib-booking">

    <!-- CABEÇALHO -->
    <header class="ib-booking-header">
        <span class="ib-cliente-page-eyebrow">NOVA MARCAÇÃO</span>

        <h1>Marque o seu momento</h1>

        <p>
            Escolha o serviço, o profissional e o horário que mais lhe convém.
        </p>
    </header>


    <!-- ROADMAP -->
    <div class="ib-booking-roadmap">

        <div class="ib-booking-step active" data-step="1">
            <span class="ib-booking-step-number">1</span>
            <span>Serviço</span>
        </div>

        <span class="ib-booking-step-line"></span>

        <div class="ib-booking-step" data-step="2">
            <span class="ib-booking-step-number">2</span>
            <span>Profissional</span>
        </div>

        <span class="ib-booking-step-line"></span>

        <div class="ib-booking-step" data-step="3">
            <span class="ib-booking-step-number">3</span>
            <span>Data e hora</span>
        </div>

        <span class="ib-booking-step-line"></span>

        <div class="ib-booking-step" data-step="4">
            <span class="ib-booking-step-number">4</span>
            <span>Detalhes</span>
        </div>

        <span class="ib-booking-step-line"></span>

        <div class="ib-booking-step" data-step="5">
            <span class="ib-booking-step-number">5</span>
            <span>Confirmar</span>
        </div>

    </div>


    <form asp-action="Nova"
          asp-controller="MarcacoesCliente"
          method="post"
          id="formNovaMarcacao">

        @Html.AntiForgeryToken()

        <input asp-for="ServicoId"
               type="hidden"
               id="ServicoId" />

        <input asp-for="FuncionarioId"
               type="hidden"
               id="FuncionarioId" />

        <input asp-for="DataHoraInicio"
               type="hidden"
               id="DataHoraInicio" />


        <!-- =====================================================
             PASSO 1 — SERVIÇO
        ====================================================== -->

        <section class="ib-booking-panel active"
                 id="wizardEtapa1">

            <div class="ib-booking-panel-heading">

                <span class="ib-booking-kicker">
                    PASSO 1 DE 5
                </span>

                <h2>Escolha o serviço</h2>

                <p>
                    Comece por selecionar uma categoria e depois escolha o serviço pretendido.
                </p>

            </div>


            <!-- CATEGORIAS -->
            <div class="ib-booking-section">

                <h3>Escolha uma categoria</h3>

                <div class="ib-booking-category-scroll">

                    <div class="ib-booking-categories">

                        @foreach (var categoria in Model.Categorias
                            .Where(c => c.Ativa)
                            .OrderBy(c => c.Nome))
                        {
                            <button type="button"
                                    class="ib-booking-category-card"
                                    data-categoria-id="@categoria.Id">

                                <div class="ib-booking-category-image">

                                    <img src="@Url.Action(
                                                                                      "ImagemCategoria",
                                                                                      "MarcacoesCliente",
                                                                                      new { id = categoria.Id })"
                                         alt="@categoria.Nome"
                                         loading="lazy"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="ib-booking-image-fallback">
                                        <span>
                                            @categoria.Nome.Substring(0, 1).ToUpper()
                                        </span>
                                    </div>

                                </div>


                                <div class="ib-booking-category-content">

                                    <strong>
                                        @categoria.Nome
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(categoria.Descricao))
                                    {
                                        <span>
                                            @categoria.Descricao
                                        </span>
                                    }

                                </div>


                                <span class="ib-booking-card-check"
                                      aria-hidden="true">
                                    ✓
                                </span>

                            </button>
                        }

                    </div>

                </div>

            </div>


            <!-- SERVIÇOS -->
            <div class="ib-booking-section">

                <div class="ib-booking-services-heading">

                    <div>
                        <h3>Escolha o serviço</h3>

                        <span id="servicosAjuda">
                            Selecione primeiro uma categoria.
                        </span>
                    </div>

                </div>


                <div class="ib-booking-services-scroll">

                    <div class="ib-booking-services"
                         id="servicosTrack">

                        @foreach (var servico in Model.Servicos
                            .Where(s => s.Disponivel)
                            .OrderBy(s => s.Nome))
                        {
                            <button type="button"
                                    class="ib-booking-service-card"
                                    data-servico-id="@servico.Id"
                                    data-categoria-id="@servico.CategoriaId"
                                    data-servico-nome="@servico.Nome"
                                    hidden>

                                <div class="ib-booking-service-image">

                                    <img src="@Url.Action(
                                                                                      "ImagemServico",
                                                                                      "MarcacoesCliente",
                                                                                      new { id = servico.Id })"
                                         alt="@servico.Nome"
                                         loading="lazy"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="ib-booking-image-fallback">
                                        <span>
                                            @servico.Nome.Substring(0, 1).ToUpper()
                                        </span>
                                    </div>

                                </div>


                                <div class="ib-booking-service-content">

                                    <div class="ib-booking-service-top">

                                        <div>
                                            <h4>@servico.Nome</h4>

                                            @if (!string.IsNullOrWhiteSpace(servico.Descricao))
                                            {
                                                <p>
                                                    @servico.Descricao
                                                </p>
                                            }
                                        </div>


                                        <span class="ib-booking-card-check"
                                              aria-hidden="true">
                                            ✓
                                        </span>

                                    </div>


                                    <div class="ib-booking-service-meta">

                                        <span>
                                            <svg viewBox="0 0 24 24"
                                                 aria-hidden="true">
                                                <circle cx="12"
                                                        cy="12"
                                                        r="9"></circle>

                                                <path d="M12 7v5l3 2"></path>
                                            </svg>

                                            @servico.DuracaoMinutos min
                                        </span>


                                        <strong>
                                            @servico.Preco.ToString("N2") €
                                        </strong>

                                    </div>

                                </div>

                            </button>
                        }

                    </div>

                </div>

            </div>


            <span asp-validation-for="ServicoId"
                  class="text-danger">
            </span>


            <!-- AÇÕES -->
            <div class="ib-booking-actions">

                <a asp-controller="MarcacoesCliente"
                   asp-action="Index"
                   class="ib-booking-btn-secondary">
                    Cancelar
                </a>


                <button type="button"
                        class="ib-booking-btn-primary"
                        id="btnContinuarServico"
                        disabled>
                    Continuar
                    <span aria-hidden="true">→</span>
                </button>

            </div>

        </section>
        <!-- =====================================================
     PASSO 2 — PROFISSIONAL
====================================================== -->

<section class="ib-booking-panel" id="wizardEtapa2">

    <div class="ib-booking-panel-heading">

        <span class="ib-booking-kicker">
            PASSO 2 DE 5
        </span>

        <h2>Escolha o profissional</h2>

        <p>
            Selecione o profissional que pretende para realizar o serviço escolhido.
        </p>

    </div>


    <div class="ib-booking-section">

        <div id="profissionaisContainer">

            <p>
                A carregar profissionais...
            </p>

        </div>

    </div>


    <span asp-validation-for="FuncionarioId"
          class="text-danger">
    </span>


    <div class="ib-booking-actions">

        <button type="button"
                class="ib-booking-btn-secondary"
                id="btnVoltarServico">
            <span aria-hidden="true">←</span>
            Voltar
        </button>


        <button type="button"
                class="ib-booking-btn-primary"
                id="btnContinuarProfissional"
                disabled>
            Continuar
            <span aria-hidden="true">→</span>
        </button>

    </div>

</section>
<!-- =====================================================
     PASSO 3 — DATA E HORA
====================================================== -->

<section class="ib-booking-panel"
         id="wizardEtapa3">

    <div class="ib-booking-panel-heading">

        <span class="ib-booking-kicker">
            PASSO 3 DE 5
        </span>

        <h2>Escolha a data e a hora</h2>

        <p>
            Consulte os próximos dias disponíveis e escolha o horário
            que mais lhe convém.
        </p>

    </div>


    <!-- DATAS -->
    <div class="ib-booking-section">

        <h3>Datas disponíveis</h3>

        <div id="datasDisponiveisContainer">
            <p>A carregar datas disponíveis...</p>
        </div>

    </div>


    <!-- HORÁRIOS -->
    <div class="ib-booking-section"
         id="horariosSection"
         hidden>

        <h3>Horários disponíveis</h3>

        <div id="horariosDisponiveisContainer">
        </div>

    </div>


    <span asp-validation-for="DataHoraInicio"
          class="text-danger">
    </span>


    <!-- AÇÕES -->
    <div class="ib-booking-actions">

        <button type="button"
                class="ib-booking-btn-secondary"
                id="btnVoltarProfissional">
            <span aria-hidden="true">←</span>
            Voltar
        </button>


        <button type="button"
                class="ib-booking-btn-primary"
                id="btnContinuarDataHora"
                disabled>
            Continuar
            <span aria-hidden="true">→</span>
        </button>

    </div>

</section>
<!-- =====================================================
     PASSO 4 — DETALHES
====================================================== -->

<section class="ib-booking-panel"
         id="wizardEtapa4">

    <div class="ib-booking-panel-heading">

        <span class="ib-booking-kicker">
            PASSO 4 DE 5
        </span>

        <h2>Detalhes da marcação</h2>

        <p>
            Se desejar, deixe alguma indicação adicional
            para o profissional.
        </p>

    </div>


    <div class="ib-booking-section">

        <h3>Observações</h3>

        <div class="ib-booking-observations">

            <textarea asp-for="Observacoes"
                      class="ib-booking-textarea"
                      rows="5"
                      maxlength="500"
                      placeholder="Ex.: preferências, cuidados especiais ou outra informação que considere importante."></textarea>

            <span asp-validation-for="Observacoes"
                  class="text-danger">
            </span>

            <small class="ib-booking-field-hint">
                Campo opcional · máximo 500 caracteres
            </small>

        </div>

    </div>


    <div class="ib-booking-actions">

        <button type="button"
                class="ib-booking-btn-secondary"
                id="btnVoltarDataHora">
            <span aria-hidden="true">←</span>
            Voltar
        </button>


        <button type="button"
                class="ib-booking-btn-primary"
                id="btnContinuarDetalhes">
            Continuar
            <span aria-hidden="true">→</span>
        </button>

    </div>

</section>

<!-- =====================================================
     PASSO 5 — CONFIRMAR
====================================================== -->

<section class="ib-booking-panel"
         id="wizardEtapa5">

    <div class="ib-booking-panel-heading">

    <span class="ib-booking-kicker">
        PASSO 5 DE 5
    </span>

    <h2>Confirmar marcação</h2>

    <p>
        Reveja os detalhes da sua marcação antes de confirmar.
    </p>

</div>


<div class="ib-booking-confirm-layout">

    <!-- ==========================================
         SERVIÇO
    =========================================== -->

    <div class="ib-booking-confirm-service">

        <div class="ib-booking-confirm-service-image">

            <img id="resumoServicoImagem"
                 src=""
                 alt=""
                 hidden />

            <div class="ib-booking-confirm-service-fallback"
                 id="resumoServicoFallback">
                <span id="resumoServicoInicial">—</span>
            </div>

        </div>


        <div class="ib-booking-confirm-service-body">

            <span class="ib-booking-confirm-label">
                SERVIÇO
            </span>

            <h3 id="resumoServico">—</h3>

            <p id="resumoServicoDescricao">
                —
            </p>


            <div class="ib-booking-confirm-service-footer">

                <div class="ib-booking-confirm-duration">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <circle cx="12"
                                cy="12"
                                r="9"></circle>
                        <path d="M12 7v5l3 2"></path>
                    </svg>

                    <span id="resumoDuracao">
                        —
                    </span>

                </div>


                <strong id="resumoPrecoServico">
                    —
                </strong>

            </div>

        </div>

    </div>


    <!-- ==========================================
         PROFISSIONAL + DATA
    =========================================== -->

    <div class="ib-booking-confirm-details">

        <span class="ib-booking-confirm-label">
            PROFISSIONAL
        </span>


        <div class="ib-booking-confirm-professional">

            <div class="ib-booking-confirm-professional-photo">

                <img id="resumoProfissionalImagem"
                     src=""
                     alt=""
                     hidden />

                <div class="ib-booking-confirm-professional-fallback"
                     id="resumoProfissionalFallback">
                    <span id="resumoProfissionalInicial">—</span>
                </div>

            </div>


            <div class="ib-booking-confirm-professional-info">

                <strong id="resumoProfissional">
                    —
                </strong>

                <span id="resumoProfissionalDescricao">
                    Profissional selecionado
                </span>

            </div>

        </div>


        <div class="ib-booking-confirm-divider"></div>


        <div class="ib-booking-confirm-datetime">

            <div class="ib-booking-confirm-datetime-item">

                <span class="ib-booking-confirm-label">
                    DATA
                </span>

                <strong id="resumoData">
                    —
                </strong>

            </div>


            <div class="ib-booking-confirm-datetime-item">

                <span class="ib-booking-confirm-label">
                    HORA
                </span>

                <strong id="resumoHora">
                    —
                </strong>

            </div>

        </div>


        <div class="ib-booking-confirm-observation"
             id="resumoObservacoesBloco"
             hidden>

            <div class="ib-booking-confirm-divider"></div>

            <span class="ib-booking-confirm-label">
                OBSERVAÇÕES
            </span>

            <p id="resumoObservacoes"></p>

        </div>

    </div>

</div>


<!-- ==========================================
     PROMO + TOTAL
=========================================== -->

<div class="ib-booking-confirm-bottom">

    <div class="ib-booking-confirm-promo">

        <span class="ib-booking-confirm-label">
            CÓDIGO PROMOCIONAL
        </span>

        <div class="ib-booking-promo">

            <input asp-for="PromoCode"
                   class="ib-booking-promo-input"
                   placeholder="Introduza o seu código"
                   autocomplete="off" />

            <button type="button"
                    class="ib-booking-promo-button"
                    id="btnAplicarPromo">
                Aplicar
            </button>

        </div>

        <span asp-validation-for="PromoCode"
              class="text-danger">
        </span>

    </div>


    <div class="ib-booking-confirm-total">

    <div class="ib-booking-confirm-price-details"
         id="resumoDescontoBloco"
         hidden>

        <div class="ib-booking-confirm-price-line">
            <span>Valor do serviço</span>
            <span id="resumoValorOriginal">—</span>
        </div>

        <div class="ib-booking-confirm-price-line ib-booking-confirm-discount">
            <span id="resumoDescontoLabel">Desconto</span>
            <span id="resumoValorDesconto">—</span>
        </div>

    </div>

    <div class="ib-booking-confirm-total-final">

        <span>
            TOTAL A PAGAR
        </span>

        <strong id="resumoTotal">
            —
        </strong>

    </div>

</div>

</div>


<!-- ==========================================
     AÇÕES
=========================================== -->

<div class="ib-booking-actions ib-booking-confirm-actions">

    <button type="button"
            class="ib-booking-btn-secondary"
            id="btnVoltarDetalhes">

        <span aria-hidden="true">←</span>
        Voltar

    </button>


    <button type="submit"
            class="ib-booking-btn-primary"
            id="btnConfirmarMarcacao">

        Confirmar marcação
        <span aria-hidden="true">✓</span>

    </button>

</div>

</section>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const categoriaCards =
                document.querySelectorAll(".ib-booking-category-card");

            const servicoCards =
                document.querySelectorAll(".ib-booking-service-card");

            const servicoInput =
                document.getElementById("ServicoId");

            const continuarButton =
                document.getElementById("btnContinuarServico");

            const servicosAjuda =
                document.getElementById("servicosAjuda");
                const etapa1 =
    document.getElementById("wizardEtapa1");

const etapa2 =
    document.getElementById("wizardEtapa2");

const voltarServicoButton =
    document.getElementById("btnVoltarServico");

const roadmapSteps =
    document.querySelectorAll(".ib-booking-step");
    const profissionaisContainer =
    document.getElementById("profissionaisContainer");

const funcionarioInput =
    document.getElementById("FuncionarioId");

const continuarProfissionalButton =
    document.getElementById("btnContinuarProfissional");
    const etapa3 =
    document.getElementById("wizardEtapa3");

const voltarProfissionalButton =
    document.getElementById("btnVoltarProfissional");

const continuarDataHoraButton =
    document.getElementById("btnContinuarDataHora");
    const datasDisponiveisContainer =
    document.getElementById("datasDisponiveisContainer");

const horariosSection =
    document.getElementById("horariosSection");

const horariosDisponiveisContainer =
    document.getElementById("horariosDisponiveisContainer");

const dataHoraInput =
    document.getElementById("DataHoraInicio");
const etapa4 =
    document.getElementById("wizardEtapa4");

const voltarDataHoraButton =
    document.getElementById("btnVoltarDataHora");

const continuarDetalhesButton =
    document.getElementById("btnContinuarDetalhes");
const etapa5 =
    document.getElementById("wizardEtapa5");

const voltarDetalhesButton =
    document.getElementById("btnVoltarDetalhes");

const resumoServico =
    document.getElementById("resumoServico");

const resumoProfissional =
    document.getElementById("resumoProfissional");

const resumoData =
    document.getElementById("resumoData");

const resumoHora =
    document.getElementById("resumoHora");

const btnAplicarPromo =
    document.getElementById("btnAplicarPromo");

const promoCodeInput =
    document.getElementById("PromoCode");

const resumoTotal =
    document.getElementById("resumoTotal");

const resumoPrecoServico =
    document.getElementById("resumoPrecoServico");

let precoEfetivoSelecionado = null;
let duracaoEfetivaSelecionada = null;

            categoriaCards.forEach(card => {

                card.addEventListener("click", function () {

                    const categoriaId =
                        this.dataset.categoriaId;


                    categoriaCards.forEach(item =>
                        item.classList.remove("selected"));


                    this.classList.add("selected");


                    servicoInput.value = "";

                    continuarButton.disabled = true;


                    let quantidadeServicos = 0;


                    servicoCards.forEach(servico => {

                        servico.classList.remove("selected");


                        if (servico.dataset.categoriaId === categoriaId) {

                            servico.hidden = false;

                            quantidadeServicos++;

                        }
                        else {

                            servico.hidden = true;

                        }

                    });


                    if (quantidadeServicos > 0) {

                        servicosAjuda.textContent =
                            "Selecione o serviço pretendido.";

                    }
                    else {

                        servicosAjuda.textContent =
                            "Não existem serviços disponíveis nesta categoria.";

                    }

                });

            });


            servicoCards.forEach(card => {

                card.addEventListener("click", function () {

                    servicoCards.forEach(item =>
                        item.classList.remove("selected"));


                    this.classList.add("selected");


                    servicoInput.value =
                        this.dataset.servicoId;


                    continuarButton.disabled = false;

                });

            });
            continuarButton.addEventListener("click", async function () {

    if (!servicoInput.value) {
        return;
    }

    etapa1.classList.remove("active");
    etapa2.classList.add("active");

    roadmapSteps[0].classList.remove("active");
    roadmapSteps[0].classList.add("completed");

    roadmapSteps[1].classList.add("active");

    profissionaisContainer.innerHTML =
        "<p>A carregar profissionais...</p>";

    funcionarioInput.value = "";
    continuarProfissionalButton.disabled = true;

    try {

        const response = await fetch(
            `/MarcacoesCliente/FuncionariosPorServico?servicoId=${servicoInput.value}`
        );

        if (!response.ok) {
            throw new Error("Erro ao carregar profissionais.");
        }

        const profissionais = await response.json();

        if (!profissionais || profissionais.length === 0) {

            profissionaisContainer.innerHTML =
                "<p>Não existem profissionais disponíveis para este serviço.</p>";

            return;
        }

        profissionaisContainer.innerHTML = "";

        profissionais.forEach(profissional => {

            const card = document.createElement("button");

            card.type = "button";
            card.className = "ib-booking-professional-card";
            card.dataset.funcionarioId = profissional.id;

            const avaliacao =
                profissional.totalAvaliacoes > 0
                    ? `★ ${Number(profissional.mediaAvaliacao).toFixed(1)} (${profissional.totalAvaliacoes})`
                    : "Sem avaliações";

            const biografia =
                profissional.biografia
                    ? `<p>${profissional.biografia}</p>`
                    : "";

            card.innerHTML = `
                <div class="ib-booking-professional-image">
                    <img src="${profissional.fotografiaUrl}"
                         alt=""
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                    <div class="ib-booking-image-fallback">
                        <span>${profissional.nomeCompleto.charAt(0).toUpperCase()}</span>
                    </div>
                </div>

                <div class="ib-booking-professional-content">
                    <strong>${profissional.nomeCompleto}</strong>

                    ${biografia}

                    <span class="ib-booking-professional-rating">
                        ${avaliacao}
                    </span>
                </div>

                <span class="ib-booking-card-check"
                      aria-hidden="true">
                    ✓
                </span>
            `;

            card.addEventListener("click", async function () {

                document
                    .querySelectorAll(".ib-booking-professional-card")
                    .forEach(item =>
                        item.classList.remove("selected"));

                this.classList.add("selected");

                funcionarioInput.value =
                    this.dataset.funcionarioId;

                continuarProfissionalButton.disabled = false;

            });

            profissionaisContainer.appendChild(card);

        });

    }
    catch (error) {

        profissionaisContainer.innerHTML =
            "<p>Não foi possível carregar os profissionais.</p>";

    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

});



voltarServicoButton.addEventListener("click", function () {

    etapa2.classList.remove("active");
    etapa1.classList.add("active");

    roadmapSteps[1].classList.remove("active");

    roadmapSteps[0].classList.remove("completed");
    roadmapSteps[0].classList.add("active");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

});
continuarProfissionalButton.addEventListener("click", async function () {

    if (!funcionarioInput.value) {
        return;
    }

    etapa2.classList.remove("active");
    etapa3.classList.add("active");

    roadmapSteps[1].classList.remove("active");
    roadmapSteps[1].classList.add("completed");

    roadmapSteps[2].classList.add("active");
await carregarDatasDisponiveis();

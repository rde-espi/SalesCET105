btnAplicarPromo?.addEventListener("click", async function () {

    const codigo = promoCodeInput?.value?.trim();

    if (!codigo) {
        alert("Introduza um código promocional.");
        promoCodeInput?.focus();
        return;
    }

    const token =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        )?.value;

    btnAplicarPromo.disabled = true;
    btnAplicarPromo.textContent = "A validar...";

    try {

        const body = new URLSearchParams();
        body.append("codigo", codigo);

        const response = await fetch(
            "/MarcacoesCliente/ValidarPromoCode",
            {
                method: "POST",
                headers: {
                    "Content-Type":
                        "application/x-www-form-urlencoded; charset=UTF-8",

                    "RequestVerificationToken":
                        token ?? ""
                },
                body: body.toString()
            }
        );

        if (!response.ok) {

            let mensagem =
                "O código promocional não é válido.";

            const erro = await response.text();

            if (erro) {
                try {
                    mensagem = JSON.parse(erro);
                }
                catch {
                    mensagem = erro;
                }
            }

            alert(mensagem);
            return;
        }

        const resultado = await response.json();

        console.log("PromoCode validado:", resultado);

const percentagemDesconto =
    Number(resultado.percentagemDesconto);

const precoTexto =
    resumoPrecoServico
        ?.textContent
        ?.trim() || "";

const precoBase =
    Number(
        precoTexto
            .replace("€", "")
            .replace(/\s/g, "")
            .replace(",", ".")
    );

if (
    !Number.isFinite(precoBase) ||
    !Number.isFinite(percentagemDesconto)
) {
    throw new Error(
        "Não foi possível calcular o valor do desconto."
    );
}

const valorDesconto =
    precoBase * percentagemDesconto / 100;

const totalComDesconto =
    precoBase - valorDesconto;

const formatarEuro = valor =>
    valor.toLocaleString(
        "pt-PT",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    ) + " €";


const descontoBloco =
    document.getElementById("resumoDescontoBloco");

const valorOriginal =
    document.getElementById("resumoValorOriginal");

const descontoLabel =
    document.getElementById("resumoDescontoLabel");

const valorDescontoElement =
    document.getElementById("resumoValorDesconto");


valorOriginal.textContent =
    formatarEuro(precoBase);

descontoLabel.textContent =
    `Desconto ${percentagemDesconto}%`;

valorDescontoElement.textContent =
    `− ${formatarEuro(valorDesconto)}`;

resumoTotal.textContent =
    formatarEuro(totalComDesconto);

descontoBloco.hidden = false;

    }
    catch (error) {

        console.error(error);

        alert(
            "Não foi possível validar o código promocional."
        );
    }
    finally {

        btnAplicarPromo.disabled = false;
        btnAplicarPromo.textContent = "Aplicar";
    }
});


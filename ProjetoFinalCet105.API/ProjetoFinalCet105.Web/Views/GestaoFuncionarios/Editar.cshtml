@model ProjetoFinalCet105.Web.Models.FuncionarioFormViewModel

@{
    ViewData["Title"] = "Editar Funcionário";
    Layout = "_AdminLayout";
}

<div class="ib-category-form-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">EQUIPA</span>
            <h1>Editar Funcionário</h1>
            <p>Atualize os dados profissionais e a configuração do funcionário.</p>
        </div>

        <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar à equipa
        </a>
    </section>

    <form asp-controller="GestaoFuncionarios" asp-action="Editar" asp-route-id ="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="ib-category-form-validation"></div>

        <div class="ib-category-form-grid">

            <!-- DADOS -->
            <section class="ib-category-form-card">

                <header class="ib-category-form-card-header">
                    <div class="ib-category-form-card-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                        </svg>
                    </div>

                    <div>
                        <span class="ib-section-eyebrow">INFORMAÇÃO</span>
                        <h2>Dados do funcionário</h2>
                        <p>Dados de identificação, contacto e informação profissional.</p>
                    </div>
                </header>

                <div class="ib-category-field">
                    <label asp-for="NomeCompleto">
                        Nome completo <span>*</span>
                    </label>

                    <input asp-for="NomeCompleto" autocomplete="name" />
                    <span asp-validation-for="NomeCompleto" class="ib-field-validation"></span>
                </div>

                <div class="ib-category-field">
                    <label asp-for="Email">
                        Email <span>*</span>
                    </label>

                    <input asp-for="Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="ib-field-validation"></span>
                </div>

                <div class="ib-service-form-row">

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="Telefone">Telefone</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="Telefone" type="tel" autocomplete="tel" />
                        <span asp-validation-for="Telefone" class="ib-field-validation"></span>
                    </div>

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="DataAdmissao">Data de admissão</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="DataAdmissao" type="date" />
                        <span asp-validation-for="DataAdmissao" class="ib-field-validation"></span>
                    </div>

                </div>

                <div class="ib-category-field">
                    <div class="ib-category-field-label">
                        <label asp-for="Biografia">Biografia</label>
                        <span>Opcional</span>
                    </div>

                    <textarea asp-for="Biografia" rows="5"></textarea>
                    <span asp-validation-for="Biografia" class="ib-field-validation"></span>

                    <small>
                        O funcionário poderá posteriormente atualizar a sua apresentação através do perfil.
                    </small>
                </div>

            </section>

            <!-- CONFIGURAÇÃO -->
            <section class="ib-category-image-card ib-employee-create-side">

                <header>
                    <span class="ib-section-eyebrow">CONFIGURAÇÃO</span>
                    <h2>Estado do funcionário</h2>
                    <p>Controle a disponibilidade profissional e o acesso ao sistema.</p>
                </header>

                <div class="ib-employee-create-status">

                    <!-- DISPONIBILIDADE -->
                    <label class="ib-employee-option" for="Disponivel">
                        <div class="ib-employee-option-icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M8 12l2.5 2.5L16 9"></path>
                            </svg>
                        </div>

                        <div class="ib-employee-option-content">
                            <strong>Disponível para marcações</strong>
                            <span>Permite apresentar o profissional como disponível na agenda.</span>
                        </div>

                        <div class="ib-employee-switch">
                            <input asp-for="Disponivel" type="checkbox" />
                            <span></span>
                        </div>
                    </label>

                    <!-- ATIVO -->
                    <label class="ib-employee-option ib-employee-option-spaced" for="Ativo">
                        <div class="ib-employee-option-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 3v9"></path>
                                <path d="M6.6 5.6a8 8 0 1 0 10.8 0"></path>
                            </svg>
                        </div>

                        <div class="ib-employee-option-content">
                            <strong>Funcionário ativo</strong>
                            <span>Ao desativar, o funcionário deixa de estar ativo no sistema.</span>
                        </div>

                        <div class="ib-employee-switch">
                            <input asp-for="Ativo" type="checkbox" />
                            <span></span>
                        </div>
                    </label>

                </div>

                <div class="ib-employee-edit-info">
                    <div class="ib-employee-edit-info-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                    </div>

                    <div>
                        <strong>Dados pessoais e acesso</strong>
                        <p>
                            A fotografia e a palavra-passe são geridas pelo próprio funcionário
                            através da sua área pessoal.
                        </p>
                    </div>
                </div>

            </section>

        </div>
        @if (Model.Servicos != null && Model.Servicos.Any())
        {
            <div class="ib-category-form-card ib-employee-services-card">
                <div class="ib-category-form-card-header">
                    <div>
                        <h3>Serviços realizados</h3>
                        <p>Selecione os serviços que este profissional está habilitado a realizar.</p>
                    </div>
                </div>
                <div class="ib-employee-services-search">
                    <span class="ib-employee-services-search-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                    </span>

                    <input type="text"
                           id="pesquisaServicosFuncionario"
                           placeholder="Pesquisar serviço ou categoria..." />
                </div>
                <div class="ib-employee-services-list">
                    @for (var i = 0; i < Model.Servicos.Count; i++)
                    {
                        <div class="ib-employee-service-item"
                             data-servico="@Model.Servicos[i].Nome.ToLowerInvariant()"
                             data-categoria="@(Model.Servicos[i].CategoriaNome?.ToLowerInvariant() ?? string.Empty)">
                            <input type="hidden" asp-for="Servicos[i].ServicoId" />
                            <input type="hidden" asp-for="Servicos[i].Nome" />
                            <input type="hidden" asp-for="Servicos[i].CategoriaNome" />
                            <input type="hidden" asp-for="Servicos[i].FuncionarioServicoId" />


                            <div class="ib-employee-service-info">
                                <strong>@Model.Servicos[i].Nome</strong>

                                @if (!string.IsNullOrWhiteSpace(Model.Servicos[i].CategoriaNome))
                                {
                                    <span>@Model.Servicos[i].CategoriaNome</span>
                                }
                            </div>

                            <label class="ib-employee-service-switch">
                                <input asp-for="Servicos[i].Selecionado" />
                                <span class="ib-employee-service-switch-slider"></span>
                            </label>
                        </div>
                    }
                </div>
                <div id="semResultadosServicos"
                     class="ib-employee-services-empty"
                     style="display:none;">
                    Nenhum serviço encontrado.
                </div>
            </div>
        }
        else
        {
            <div class="ib-category-form-card">
                <div class="ib-category-form-card-header">
                    <div>
                        <h3>Serviços realizados</h3>
                        <p>Não existem serviços disponíveis para associação.</p>
                    </div>
                </div>
            </div>
        }

        <div class="ib-category-form-card ib-employee-competencies-card">
            <div class="ib-category-form-card-header">
                <div>
                    <h3>Competências profissionais</h3>
                    <p>Associe qualificações, níveis e certificações a este profissional.</p>
                </div>
            </div>

            <div class="ib-employee-competencies-toolbar">
                <div class="ib-employee-services-search">
                    <span class="ib-employee-services-search-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                    </span>

                    <input type="text"
                           id="pesquisaCompetenciasFuncionario"
                           placeholder="Pesquisar competência..." />
                </div>

                <button type="button"
                        class="ib-category-save-btn"
                        id="btnAdicionarCompetencia">
                    + Adicionar competência
                </button>
            </div>

            <div id="formAdicionarCompetencia"
                 class="ib-employee-competency-form"
                 style="display:none;">

                <div class="ib-category-field">
                    <label>Competência</label>

                    <select id="novaCompetenciaId">
                        <option value="">Selecione uma competência</option>

                        @foreach (var competencia in Model.CompetenciasDisponiveis)
                        {
                            <option value="@competencia.Id">@competencia.Nome</option>
                        }
                    </select>
                </div>

                <div class="ib-category-field">
                    <label>Nível</label>
                    <input type="text"
                           id="novoNivelCompetencia"
                           placeholder="Ex.: Básico, Intermédio, Avançado" />
                </div>

                <div class="ib-category-field">
                    <label>Certificação</label>
                    <input type="text"
                           id="novaCertificacaoCompetencia"
                           placeholder="Opcional" />
                </div>

                <div class="ib-employee-competency-form-actions">
                    <button type="button"
                            class="ib-category-cancel-btn"
                            id="btnCancelarCompetencia">
                        Cancelar
                    </button>

                    <button type="button"
                            class="ib-category-save-btn"
                            id="btnGuardarCompetencia">
                        Adicionar
                    </button>
                </div>
            </div>

            <div class="ib-employee-competencies-list">
                @if (Model.CompetenciasFuncionario.Any())
                {
                    @foreach (var competencia in Model.CompetenciasFuncionario)
                    {
                        <div class="ib-employee-competency-item"
                             data-nome="@competencia.CompetenciaNome.ToLowerInvariant()">

                            <div class="ib-employee-competency-info">
                                <strong>@competencia.CompetenciaNome</strong>

                                @if (!string.IsNullOrWhiteSpace(competencia.Nivel))
                                {
                                    <span>Nível: @competencia.Nivel</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(competencia.Certificacao))
                                {
                                    <span>Certificação: @competencia.Certificacao</span>
                                }
                            </div>

                            <button type="button"
                                class="ib-employee-competency-remove"
                                data-id="@competencia.Id"
                                title="Remover competência"
                                aria-label="Remover competência">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 7h16"></path>
                                    <path d="M9 7V4h6v3"></path>
                                    <path d="M6 7l1 13h10l1-13"></path>
                                    <path d="M10 11v5"></path>
                                    <path d="M14 11v5"></path>
                                </svg>
                                </button>
                        </div>
                    }
                }
                else
                {
                    <div class="ib-employee-services-empty">
                        Este funcionário ainda não possui competências associadas.
                    </div>
                }
            </div>
        </div>

        <footer class="ib-category-form-footer">

            <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit" class="ib-category-save-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M5 12l4 4L19 6"></path>
                </svg>
                Guardar alterações
            </button>

        </footer>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // PESQUISA DE SERVIÇOS
        // =====================================================

        const pesquisaServicos =
            document.getElementById("pesquisaServicosFuncionario");

        if (pesquisaServicos) {
            const itens =
                document.querySelectorAll(".ib-employee-service-item");

            pesquisaServicos.addEventListener("input", function () {
                const termo = this.value.trim().toLowerCase();
                let encontrados = 0;

                itens.forEach(function (item) {
                    const servico = item.dataset.servico || "";
                    const categoria = item.dataset.categoria || "";

                    const corresponde =
                        servico.includes(termo) ||
                        categoria.includes(termo);

                    item.style.display =
                        corresponde ? "flex" : "none";

                    if (corresponde) {
                        encontrados++;
                    }
                });

                const semResultados =
                    document.getElementById("semResultadosServicos");

                if (semResultados) {
                    semResultados.style.display =
                        encontrados === 0 ? "block" : "none";
                }
            });
        }


        // =====================================================
        // ABRIR / FECHAR FORMULÁRIO DE COMPETÊNCIA
        // =====================================================

        const btnAdicionarCompetencia =
            document.getElementById("btnAdicionarCompetencia");

        const btnCancelarCompetencia =
            document.getElementById("btnCancelarCompetencia");

        const formAdicionarCompetencia =
            document.getElementById("formAdicionarCompetencia");

        if (btnAdicionarCompetencia && formAdicionarCompetencia) {
            btnAdicionarCompetencia.addEventListener("click", function () {
                formAdicionarCompetencia.style.display = "grid";
            });
        }

        if (btnCancelarCompetencia && formAdicionarCompetencia) {
            btnCancelarCompetencia.addEventListener("click", function () {
                formAdicionarCompetencia.style.display = "none";
            });
        }


        // =====================================================
        // PESQUISA DE COMPETÊNCIAS
        // =====================================================

        const pesquisaCompetencias =
            document.getElementById("pesquisaCompetenciasFuncionario");

        if (pesquisaCompetencias) {
            const competencias =
                document.querySelectorAll(".ib-employee-competency-item");

            pesquisaCompetencias.addEventListener("input", function () {
                const termo = this.value.trim().toLowerCase();

                competencias.forEach(function (item) {
                    const nome = item.dataset.nome || "";

                    item.style.display =
                        nome.includes(termo) ? "flex" : "none";
                });
            });
        }


        // =====================================================
        // ADICIONAR COMPETÊNCIA
        // =====================================================

        const btnGuardarCompetencia =
            document.getElementById("btnGuardarCompetencia");

        if (btnGuardarCompetencia) {
            btnGuardarCompetencia.addEventListener(
                "click",
                async function () {

                    const competenciaId =
                        document.getElementById("novaCompetenciaId").value;

                    const nivel =
                        document.getElementById("novoNivelCompetencia")
                            .value
                            .trim();

                    const certificacao =
                        document.getElementById("novaCertificacaoCompetencia")
                            .value
                            .trim();

                    if (!competenciaId) {
                        alert("Selecione uma competência.");
                        return;
                    }

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    btnGuardarCompetencia.disabled = true;

                    try {
                        const response = await fetch(
                            '@Url.Action("AdicionarCompetencia", "GestaoFuncionarios")',
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify({
                                    funcionarioId: @Model.Id,
                                    competenciaId:
                                        parseInt(competenciaId),
                                    nivel: nivel || null,
                                    certificacao:
                                        certificacao || null
                                })
                            });

                        if (!response.ok) {
                            const erro = await response.json();

                            alert(
                                erro.mensagem ||
                                "Não foi possível adicionar a competência."
                            );

                            return;
                        }

                        location.reload();
                    }
                    catch {
                        alert(
                            "Ocorreu um erro ao adicionar a competência."
                        );
                    }
                    finally {
                        btnGuardarCompetencia.disabled = false;
                    }
                }
            );
        }


        // =====================================================
        // REMOVER COMPETÊNCIA
        // =====================================================

        const botoesRemoverCompetencia =
            document.querySelectorAll(
                ".ib-employee-competency-remove"
            );

        botoesRemoverCompetencia.forEach(function (botao) {

            botao.addEventListener(
                "click",
                async function () {

                    const id = this.dataset.id;

                    if (!id) {
                        return;
                    }

                    const confirmar = confirm(
                        "Pretende remover esta competência do funcionário?"
                    );

                    if (!confirmar) {
                        return;
                    }

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    this.disabled = true;

                    try {
                        const response = await fetch(
                            '@Url.Action("RemoverCompetencia", "GestaoFuncionarios")'
                            + "?id="
                            + encodeURIComponent(id),
                            {
                                method: "POST",

                                headers: {
                                    "RequestVerificationToken": token
                                }
                            });

                        if (!response.ok) {
                            const erro = await response.json();

                            alert(
                                erro.mensagem ||
                                "Não foi possível remover a competência."
                            );

                            return;
                        }

                        location.reload();
                    }
                    catch {
                        alert(
                            "Ocorreu um erro ao remover a competência."
                        );
                    }
                    finally {
                        this.disabled = false;
                    }
                }
            );
        });

    });
</script>

}
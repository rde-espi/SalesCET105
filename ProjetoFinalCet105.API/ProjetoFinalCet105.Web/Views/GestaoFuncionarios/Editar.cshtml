@model ProjetoFinalCet105.Web.Models.FuncionarioFormViewModel

@{
    ViewData["Title"] = "Editar Funcionário";
    Layout = "_AdminLayout";
}

<div class="ib-category-form-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">EQUIPA</span>
            <h1>Editar Funcionário</h1>
            <p>Atualize os dados profissionais e a configuração do funcionário.</p>
        </div>

        <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar à equipa
        </a>
    </section>

    <form asp-controller="GestaoFuncionarios" asp-action="Editar" asp-route-id ="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="ib-category-form-validation"></div>

        <div class="ib-category-form-grid">

            <!-- DADOS -->
            <section class="ib-category-form-card">

                <header class="ib-category-form-card-header">
                    <div class="ib-category-form-card-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                        </svg>
                    </div>

                    <div>
                        <span class="ib-section-eyebrow">INFORMAÇÃO</span>
                        <h2>Dados do funcionário</h2>
                        <p>Dados de identificação, contacto e informação profissional.</p>
                    </div>
                </header>

                <div class="ib-category-field">
                    <label asp-for="NomeCompleto">
                        Nome completo <span>*</span>
                    </label>

                    <input asp-for="NomeCompleto" autocomplete="name" />
                    <span asp-validation-for="NomeCompleto" class="ib-field-validation"></span>
                </div>

                <div class="ib-category-field">
                    <label asp-for="Email">
                        Email <span>*</span>
                    </label>

                    <input asp-for="Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="ib-field-validation"></span>
                </div>

                <div class="ib-service-form-row">

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="Telefone">Telefone</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="Telefone" type="tel" autocomplete="tel" />
                        <span asp-validation-for="Telefone" class="ib-field-validation"></span>
                    </div>

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="DataAdmissao">Data de admissão</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="DataAdmissao" type="date" />
                        <span asp-validation-for="DataAdmissao" class="ib-field-validation"></span>
                    </div>

                </div>

                <div class="ib-category-field">
                    <div class="ib-category-field-label">
                        <label asp-for="Biografia">Biografia</label>
                        <span>Opcional</span>
                    </div>

                    <textarea asp-for="Biografia" rows="5"></textarea>
                    <span asp-validation-for="Biografia" class="ib-field-validation"></span>

                    <small>
                        O funcionário poderá posteriormente atualizar a sua apresentação através do perfil.
                    </small>
                </div>

            </section>

            <!-- CONFIGURAÇÃO -->
            <section class="ib-category-image-card ib-employee-create-side">

                <header>
                    <span class="ib-section-eyebrow">CONFIGURAÇÃO</span>
                    <h2>Estado do funcionário</h2>
                    <p>Controle a disponibilidade profissional e o acesso ao sistema.</p>
                </header>

                <div class="ib-employee-create-status">

                    <!-- DISPONIBILIDADE -->
                    <label class="ib-employee-option" for="Disponivel">
                        <div class="ib-employee-option-icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M8 12l2.5 2.5L16 9"></path>
                            </svg>
                        </div>

                        <div class="ib-employee-option-content">
                            <strong>Disponível para marcações</strong>
                            <span>Permite apresentar o profissional como disponível na agenda.</span>
                        </div>

                        <div class="ib-employee-switch">
                            <input asp-for="Disponivel" type="checkbox" />
                            <span></span>
                        </div>
                    </label>

                    <!-- ATIVO -->
                    <label class="ib-employee-option ib-employee-option-spaced" for="Ativo">
                        <div class="ib-employee-option-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 3v9"></path>
                                <path d="M6.6 5.6a8 8 0 1 0 10.8 0"></path>
                            </svg>
                        </div>

                        <div class="ib-employee-option-content">
                            <strong>Funcionário ativo</strong>
                            <span>Ao desativar, o funcionário deixa de estar ativo no sistema.</span>
                        </div>

                        <div class="ib-employee-switch">
                            <input asp-for="Ativo" type="checkbox" />
                            <span></span>
                        </div>
                    </label>

                </div>

                <div class="ib-employee-edit-info">
                    <div class="ib-employee-edit-info-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 11v5"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                    </div>

                    <div>
                        <strong>Dados pessoais e acesso</strong>
                        <p>
                            A fotografia e a palavra-passe são geridas pelo próprio funcionário
                            através da sua área pessoal.
                        </p>
                    </div>
                </div>

            </section>

        </div>
        @if (Model.Servicos != null && Model.Servicos.Any())
        {
            <div class="ib-category-form-card ib-employee-services-card">
                <div class="ib-category-form-card-header">
                    <div>
                        <h3>Serviços realizados</h3>
                        <p>Selecione os serviços que este profissional está habilitado a realizar.</p>
                    </div>
                </div>
                <div class="ib-employee-services-search">
                    <span class="ib-employee-services-search-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                    </span>

                    <input type="text"
                           id="pesquisaServicosFuncionario"
                           placeholder="Pesquisar serviço ou categoria..." />
                </div>
                <div class="ib-employee-services-list">
                    @for (var i = 0; i < Model.Servicos.Count; i++)
                    {
                        <div class="ib-employee-service-item"
                             data-servico="@Model.Servicos[i].Nome.ToLowerInvariant()"
                             data-categoria="@(Model.Servicos[i].CategoriaNome?.ToLowerInvariant() ?? string.Empty)">
                            <input type="hidden" asp-for="Servicos[i].ServicoId" />
                            <input type="hidden" asp-for="Servicos[i].Nome" />
                            <input type="hidden" asp-for="Servicos[i].CategoriaNome" />
                            <input type="hidden" asp-for="Servicos[i].FuncionarioServicoId" />


                            <div class="ib-employee-service-info">
                                <strong>@Model.Servicos[i].Nome</strong>

                                @if (!string.IsNullOrWhiteSpace(Model.Servicos[i].CategoriaNome))
                                {
                                    <span>@Model.Servicos[i].CategoriaNome</span>
                                }
                            </div>

                            <label class="ib-employee-service-switch">
                                <input asp-for="Servicos[i].Selecionado" />
                                <span class="ib-employee-service-switch-slider"></span>
                            </label>
                        </div>
                    }
                </div>
                <div id="semResultadosServicos"
                     class="ib-employee-services-empty"
                     style="display:none;">
                    Nenhum serviço encontrado.
                </div>
            </div>
        }
        else
        {
            <div class="ib-category-form-card">
                <div class="ib-category-form-card-header">
                    <div>
                        <h3>Serviços realizados</h3>
                        <p>Não existem serviços disponíveis para associação.</p>
                    </div>
                </div>
            </div>
        }

        <div class="ib-category-form-card ib-employee-competencies-card">
            <div class="ib-category-form-card-header">
                <div>
                    <h3>Competências profissionais</h3>
                    <p>Associe qualificações, níveis e certificações a este profissional.</p>
                </div>
            </div>

            <div class="ib-employee-competencies-toolbar">
                <div class="ib-employee-services-search">
                    <span class="ib-employee-services-search-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20l-3.5-3.5"></path>
                        </svg>
                    </span>

                    <input type="text"
                           id="pesquisaCompetenciasFuncionario"
                           placeholder="Pesquisar competência..." />
                </div>

                <button type="button"
                        class="ib-category-save-btn"
                        id="btnAdicionarCompetencia">
                    + Adicionar competência
                </button>
            </div>

            <div id="formAdicionarCompetencia"
                 class="ib-employee-competency-form"
                 style="display:none;">

                <div class="ib-category-field">
                    <label>Competência</label>

                    <select id="novaCompetenciaId">
                        <option value="">Selecione uma competência</option>

                        @foreach (var competencia in Model.CompetenciasDisponiveis)
                        {
                            <option value="@competencia.Id">@competencia.Nome</option>
                        }
                    </select>
                </div>

                <div class="ib-category-field">
                    <label>Nível</label>
                    <input type="text"
                           id="novoNivelCompetencia"
                           placeholder="Ex.: Básico, Intermédio, Avançado" />
                </div>

                <div class="ib-category-field">
                    <label>Certificação</label>
                    <input type="text"
                           id="novaCertificacaoCompetencia"
                           placeholder="Opcional" />
                </div>

                <div class="ib-employee-competency-form-actions">
                    <button type="button"
                            class="ib-category-cancel-btn"
                            id="btnCancelarCompetencia">
                        Cancelar
                    </button>

                    <button type="button"
                            class="ib-category-save-btn"
                            id="btnGuardarCompetencia">
                        Adicionar
                    </button>
                </div>
            </div>

            <div class="ib-employee-competencies-list">
                @if (Model.CompetenciasFuncionario.Any())
                {
                    @foreach (var competencia in Model.CompetenciasFuncionario)
                    {
                        <div class="ib-employee-competency-item"
                             data-nome="@competencia.CompetenciaNome.ToLowerInvariant()">

                            <div class="ib-employee-competency-info">
                                <strong>@competencia.CompetenciaNome</strong>

                                @if (!string.IsNullOrWhiteSpace(competencia.Nivel))
                                {
                                    <span>Nível: @competencia.Nivel</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(competencia.Certificacao))
                                {
                                    <span>Certificação: @competencia.Certificacao</span>
                                }
                            </div>

                            <button type="button"
                                class="ib-employee-competency-remove"
                                data-id="@competencia.Id"
                                title="Remover competência"
                                aria-label="Remover competência">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 7h16"></path>
                                    <path d="M9 7V4h6v3"></path>
                                    <path d="M6 7l1 13h10l1-13"></path>
                                    <path d="M10 11v5"></path>
                                    <path d="M14 11v5"></path>
                                </svg>
                                </button>
                        </div>
                    }
                }
                else
                {
                    <div class="ib-employee-services-empty">
                        Este funcionário ainda não possui competências associadas.
                    </div>
                }
            </div>
        </div>

        <div class="ib-category-form-card">

    <div class="ib-category-form-card-header">
        <div>
            <span class="ib-section-eyebrow">AGENDA</span>
            <h3>Horário de trabalho</h3>
            <p>Consulte e configure o horário semanal deste profissional.</p>
        </div>
    </div>

  <div class="ib-employee-schedule-create"
     id="horarioCreateArea"
     data-funcionario-id="@Model.Id">

    <div class="ib-employee-schedule-grid">

        <div class="ib-category-field">
            <label for="horarioDiaSemana">Dia da semana</label>

            <select id="horarioDiaSemana">
                <option value="">Selecionar dia</option>
                <option value="1">Segunda-feira</option>
                <option value="2">Terça-feira</option>
                <option value="3">Quarta-feira</option>
                <option value="4">Quinta-feira</option>
                <option value="5">Sexta-feira</option>
                <option value="6">Sábado</option>
                <option value="0">Domingo</option>
            </select>
        </div>

        <div class="ib-category-field">
            <label for="horarioHoraInicio">Hora de início</label>

            <input id="horarioHoraInicio"
                   type="time" />
        </div>

        <div class="ib-category-field">
            <label for="horarioHoraFim">Hora de fim</label>

            <input id="horarioHoraFim"
                   type="time" />
        </div>

        <div class="ib-employee-schedule-action">
            <button type="button"
                    id="btnAdicionarHorario"
                    class="ib-category-save-btn">
                + Adicionar horário
            </button>
        </div>

    </div>

    <div id="horarioMensagem"
         class="mt-3"
         style="display:none;">
    </div>
</div>

@if (TempData["HorarioSucesso"] != null)
{
    <div class="alert alert-success">
        @TempData["HorarioSucesso"]
    </div>
}

@if (TempData["HorarioErro"] != null)
{
    <div class="alert alert-danger">
        @TempData["HorarioErro"]
    </div>
}

    <div id="horariosLista"
     class="ib-employee-schedule-list">

    @if (Model.Horarios != null && Model.Horarios.Any())
    {
        @foreach (var horario in Model.Horarios)
        {
            <div class="ib-employee-schedule-item"
     data-horario-id="@horario.Id"
     data-dia-semana="@((int)horario.DiaSemana)"
     data-hora-inicio="@horario.HoraInicio.ToString(@"hh\:mm")"
                             data-hora-fim="@horario.HoraFim.ToString(@"hh\:mm")">

                <div class="ib-employee-schedule-day">
                    <strong>
                        @(horario.DiaSemana switch
                        {
                            DayOfWeek.Monday => "Segunda-feira",
                            DayOfWeek.Tuesday => "Terça-feira",
                            DayOfWeek.Wednesday => "Quarta-feira",
                            DayOfWeek.Thursday => "Quinta-feira",
                            DayOfWeek.Friday => "Sexta-feira",
                            DayOfWeek.Saturday => "Sábado",
                            DayOfWeek.Sunday => "Domingo",
                            _ => horario.DiaSemana.ToString()
                        })
                    </strong>

                    <span>
                        @horario.HoraInicio.ToString(@"hh\:mm")
                        –
                        @horario.HoraFim.ToString(@"hh\:mm")
                    </span>
                </div>

                            <div class="ib-employee-schedule-actions">

                                <button type="button"
                                        class="ib-employee-schedule-edit"
                                        data-horario-id="@horario.Id"
                                        title="Editar horário"
                                        aria-label="Editar horário">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 20h9"></path>
                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                                    </svg>
                                </button>

                                <button type="button"
                                        class="ib-employee-schedule-delete"
                                        data-horario-id="@horario.Id"
                                        title="Eliminar horário"
                                        aria-label="Eliminar horário">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 6h18"></path>
                                        <path d="M8 6V4h8v2"></path>
                                        <path d="M19 6l-1 14H6L5 6"></path>
                                        <path d="M10 11v5"></path>
                                        <path d="M14 11v5"></path>
                                    </svg>
                                </button>

                            </div>

            </div>
        }
    }
    else
    {
        <div id="horariosEmpty"
             class="ib-employee-services-empty">
            Este funcionário ainda não possui horário de trabalho definido.
        </div>
    }

</div>

</div>

        <footer class="ib-category-form-footer">

            <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit" class="ib-category-save-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M5 12l4 4L19 6"></path>
                </svg>
                Guardar alterações
            </button>

        </footer>

    </form>

    <!-- PERFIL E PERMISSÕES -->
    <section class="ib-category-form-card ib-employee-permissions-card">

        <div class="ib-category-form-card-header">
            <div>
                <span class="ib-section-eyebrow">ACESSO</span>
                <h3>Perfil e Permissões</h3>
                <p>Gerir o perfil permanente e o acesso administrativo deste utilizador.</p>
            </div>
        </div>

        <div class="ib-employee-permissions-grid">

            <!-- PERFIL PERMANENTE -->
            <div class="ib-employee-permission-block">

                <div class="ib-employee-permission-title">
                    <div>
                        <span class="ib-section-eyebrow">PERFIL PERMANENTE</span>
                        <h4>Perfil do utilizador</h4>
                    </div>

                    <span class="ib-employee-role-badge">
                        @Model.RoleAtual
                    </span>
                </div>

                <p class="ib-employee-permission-description">
                    O perfil determina permanentemente as funcionalidades
                    disponíveis para este utilizador.
                </p>

                <form asp-controller="GestaoFuncionarios"
                      asp-action="AlterarRole"
                      method="post"
                      id="formAlterarRole">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <input type="hidden" name="funcionarioId" value="@Model.Id" />

                    <div class="ib-category-field">
                        <label for="novaRole">Alterar perfil para</label>

                        <select id="novaRole" name="novaRole">
                            <option value="">Selecione o novo perfil</option>
                            <option value="Admin">Administrador</option>
                            <option value="Cliente">Cliente</option>
                        </select>
                    </div>

                    <div class="ib-employee-permission-warning">
                        <strong>Atenção</strong>
                        <span>
                            Esta alteração é permanente e modifica as permissões
                            deste utilizador no sistema.
                        </span>
                    </div>

                    <button type="submit"
                            class="ib-category-save-btn"
                            id="btnAlterarRole">
                        Alterar perfil
                    </button>

                </form>

            </div>

            <!-- ADMIN TEMPORÁRIO -->
            <div class="ib-employee-permission-block">

                <div class="ib-employee-permission-title">
                    <div>
                        <span class="ib-section-eyebrow">ACESSO TEMPORÁRIO</span>
                        <h4>Administrador temporário</h4>
                    </div>

                    @if (Model.PermissaoAdminTemporariaAtiva != null)
                    {
                        <span class="ib-employee-temp-badge is-active">
                            Ativo
                        </span>
                    }
                    else
                    {
                        <span class="ib-employee-temp-badge">
                            Sem acesso
                        </span>
                    }
                </div>

                @if (Model.PermissaoAdminTemporariaAtiva != null)
                {
                    <div class="ib-employee-temp-active">

                        <strong>Acesso administrativo temporário ativo</strong>

                        <p>
                            Válido até
                            <strong>
                                @Model.PermissaoAdminTemporariaAtiva.DataFim.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")
                            </strong>
                        </p>

                        @if (!string.IsNullOrWhiteSpace(
                            Model.PermissaoAdminTemporariaAtiva.Motivo))
                        {
                            <p>
                                Motivo:
                                @Model.PermissaoAdminTemporariaAtiva.Motivo
                            </p>
                        }

                        <form asp-controller="GestaoFuncionarios"
                              asp-action="RevogarAdminTemporario"
                              method="post"
                              onsubmit="return confirm('Pretende revogar o acesso administrativo temporário deste funcionário?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="permissaoId"
                                   value="@Model.PermissaoAdminTemporariaAtiva.Id" />

                            <input type="hidden"
                                   name="funcionarioId"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="ib-category-cancel-btn">
                                Revogar acesso
                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <p class="ib-employee-permission-description">
                        Conceda acesso às funcionalidades administrativas durante
                        um período limitado, sem alterar o perfil permanente.
                    </p>

                    <form asp-controller="GestaoFuncionarios"
                          asp-action="ConcederAdminTemporario"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="FuncionarioUserId"
                               value="@Model.UserId" />

                        <input type="hidden"
                               name="funcionarioId"
                               value="@Model.Id" />

                        <div class="ib-category-field">
                            <label for="DuracaoMinutos">
                                Duração do acesso
                            </label>

                            <select id="DuracaoMinutos"
                                    name="DuracaoMinutos">
                                <option value="5">5 minutos</option>
                                <option value="10">10 minutos</option>
                                <option value="15">15 minutos</option>
                                <option value="30">30 minutos</option>
                                <option value="60">1 hora</option>
                                <option value="120">2 horas</option>
                                <option value="240">4 horas</option>
                                <option value="480">8 horas</option>
                                <option value="720">12 horas</option>
                                <option value="1440">24 horas</option>
                            </select>
                        </div>

                        <div class="ib-category-field">
                            <div class="ib-category-field-label">
                                <label for="Motivo">Motivo</label>
                                <span>Opcional</span>
                            </div>

                            <textarea id="Motivo"
                                      name="Motivo"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Ex.: substituição temporária da administração"></textarea>
                        </div>

                        <button type="submit"
                                class="ib-category-save-btn">
                            Conceder acesso temporário
                        </button>

                    </form>
                }

            </div>

        </div>

    </section>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
    document.addEventListener("DOMContentLoaded", function () {
                const formAlterarRole = document.getElementById("formAlterarRole");

        if (formAlterarRole) {
            formAlterarRole.addEventListener("submit", function (event) {
                const role = document.getElementById("novaRole").value;

                if (!role) {
                    event.preventDefault();
                    alert("Selecione o novo perfil do utilizador.");
                    return;
                }

                const confirmar = confirm(
                    "Pretende alterar permanentemente o perfil deste utilizador para "
                    + role
                    + "?"
                );

                if (!confirmar) {
                    event.preventDefault();
                }
            });
        }

        // =====================================================
        // PESQUISA DE SERVIÇOS
        // =====================================================

        const pesquisaServicos =
            document.getElementById("pesquisaServicosFuncionario");

        if (pesquisaServicos) {
            const itens =
                document.querySelectorAll(".ib-employee-service-item");

            pesquisaServicos.addEventListener("input", function () {
                const termo = this.value.trim().toLowerCase();
                let encontrados = 0;

                itens.forEach(function (item) {
                    const servico = item.dataset.servico || "";
                    const categoria = item.dataset.categoria || "";

                    const corresponde =
                        servico.includes(termo) ||
                        categoria.includes(termo);

                    item.style.display =
                        corresponde ? "flex" : "none";

                    if (corresponde) {
                        encontrados++;
                    }
                });

                const semResultados =
                    document.getElementById("semResultadosServicos");

                if (semResultados) {
                    semResultados.style.display =
                        encontrados === 0 ? "block" : "none";
                }
            });
        }


        // =====================================================
        // ABRIR / FECHAR FORMULÁRIO DE COMPETÊNCIA
        // =====================================================

        const btnAdicionarCompetencia =
            document.getElementById("btnAdicionarCompetencia");

        const btnCancelarCompetencia =
            document.getElementById("btnCancelarCompetencia");

        const formAdicionarCompetencia =
            document.getElementById("formAdicionarCompetencia");

        if (btnAdicionarCompetencia && formAdicionarCompetencia) {
            btnAdicionarCompetencia.addEventListener("click", function () {
                formAdicionarCompetencia.style.display = "grid";
            });
        }

        if (btnCancelarCompetencia && formAdicionarCompetencia) {
            btnCancelarCompetencia.addEventListener("click", function () {
                formAdicionarCompetencia.style.display = "none";
            });
        }


        // =====================================================
        // PESQUISA DE COMPETÊNCIAS
        // =====================================================

        const pesquisaCompetencias =
            document.getElementById("pesquisaCompetenciasFuncionario");

        if (pesquisaCompetencias) {
            const competencias =
                document.querySelectorAll(".ib-employee-competency-item");

            pesquisaCompetencias.addEventListener("input", function () {
                const termo = this.value.trim().toLowerCase();

                competencias.forEach(function (item) {
                    const nome = item.dataset.nome || "";

                    item.style.display =
                        nome.includes(termo) ? "flex" : "none";
                });
            });
        }


        // =====================================================
        // ADICIONAR COMPETÊNCIA
        // =====================================================

        const btnGuardarCompetencia =
            document.getElementById("btnGuardarCompetencia");

        if (btnGuardarCompetencia) {
            btnGuardarCompetencia.addEventListener(
                "click",
                async function () {

                    const competenciaId =
                        document.getElementById("novaCompetenciaId").value;

                    const nivel =
                        document.getElementById("novoNivelCompetencia")
                            .value
                            .trim();

                    const certificacao =
                        document.getElementById("novaCertificacaoCompetencia")
                            .value
                            .trim();

                    if (!competenciaId) {
                        alert("Selecione uma competência.");
                        return;
                    }

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    btnGuardarCompetencia.disabled = true;

                    try {
                        const response = await fetch(
                            '@Url.Action("AdicionarCompetencia", "GestaoFuncionarios")',
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify({
                                    funcionarioId: @Model.Id,
                                    competenciaId:
                                        parseInt(competenciaId),
                                    nivel: nivel || null,
                                    certificacao:
                                        certificacao || null
                                })
                            });

                        if (!response.ok) {
                            const erro = await response.json();

                            alert(
                                erro.mensagem ||
                                "Não foi possível adicionar a competência."
                            );

                            return;
                        }

                        location.reload();
                    }
                    catch {
                        alert(
                            "Ocorreu um erro ao adicionar a competência."
                        );
                    }
                    finally {
                        btnGuardarCompetencia.disabled = false;
                    }
                }
            );
        }


        // =====================================================
        // REMOVER COMPETÊNCIA
        // =====================================================

        const botoesRemoverCompetencia =
            document.querySelectorAll(
                ".ib-employee-competency-remove"
            );

        botoesRemoverCompetencia.forEach(function (botao) {

            botao.addEventListener(
                "click",
                async function () {

                    const id = this.dataset.id;

                    if (!id) {
                        return;
                    }

                    const confirmar = confirm(
                        "Pretende remover esta competência do funcionário?"
                    );

                    if (!confirmar) {
                        return;
                    }

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    this.disabled = true;

                    try {
                        const response = await fetch(
                            '@Url.Action("RemoverCompetencia", "GestaoFuncionarios")'
                            + "?id="
                            + encodeURIComponent(id),
                            {
                                method: "POST",

                                headers: {
                                    "RequestVerificationToken": token
                                }
                            });

                        if (!response.ok) {
                            const erro = await response.json();

                            alert(
                                erro.mensagem ||
                                "Não foi possível remover a competência."
                            );

                            return;
                        }

                        location.reload();
                    }
                    catch {
                        alert(
                            "Ocorreu um erro ao remover a competência."
                        );
                    }
                    finally {
                        this.disabled = false;
                    }
                }
            );
        });

    });

    const btnAdicionarHorario =
    document.getElementById("btnAdicionarHorario");

if (btnAdicionarHorario) {

    btnAdicionarHorario.addEventListener("click", async function () {

        const area = document.getElementById("horarioCreateArea");
        const mensagem = document.getElementById("horarioMensagem");

        const funcionarioId =
            parseInt(area.dataset.funcionarioId);

        const diaSemana =
            document.getElementById("horarioDiaSemana").value;

        const horaInicio =
            document.getElementById("horarioHoraInicio").value;

        const horaFim =
            document.getElementById("horarioHoraFim").value;

        if (diaSemana === "" || !horaInicio || !horaFim) {
            mensagem.style.display = "block";
            mensagem.textContent =
                "Preencha o dia da semana, a hora de início e a hora de fim.";
            return;
        }

        btnAdicionarHorario.disabled = true;
        btnAdicionarHorario.textContent = "A adicionar...";

        try {

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;

            const formData = new FormData();

            formData.append("FuncionarioId", funcionarioId);
            formData.append("DiaSemana", diaSemana);
            formData.append("HoraInicio", horaInicio);
            formData.append("HoraFim", horaFim);

            const response = await fetch(
                '@Url.Action("AdicionarHorario", "GestaoFuncionarios")',
                {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    body: formData
                });

            const resultado = await response.json();

            if (!response.ok) {
                throw new Error(
                    resultado.mensagem ||
                    "Não foi possível adicionar o horário."
                );
            }

            mensagem.style.display = "block";
            mensagem.textContent = resultado.mensagem || "Horário adicionado com sucesso.";

            if (resultado.horario) {

    const horario = resultado.horario;
    const lista = document.getElementById("horariosLista");

    const vazio = document.getElementById("horariosEmpty");
    if (vazio) {
        vazio.remove();
    }

    const nomesDias = {
        0: "Domingo",
        1: "Segunda-feira",
        2: "Terça-feira",
        3: "Quarta-feira",
        4: "Quinta-feira",
        5: "Sexta-feira",
        6: "Sábado"
    };

    const item = document.createElement("div");

    item.className = "ib-employee-schedule-item";
    item.dataset.horarioId = horario.id;

            item.innerHTML = `
            <div class="ib-employee-schedule-day">
                <strong>${nomesDias[horario.diaSemana]}</strong>
                <span>${horario.horaInicio} – ${horario.horaFim}</span>
            </div>

            <div class="ib-employee-schedule-actions">

                <button type="button"
                        class="ib-employee-schedule-edit"
                        data-horario-id="${horario.id}"
                        title="Editar horário"
                        aria-label="Editar horário">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                    </svg>
                </button>

                <button type="button"
                        class="ib-employee-schedule-delete"
                        data-horario-id="${horario.id}"
                        title="Eliminar horário"
                        aria-label="Eliminar horário">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v5"></path>
                        <path d="M14 11v5"></path>
                    </svg>
                </button>

            </div>
        `;
    item.dataset.diaSemana = horario.diaSemana;
    item.dataset.horaInicio = horario.horaInicio;
        item.dataset.horaFim = horario.horaFim;
    lista.appendChild(item);

const itens = Array.from(
    lista.querySelectorAll(".ib-employee-schedule-item")
);

itens.sort((a, b) => {

    const ordemDia = dia => {
        const valor = Number(dia);
        return valor === 0 ? 7 : valor;
    };

    const diaA = ordemDia(a.dataset.diaSemana);
    const diaB = ordemDia(b.dataset.diaSemana);

    if (diaA !== diaB) {
        return diaA - diaB;
    }

    return (a.dataset.horaInicio || "")
        .localeCompare(b.dataset.horaInicio || "");
});

itens.forEach(x => lista.appendChild(x));
}


            document.getElementById("horarioDiaSemana").value = "";
            document.getElementById("horarioHoraInicio").value = "";
            document.getElementById("horarioHoraFim").value = "";

        }
        catch (erro) {

            mensagem.style.display = "block";
            mensagem.textContent = erro.message;

        }
        finally {

            btnAdicionarHorario.disabled = false;
            btnAdicionarHorario.textContent = "+ Adicionar horário";
        }
    });
}

const horariosLista =
    document.getElementById("horariosLista");

if (horariosLista) {

    horariosLista.addEventListener("click", async function (event) {
                const botaoEditar =
            event.target.closest(".ib-employee-schedule-edit");

        if (botaoEditar) {
            const item =
                botaoEditar.closest(".ib-employee-schedule-item");

            if (!item) return;

            const diaSemana = item.dataset.diaSemana;
            const horaInicio = item.dataset.horaInicio;
            const horaFim = item.dataset.horaFim;

            const conteudo =
                item.querySelector(".ib-employee-schedule-day");

            const acoes =
                item.querySelector(".ib-employee-schedule-actions");

            conteudo.innerHTML = `
                <select class="ib-schedule-edit-day">
                    <option value="1">Segunda-feira</option>
                    <option value="2">Terça-feira</option>
                    <option value="3">Quarta-feira</option>
                    <option value="4">Quinta-feira</option>
                    <option value="5">Sexta-feira</option>
                    <option value="6">Sábado</option>
                    <option value="0">Domingo</option>
                </select>

                <input type="time"
                       class="ib-schedule-edit-start"
                       value="${horaInicio}" />

                <input type="time"
                       class="ib-schedule-edit-end"
                       value="${horaFim}" />
            `;

            conteudo
                .querySelector(".ib-schedule-edit-day")
                .value = diaSemana;

            acoes.innerHTML = `
                <button type="button"
                        class="ib-schedule-edit-save">
                    Guardar
                </button>

                <button type="button"
                        class="ib-schedule-edit-cancel">
                    Cancelar
                </button>
            `;

            return;
        }
                // CANCELAR EDIÇÃO
        const botaoCancelar =
            event.target.closest(".ib-schedule-edit-cancel");

        if (botaoCancelar) {
            const item =
                botaoCancelar.closest(".ib-employee-schedule-item");

            if (!item) return;

            const nomesDias = {
                0: "Domingo",
                1: "Segunda-feira",
                2: "Terça-feira",
                3: "Quarta-feira",
                4: "Quinta-feira",
                5: "Sexta-feira",
                6: "Sábado"
            };

            item.querySelector(".ib-employee-schedule-day").innerHTML = `
                <strong>${nomesDias[item.dataset.diaSemana]}</strong>
                <span>${item.dataset.horaInicio} – ${item.dataset.horaFim}</span>
            `;

            item.querySelector(".ib-employee-schedule-actions").innerHTML = `
                <button type="button"
                        class="ib-employee-schedule-edit"
                        data-horario-id="${item.dataset.horarioId}"
                        title="Editar horário"
                        aria-label="Editar horário">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                    </svg>
                </button>

                <button type="button"
                        class="ib-employee-schedule-delete"
                        data-horario-id="${item.dataset.horarioId}"
                        title="Eliminar horário"
                        aria-label="Eliminar horário">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 14H6L5 6"></path>
                        <path d="M10 11v5"></path>
                        <path d="M14 11v5"></path>
                    </svg>
                </button>
            `;

            return;
        }


        // GUARDAR EDIÇÃO
        const botaoGuardar =
            event.target.closest(".ib-schedule-edit-save");

        if (botaoGuardar) {
            const item =
                botaoGuardar.closest(".ib-employee-schedule-item");

            if (!item) return;

            const horarioId = item.dataset.horarioId;
            const funcionarioId =
                document.getElementById("horarioCreateArea").dataset.funcionarioId;

            const diaSemana =
                item.querySelector(".ib-schedule-edit-day").value;

            const horaInicio =
                item.querySelector(".ib-schedule-edit-start").value;

            const horaFim =
                item.querySelector(".ib-schedule-edit-end").value;

            if (!horaInicio || !horaFim) return;

            botaoGuardar.disabled = true;
            botaoGuardar.textContent = "A guardar...";

            try {
                const token =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value;

                const formData = new FormData();

                formData.append("id", horarioId);
                formData.append("funcionarioId", funcionarioId);
                formData.append("diaSemana", diaSemana);
                formData.append("horaInicio", horaInicio);
                formData.append("horaFim", horaFim);

                const response = await fetch(
                    '@Url.Action("EditarHorario", "GestaoFuncionarios")',
                    {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": token
                        },
                        body: formData
                    });

                const resultado = await response.json();

                if (!response.ok) {
                    throw new Error(
                        resultado.mensagem ||
                        "Não foi possível atualizar o horário."
                    );
                }

                const horario = resultado.horario;

                // Atualiza os dados guardados na própria linha
                item.dataset.diaSemana = horario.diaSemana;
                item.dataset.horaInicio = horario.horaInicio;
                item.dataset.horaFim = horario.horaFim;

                const nomesDias = {
                    0: "Domingo",
                    1: "Segunda-feira",
                    2: "Terça-feira",
                    3: "Quarta-feira",
                    4: "Quinta-feira",
                    5: "Sexta-feira",
                    6: "Sábado"
                };

                item.querySelector(".ib-employee-schedule-day").innerHTML = `
                    <strong>${nomesDias[horario.diaSemana]}</strong>
                    <span>${horario.horaInicio} – ${horario.horaFim}</span>
                `;

                item.querySelector(".ib-employee-schedule-actions").innerHTML = `
                    <button type="button"
                            class="ib-employee-schedule-edit"
                            data-horario-id="${horario.id}"
                            title="Editar horário"
                            aria-label="Editar horário">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                        </svg>
                    </button>

                    <button type="button"
                            class="ib-employee-schedule-delete"
                            data-horario-id="${horario.id}"
                            title="Eliminar horário"
                            aria-label="Eliminar horário">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 6h18"></path>
                            <path d="M8 6V4h8v2"></path>
                            <path d="M19 6l-1 14H6L5 6"></path>
                            <path d="M10 11v5"></path>
                            <path d="M14 11v5"></path>
                        </svg>
                    </button>
                `;

                const mensagem =
                    document.getElementById("horarioMensagem");

                if (mensagem) {
                    mensagem.style.display = "block";
                    mensagem.textContent =
                        resultado.mensagem || "Horário atualizado com sucesso.";
                }
            }
            catch (erro) {
                botaoGuardar.disabled = false;
                botaoGuardar.textContent = "Guardar";

                const mensagem =
                    document.getElementById("horarioMensagem");

                if (mensagem) {
                    mensagem.style.display = "block";
                    mensagem.textContent = erro.message;
                }
            }

            return;
        }

        const botao = event.target.closest(".ib-employee-schedule-delete");

        if (!botao) {
            return;
        }

        const horarioId = botao.dataset.horarioId;
        const item = botao.closest(".ib-employee-schedule-item");

        if (!horarioId || !item) {
            return;
        }

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

        botao.disabled = true;

        try {

            const formData = new FormData();
            formData.append("id", horarioId);

            const response = await fetch(
                '@Url.Action("EliminarHorario", "GestaoFuncionarios")',
                {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    body: formData
                });

            const resultado = await response.json();

            if (!response.ok) {
                throw new Error(
                    resultado.mensagem ||
                    "Não foi possível eliminar o horário."
                );
            }

            item.remove();

            const restantes =
                horariosLista.querySelectorAll(
                    ".ib-employee-schedule-item"
                );

            if (restantes.length === 0) {

                horariosLista.innerHTML = `
                    <div id="horariosEmpty"
                         class="ib-employee-services-empty">
                        Este funcionário ainda não possui horário de trabalho definido.
                    </div>
                `;
            }

        }
        catch (erro) {

            botao.disabled = false;

            const mensagem =
                document.getElementById("horarioMensagem");

            if (mensagem) {
                mensagem.style.display = "block";
                mensagem.textContent = erro.message;
            }
        }
    });
}
</script>

}
@model ProjetoFinalCet105.Web.Models.FuncionarioFormViewModel

@{
    ViewData["Title"] = "Novo Funcionário";
    Layout = "_AdminLayout";
}

<div class="ib-category-form-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">EQUIPA</span>
            <h1>Novo Funcionário</h1>
            <p>Adicione um novo profissional à equipa Infinity Beauty.</p>
        </div>

        <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar à equipa
        </a>
    </section>

    <form asp-controller="GestaoFuncionarios" asp-action="Criar" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="ib-category-form-validation"></div>

        <div class="ib-category-form-grid">

            <!-- DADOS DO FUNCIONÁRIO -->
            <section class="ib-category-form-card">

                <header class="ib-category-form-card-header">
                    <div class="ib-category-form-card-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                        </svg>
                    </div>

                    <div>
                        <span class="ib-section-eyebrow">INFORMAÇÃO</span>
                        <h2>Dados do funcionário</h2>
                        <p>Introduza os dados de identificação e contacto do profissional.</p>
                    </div>
                </header>

                <!-- NOME -->
                <div class="ib-category-field">
                    <label asp-for="NomeCompleto">
                        Nome completo <span>*</span>
                    </label>

                    <input asp-for="NomeCompleto"
                           placeholder="Ex.: Mariana Silva"
                           autocomplete="name" />

                    <span asp-validation-for="NomeCompleto" class="ib-field-validation"></span>
                </div>

                <!-- EMAIL -->
                <div class="ib-category-field">
                    <label asp-for="Email">
                        Email <span>*</span>
                    </label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="Ex.: mariana@infinitybeauty.pt"
                           autocomplete="email" />

                    <span asp-validation-for="Email" class="ib-field-validation"></span>

                    <small>
                        O convite de primeiro acesso será enviado para este endereço.
                    </small>
                </div>

                <!-- TELEFONE + DATA DE ADMISSÃO -->
                <div class="ib-service-form-row">

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="Telefone">Telefone</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="Telefone"
                               type="tel"
                               placeholder="Ex.: 912 345 678"
                               autocomplete="tel" />

                        <span asp-validation-for="Telefone" class="ib-field-validation"></span>
                    </div>

                    <div class="ib-category-field">
                        <div class="ib-category-field-label">
                            <label asp-for="DataAdmissao">Data de admissão</label>
                            <span>Opcional</span>
                        </div>

                        <input asp-for="DataAdmissao" type="date" />

                        <span asp-validation-for="DataAdmissao" class="ib-field-validation"></span>
                    </div>

                </div>

                <!-- BIOGRAFIA -->
                <div class="ib-category-field">
                    <div class="ib-category-field-label">
                        <label asp-for="Biografia">Biografia</label>
                        <span>Opcional</span>
                    </div>

                    <textarea asp-for="Biografia"
                              rows="5"
                              placeholder="Breve apresentação profissional, experiência ou especialidades..."></textarea>

                    <span asp-validation-for="Biografia" class="ib-field-validation"></span>

                    <small>
                        Esta informação poderá ser posteriormente atualizada no perfil do funcionário.
                    </small>
                </div>

            </section>

            <!-- CONFIGURAÇÃO INICIAL -->
            <section class="ib-category-image-card ib-employee-create-side">

                <header>
                    <span class="ib-section-eyebrow">ACESSO</span>
                    <h2>Configuração inicial</h2>
                    <p>Defina a disponibilidade inicial e consulte o processo de ativação da conta.</p>
                </header>

                <div class="ib-employee-create-status">

                    <label class="ib-employee-option" for="Disponivel">
                        <div class="ib-employee-option-icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M8 12l2.5 2.5L16 9"></path>
                            </svg>
                        </div>

                        <div class="ib-employee-option-content">
                            <strong>Disponível para marcações</strong>
                            <span>O funcionário poderá ser apresentado como disponível na agenda.</span>
                        </div>

                        <div class="ib-employee-switch">
                            <input asp-for="Disponivel" type="checkbox" />
                            <span></span>
                        </div>
                    </label>

                </div>

                <div class="ib-employee-invite-flow">

                    <div class="ib-employee-invite-step">
                        <span>1</span>
                        <div>
                            <strong>Conta criada</strong>
                            <small>O funcionário é registado e fica ativo no sistema.</small>
                        </div>
                    </div>

                    <div class="ib-employee-invite-line"></div>

                    <div class="ib-employee-invite-step">
                        <span>2</span>
                        <div>
                            <strong>Convite por email</strong>
                            <small>É enviado automaticamente um link de primeiro acesso.</small>
                        </div>
                    </div>

                    <div class="ib-employee-invite-line"></div>

                    <div class="ib-employee-invite-step">
                        <span>3</span>
                        <div>
                            <strong>Ativação do acesso</strong>
                            <small>O funcionário confirma o email e define a própria palavra-passe.</small>
                        </div>
                    </div>

                </div>

                <div class="ib-category-image-note">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 11v5"></path>
                        <path d="M12 8h.01"></path>
                    </svg>

                    <p>
                        A fotografia não é definida pelo administrador.
                        O funcionário poderá adicionar ou alterar a própria fotografia na sua área de perfil.
                    </p>
                </div>

            </section>

        </div>

        <!-- BOTÕES -->
        <footer class="ib-category-form-footer">

            <a asp-controller="GestaoFuncionarios" asp-action="Index" class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit" class="ib-category-save-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14"></path>
                    <path d="M5 12h14"></path>
                </svg>
                Criar funcionário
            </button>

        </footer>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
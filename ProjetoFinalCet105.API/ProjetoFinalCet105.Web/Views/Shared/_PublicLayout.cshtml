<!DOCTYPE html>

<html lang="pt">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"  content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Infinity Beauty</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap"
          rel="stylesheet">


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/infinity-public.css" asp-append-version="true" />

</head>

<body>

    <header class="ib-header">

        <div class="ib-navbar">

            <a asp-controller="Home" asp-action="Index" class="ib-brand">

                <img src="~/images/logo-symbol.png" alt="Infinity Beauty" class="ib-brand-symbol" />

                <div class="ib-brand-text">

                    <span class="ib-brand-name"> INFINITY BEAUTY  </span>

                    <span class="ib-brand-subtitle">  CENTER <b>|</b> SPA <b>|</b> WELLNESS</span>

                </div>

            </a>


            <nav class="ib-navigation">

                <a asp-controller="Home"  asp-action="Index"  class="active">   Início  </a>

                <a asp-controller="Servicos" asp-action="Index">  Serviços  </a>

                <a href="#">   Profissionais   </a>

                <a href="#">   Sobre nós   </a>

                <a href="#">   Contactos  </a>

            </nav>


            <div class="ib-actions">

                <a href="#"   class="ib-search"   aria-label="Pesquisar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">

                        <circle cx="11"  cy="11"  r="7"> </circle>

                        <line x1="16"  y1="16"  x2="21"  y2="21"> </line>

                    </svg>

                </a>


                <a href="#" class="ib-login-button">

                    <svg class="ib-user-icon"  viewBox="0 0 24 24"  aria-hidden="true">

                        <circle cx="12" cy="8" r="4"> </circle>

                        <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"> </path>

                    </svg>

                    <span>Entrar</span>

                </a>


                <a href="#" class="ib-book-button">

                    <svg class="ib-calendar-icon" viewBox="0 0 24 24"  aria-hidden="true">

                        <rect x="3"  y="5" width="18" height="16" rx="2"> </rect>

                        <line x1="8" y1="3" x2="8" y2="7"> </line>

                        <line x1="16"  y1="3" x2="16" y2="7"> </line>

                        <line x1="3" y1="10" x2="21" y2="10"></line>

                    </svg>

                    <span>Marcar agora</span>

                </a>

            </div>

        </div>

    </header>


    <main>

        @RenderBody()

    </main>


    <footer class="ib-footer">

        <div class="ib-footer-main">

            <div class="ib-footer-brand">

                <div class="ib-footer-brand-row">

                    <img src="~/images/logo-symbol.png"
                         alt="Infinity Beauty"
                         class="ib-footer-symbol" />

                    <div class="ib-footer-brand-text">

                        <span class="ib-footer-brand-name">
                            INFINITY BEAUTY
                        </span>

                        <span class="ib-footer-brand-subtitle">
                            CENTER | SPA | WELLNESS
                        </span>

                    </div>

                </div>

            </div>


            <div class="ib-footer-links">

                <a asp-controller="Home"
                   asp-action="Index">
                    Início
                </a>

                <a asp-controller="Servicos"
                   asp-action="Index">
                    Serviços
                </a>

            </div>


            <div class="ib-footer-links">

                <a href="#">
                    Profissionais
                </a>

                <a href="#">
                    Sobre nós
                </a>

            </div>


            <div class="ib-footer-links">

                <a href="#">
                    Contactos
                </a>

                <a href="#">
                    FAQs
                </a>

            </div>


            <div class="ib-footer-actions">

                <div class="ib-footer-socials">

                    <a href="#"
                       aria-label="Facebook">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.7.3-1 1-1z"></path>
                        </svg>

                    </a>


                    <a href="#"
                       aria-label="Instagram">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <rect x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="5">
                            </rect>

                            <circle cx="12"
                                    cy="12"
                                    r="4">
                            </circle>

                            <circle cx="17.5"
                                    cy="6.5"
                                    r="1">
                            </circle>

                        </svg>

                    </a>


                    <a href="#"
                       aria-label="WhatsApp">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5z"></path>

                            <path d="M9 8.5c.3 2.2 2 4 4.4 4.8"></path>

                        </svg>

                    </a>

                </div>


                <span class="ib-footer-separator"></span>


                <a href="#"
                   class="ib-footer-book">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">

                        <rect x="3"
                              y="5"
                              width="18"
                              height="16"
                              rx="2">
                        </rect>

                        <line x1="8"
                              y1="3"
                              x2="8"
                              y2="7">
                        </line>

                        <line x1="16"
                              y1="3"
                              x2="16"
                              y2="7">
                        </line>

                        <line x1="3"
                              y1="10"
                              x2="21"
                              y2="10">
                        </line>

                    </svg>

                    Marcar agora

                </a>

            </div>

        </div>


        <div class="ib-footer-bottom">

            <span>
                © @DateTime.Now.Year Infinity Beauty. Todos os direitos reservados.
            </span>

            <div>
                <a href="#">Política de Privacidade</a>

                <span>|</span>

                <a href="#">Termos &amp; Condições</a>
            </div>

        </div>

    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts",required: false)

</body>
</html>

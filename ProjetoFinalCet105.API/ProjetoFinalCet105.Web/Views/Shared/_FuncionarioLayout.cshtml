<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Infinity Beauty</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/infinity-funcionario.css" asp-append-version="true" />    

    <link rel="stylesheet" href="~/css/infinity-admin.css" asp-append-version="true" />
</head>

<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="ib-admin">

        <!-- =========================
             SIDEBAR
        ========================== -->

        <aside class="ib-admin-sidebar" id="adminSidebar">

            <a asp-controller="Funcionarios" asp-action="Index" class="ib-admin-logo">
                <img src="~/images/logo-symbol.png"
                     alt="Infinity Beauty" />

                <div>
                    <strong>INFINITY BEAUTY</strong>

                    <span>
                        CENTER | SPA | WELLNESS
                    </span>
                </div>

            </a>




<a asp-controller="Funcionario"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "Funcionario" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <path d="M3 11L12 3l9 8"></path>
        <path d="M5 10v11h14V10"></path>
        <path d="M9 21v-7h6v7"></path>
    </svg>

    <span>Início</span>
</a>

            <a asp-controller="MinhaAgenda"
               asp-action="Index"
               class="ib-admin-menu-item @(currentController == "MinhaAgenda" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
        <path d="M16 3v4"></path>
        <path d="M8 3v4"></path>
        <path d="M3 11h18"></path>
    </svg>

    <span>Minha Agenda</span>
</a>



            <a asp-controller="NovaMarcacaoFuncionario"
               asp-action="Index"
               class="ib-admin-menu-item @(currentController == "NovaMarcacaoFuncionario" ? "active" : "")">
    <svg viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
        <path d="M16 3v4"></path>
        <path d="M8 3v4"></path>
        <path d="M3 11h18"></path>
        <path d="M12 14v5"></path>
        <path d="M9.5 16.5h5"></path>
    </svg>

    <span>Nova Marcação</span>
</a>


<a asp-controller="MeuHorario"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "MeuHorario" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
    </svg>

    <span>Meu Horário</span>
</a>


<a asp-controller="GestaoIndisponibilidades"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "GestaoIndisponibilidades" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
        <path d="M16 3v4"></path>
        <path d="M8 3v4"></path>
        <path d="M3 11h18"></path>
        <path d="M8 16h8"></path>
    </svg>

    <span>Indisponibilidades</span>
</a>





<a asp-controller="FaturasFuncionario"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "FaturasFuncionario" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path>
        <path d="M9 8h6"></path>
        <path d="M9 12h6"></path>
    </svg>

    <span>Faturas</span>
</a>


<a asp-controller="FeedbackFuncionario"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "FeedbackFuncionario" ? "active" : "")">


    <svg viewBox="0 0 24 24">
        <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"></path>
    </svg>

    <span>Feedback</span>
</a>
            <a asp-controller="MinhasCompetencias"
               asp-action="Index"
               class="ib-admin-menu-item @(currentController == "MinhasCompetencias" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M5 21c0-4 3.1-7 7-7s7 3 7 7"></path>
        <path d="M18 5l1 1 2-2"></path>
    </svg>

    <span>Minhas Competências</span>
</a>



<a asp-controller="MensagensFuncionario"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "MensagensFuncionario" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <path d="M4 4h16v12H8l-4 4z"></path>
        <path d="M8 9h8"></path>
        <path d="M8 12h5"></path>
    </svg>

    <span>Mensagens</span>
</a>


<a href="#"
   class="ib-admin-menu-item">

    <svg viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
        <path d="M10 21h4"></path>
    </svg>

    <span>Notificações</span>
</a>
                <div id="adminTemporarioMenu" style="display:none;">

                    <div class="ib-admin-signature">
                        <span>ADMIN TEMPORÁRIO</span>
                        <small id="adminTemporarioTempo"></small>
                    </div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="ib-admin-menu-item @(currentController == "Dashboard" ? "active" : "")">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="GestaoServicos"
                       asp-action="Index"
                       class="ib-admin-menu-item @(currentController == "GestaoServicos" ? "active" : "")">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 3v18"></path>
                            <path d="M3 12h18"></path>
                            <circle cx="12" cy="12" r="9"></circle>
                        </svg>
                        <span>Serviços</span>
                    </a>

                    <a asp-controller="GestaoFuncionarioServicos" asp-action="Index"  class="ib-admin-menu-item @(currentController == "GestaoFuncionarioServicos" ? "active" : "")">
    <span class="ib-sidebar-icon">
        <svg viewBox="0 0 24 24">
            <circle cx="9" cy="8" r="3"></circle>
            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path>
            <path d="M17 8h4"></path>
            <path d="M19 6v4"></path>
        </svg>
    </span>
    <span>Profissionais e Serviços</span>
</a>

                    <a asp-controller="Categorias"
                       asp-action="Index"
                       class="ib-admin-menu-item @(currentController == "Categorias" ? "active" : "")">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="4" width="7" height="7"></rect>
                            <rect x="14" y="4" width="7" height="7"></rect>
                            <rect x="3" y="15" width="7" height="6"></rect>
                            <rect x="14" y="15" width="7" height="6"></rect>
                        </svg>
                        <span>Categorias</span>
                    </a>

                    <a asp-controller="GestaoDespesas"
                       asp-action="Index"
                       class="ib-admin-menu-item @(currentController == "GestaoDespesas" ? "active" : "")">
                        <svg viewBox="0 0 24 24">
                            <rect x="3" y="4" width="7" height="7"></rect>
                            <rect x="14" y="4" width="7" height="7"></rect>
                            <rect x="3" y="15" width="7" height="6"></rect>
                            <rect x="14" y="15" width="7" height="6"></rect>
                        </svg>
                        <span>Despesas</span>
                    </a>
                    <a asp-controller="GestaoPromocoes"
   asp-action="Index"
   class="ib-admin-menu-item @(currentController == "GestaoPromocoes" ? "active" : "")">

    <svg viewBox="0 0 24 24">
        <path d="M20 12l-8 8-8-8V4h8z"></path>
        <circle cx="9" cy="8" r="1.5"></circle>
    </svg>

    <span>Promoções</span>
</a>

                </div>

            </nav>


            <div class="ib-admin-sidebar-footer">

                <span class="ib-admin-signature">
                    Beleza,<br />
                    bem-estar, sempre.
                </span>

                <a asp-controller="Home"
                   asp-action="Index">

                    ← Voltar ao site
                </a>

            </div>

        </aside>


        <!-- =========================
             MAIN
        ========================== -->

        <div class="ib-admin-main">

            <!-- TOPBAR -->

            <header class="ib-admin-topbar">

                <button type="button"
                        class="ib-admin-menu-toggle"
                        id="adminMenuToggle"
                        aria-label="Abrir menu"
                        aria-expanded="false">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>


                <div class="ib-admin-search">

                    <svg viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M20 20l-4-4"></path>
                    </svg>

                    <input type="search"
                           placeholder="Pesquisar clientes, serviços, marcações..." />

                </div>


                <div class="ib-admin-topbar-actions">

                    @await Component.InvokeAsync("NotificationBell")


                    <span class="ib-admin-topbar-divider"></span>


                    <a asp-controller="Perfil"
                       asp-action="Index"
                       class="ib-admin-profile"
                       title="Meu Perfil"
                       style="text-decoration: none;">

                        @{
    var nome = User.Identity?.Name ?? "A";

    var partesNome = nome
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    var iniciaisPerfil = partesNome.Length switch
    {
        0 => "?",
        1 => partesNome[0].Substring(0, 1).ToUpper(),
        _ => $"{partesNome[0][0]}{partesNome[^1][0]}".ToUpper()
    };
}

<div class="ib-admin-avatar">

    <span class="ib-topbar-avatar-iniciais">
        @iniciaisPerfil
    </span>

    <img src="@Url.Action("Fotografia", "Perfil")"
         alt="@nome"
         class="ib-topbar-avatar-foto"
         onload="this.previousElementSibling.style.display='none';"
         onerror="this.style.display='none';" />

</div>

                        <div class="ib-admin-profile-info">

                            <strong>
                                @User.Identity?.Name
                            </strong>

                            <span>
                                Profissional
                            </span>

                        </div>

                    </a>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ib-admin-logout">

                        @Html.AntiForgeryToken()

                        <button type="submit">
                            Sair
                        </button>

                    </form>

                </div>

            </header>


            <!-- PAGE CONTENT -->

            <main class="ib-admin-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->

            <footer class="ib-admin-footer">

                <span>
                    © @DateTime.Now.Year Infinity Beauty.
                    Todos os direitos reservados.
                </span>

                <div>
                    <a href="#">Política de Privacidade</a>
                    <a href="#">Termos e Condições</a>
                    <a href="#">Suporte</a>
                </div>

            </footer>

        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    
    <script>
            const menuToggle = document.getElementById("adminMenuToggle");

            const sidebar = document.getElementById("adminSidebar");

            if (menuToggle && sidebar) {

                menuToggle.addEventListener("click", function () {

                    sidebar.classList.toggle("open");

                    const isOpen =
                        sidebar.classList.contains("open");

                    menuToggle.setAttribute(
                        "aria-expanded",
                        isOpen
                    );
                });
            }
    </script>
    <script src="~/js/admin-temporario-monitor.js"></script>
<script src="~/js/admin-temporario-monitor.js"></script>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model ProjetoFinalCet105.Web.Models.AlterarPasswordViewModel

@{
    ViewData["Title"] = "Alterar palavra-passe";

    if (User.IsInRole("Admin"))
        Layout = "_AdminLayout";
    else if (User.IsInRole("Funcionario"))
        Layout = "_FuncionarioLayout";
}

<div class="ib-category-form-page">

    <div class="ib-category-form-heading">

        <div>
            <span class="ib-section-eyebrow">
                SEGURANÇA
            </span>

            <h1>Alterar palavra-passe</h1>

            <p>
                Atualize a palavra-passe utilizada para aceder à sua conta.
            </p>
        </div>

        <a asp-controller="Perfil"
           asp-action="Index"
           class="ib-category-back-btn">
            <i class="bi bi-chevron-left"></i>
            Voltar ao perfil
        </a>

    </div>


    <form asp-controller="Perfil"
          asp-action="AlterarPassword"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="ib-category-form-validation">
        </div>


        <div class="ib-category-form-grid">

            <section class="ib-category-form-card">

                <div class="ib-category-form-card-header">

                    <div class="ib-category-form-card-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <div>
                        <span class="ib-section-eyebrow">
                            CREDENCIAIS
                        </span>

                        <h3>Palavra-passe</h3>

                        <p>
                            Introduza a palavra-passe atual
                            e escolha uma nova palavra-passe.
                        </p>
                    </div>

                </div>


                <div class="ib-category-field">

                    <label asp-for="PasswordAtual"></label>

                    <input asp-for="PasswordAtual"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="PasswordAtual"
                          class="ib-field-validation">
                    </span>

                </div>


                <div class="ib-category-field">

                    <label asp-for="NovaPassword"></label>

                    <input asp-for="NovaPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="NovaPassword"
                          class="ib-field-validation">
                    </span>

                </div>


                <div class="ib-category-field">

                    <label asp-for="ConfirmarNovaPassword"></label>

                    <input asp-for="ConfirmarNovaPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmarNovaPassword"
                          class="ib-field-validation">
                    </span>

                </div>

            </section>


            

        </div>


        <div class="ib-category-form-footer">

            <a asp-controller="Perfil"
               asp-action="Index"
               class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit"
                    class="ib-category-save-btn">

                <i class="bi bi-check-lg"></i>
                Alterar palavra-passe

            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
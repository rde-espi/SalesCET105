@model ProjetoFinalCet105.Web.Models.ServicoFormViewModel

@{
    ViewData["Title"] = "Novo Serviço";
    Layout = User.IsInRole("Admin")
    ? "_AdminLayout"
    : "_FuncionarioLayout";
}

<div class="ib-category-form-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">CATÁLOGO</span>
            <h1>Novo Serviço</h1>
            <p>Adicione um novo serviço ao catálogo do Infinity Beauty.</p>
        </div>

        <a asp-controller="GestaoServicos" asp-action="Index" class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar aos serviços
        </a>
    </section>


    <form asp-controller="GestaoServicos" asp-action="Criar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="ib-category-form-validation"></div>

        <div class="ib-category-form-grid">

            <!-- DADOS DO SERVIÇO -->
            <section class="ib-category-form-card">

                <header class="ib-category-form-card-header">
                    <div class="ib-category-form-card-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 3v18"></path>
                            <path d="M3 12h18"></path>
                            <circle cx="12" cy="12" r="8"></circle>
                        </svg>
                    </div>

                    <div>
                        <h2>Dados do serviço</h2>
                        <p>Defina a categoria, preço, duração e informação apresentada ao cliente.</p>
                    </div>
                </header>


                <!-- CATEGORIA -->
                <div class="ib-category-field">
                    <label asp-for="CategoriaId">
                        Categoria <span>*</span>
                    </label>

                    <select asp-for="CategoriaId" class="ib-service-select">
                        <option value="">Selecione uma categoria</option>

                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id">@categoria.Nome</option>
                        }
                    </select>

                    <span asp-validation-for="CategoriaId" class="ib-field-validation"></span>
                </div>


                <!-- NOME -->
                <div class="ib-category-field">
                    <label asp-for="Nome">
                        Nome <span>*</span>
                    </label>

                    <input asp-for="Nome" placeholder="Ex.: Massagem Relaxante" />

                    <span asp-validation-for="Nome" class="ib-field-validation"></span>
                </div>


                <!-- DESCRIÇÃO -->
                <div class="ib-category-field">
                    <div class="ib-category-field-label">
                        <label asp-for="Descricao">Descrição</label>
                        <span>Opcional</span>
                    </div>

                    <textarea asp-for="Descricao" placeholder="Descreva brevemente o serviço..."></textarea>

                    <span asp-validation-for="Descricao" class="ib-field-validation"></span>
                </div>


                <!-- PREÇO + DURAÇÃO -->
                <div class="ib-service-form-row">

                    <div class="ib-category-field">
                        <label asp-for="Preco">
                            Preço <span>*</span>
                        </label>

                        <div class="ib-input-suffix">
                            <input asp-for="Preco" type="number" step="0.01" min="0" placeholder="0,00" />
                            <span>€</span>
                        </div>

                        <span asp-validation-for="Preco" class="ib-field-validation"></span>
                    </div>


                    <div class="ib-category-field">
                        <label asp-for="DuracaoMinutos">
                            Duração <span>*</span>
                        </label>

                        <div class="ib-input-suffix">
                            <input asp-for="DuracaoMinutos" type="number" min="1" placeholder="60" />
                            <span>min</span>
                        </div>

                        <span asp-validation-for="DuracaoMinutos" class="ib-field-validation"></span>
                    </div>

                </div>

            </section>


            <!-- IMAGEM -->
            <section class="ib-category-image-card">

                <header>
                    <h2>Imagem do serviço</h2>
                    <p>Escolha uma imagem representativa para apresentar este serviço no catálogo.</p>
                </header>


                <label class="ib-category-upload" id="imageUpload" for="Imagem">

                    <div class="ib-category-upload-placeholder" id="imagePlaceholder">

                        <div class="ib-category-upload-icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                                <circle cx="9" cy="10" r="2"></circle>
                                <path d="M21 15l-5-5L5 20"></path>
                            </svg>
                        </div>

                        <strong>Selecionar imagem</strong>
                        <span>Clique para escolher uma imagem</span>
                        <small>JPG, PNG ou WEBP</small>

                    </div>

                    <img id="previewImage" class="ib-category-image-preview" alt="Pré-visualização" hidden />

                </label>

                <input asp-for="Imagem" id="Imagem" type="file" accept="image/jpeg,image/png,image/webp" hidden />

                <span asp-validation-for="Imagem" class="ib-field-validation"></span>


                <div class="ib-category-image-note">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 11v5"></path>
                        <path d="M12 8h.01"></path>
                    </svg>

                    <p>
                        Utilize uma imagem de boa qualidade e relacionada com o serviço.
                        Esta imagem será apresentada aos clientes no catálogo.
                    </p>
                </div>

            </section>

        </div>


        <!-- BOTÕES -->
        <footer class="ib-category-form-footer">

            <a asp-controller="GestaoServicos" asp-action="Index" class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit" class="ib-category-save-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>
                Criar serviço
            </button>

        </footer>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const input = document.getElementById("Imagem");
            const upload = document.getElementById("imageUpload");
            const preview = document.getElementById("previewImage");
            const placeholder = document.getElementById("imagePlaceholder");

            if (!input || !upload || !preview || !placeholder) {
                return;
            }

            input.addEventListener("change", function() {

                const file = input.files?.[0];

                if (!file) {
                    preview.hidden = true;
                    preview.removeAttribute("src");
                    placeholder.hidden = false;
                    upload.classList.remove("has-image");
                    return;
                }

                const reader = new FileReader();

                reader.onload = function(event) {
                    preview.src = event.target.result;
                    preview.hidden = false;
                    placeholder.hidden = true;
                    upload.classList.add("has-image");
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}
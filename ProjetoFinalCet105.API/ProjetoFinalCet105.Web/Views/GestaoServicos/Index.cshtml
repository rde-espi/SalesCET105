@model List<ProjetoFinalCet105.Web.Models.ServicoViewModel>

@{
    ViewData["Title"] = "Serviços";
    Layout = "_AdminLayout";

    var totalServicos = Model?.Count ?? 0;
    var servicosDisponiveis = Model?.Count(s => s.Disponivel) ?? 0;
    var servicosIndisponiveis = Model?.Count(s => !s.Disponivel) ?? 0;

    var cultura = new System.Globalization.CultureInfo("pt-PT");
}

<div class="ib-categories-page">

    <!-- CABEÇALHO -->
    <section class="ib-categories-heading">

        <div>
            <span class="ib-section-eyebrow">CATÁLOGO</span>

            <h1>Gestão de Serviços</h1>

            <p>
                Consulte e faça a gestão dos serviços disponíveis
                no Infinity Beauty.
            </p>
        </div>

        <a asp-controller="GestaoServicos"
           asp-action="Criar"
           class="ib-category-create-btn">

            <svg viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14"></path>
            </svg>

            Novo serviço
        </a>

    </section>


    <!-- KPI -->
    <section class="ib-category-kpi-grid">

        <!-- TOTAL -->
        <article class="ib-category-kpi-card">

            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M5 4h14v16H5z"></path>
                    <path d="M8 8h8M8 12h8M8 16h5"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">

                <span>Total de serviços</span>

                <strong id="totalServicos">
                    @totalServicos
                </strong>

                <small>Serviços registados</small>

            </div>

        </article>


        <!-- DISPONÍVEIS -->
        <article class="ib-category-kpi-card">

            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 12l3 3 5-6"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">

                <span>Serviços disponíveis</span>

                <strong id="servicosDisponiveis">
                    @servicosDisponiveis
                </strong>

                <small>Visíveis no catálogo</small>

            </div>

        </article>


        <!-- INDISPONÍVEIS -->
        <article class="ib-category-kpi-card ib-category-kpi-highlight">

            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 8l8 8M16 8l-8 8"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">

                <span>Serviços indisponíveis</span>

                <strong id="servicosIndisponiveis">
                    @servicosIndisponiveis
                </strong>

                <small>Ocultos do catálogo</small>

            </div>

        </article>

    </section>


    <!-- MENSAGEM AJAX -->
    <div id="serviceMessage"
         class="ib-category-alert"
         style="display:none;">
    </div>


    <!-- LISTAGEM -->
    <section class="ib-category-panel">

        <header class="ib-category-panel-header">

            <div>
                <span class="ib-section-eyebrow">
                    SERVIÇOS
                </span>

                <h2>Serviços disponíveis</h2>

                <p>
                    Consulte preços, duração, categoria e estado
                    dos serviços existentes.
                </p>
            </div>


            <div class="ib-category-search">

                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-4-4"></path>
                </svg>

                <input type="search"
                       id="serviceSearch"
                       placeholder="Pesquisar serviço..."
                       autocomplete="off" />

            </div>

        </header>


        @if (Model != null && Model.Any())
        {
            <div class="ib-service-table">

                <!-- CABEÇALHO TABELA -->
                <div class="ib-service-table-header">

                    <span>Imagem</span>

                    <span>Serviço</span>

                    <span>Categoria</span>

                    <span>Preço</span>

                    <span>Duração</span>

                    <span>Estado</span>

                    <span></span>

                </div>


                <div id="serviceRows">

                    @foreach (var servico in Model.OrderBy(s => s.Nome))
                    {
                        <div class="ib-service-admin-row"
                             data-service-row
                             data-service-id="@servico.Id"
                             data-service-active="@servico.Disponivel.ToString().ToLower()"
                             data-search="@($"{servico.Nome} {servico.CategoriaNome} {servico.Descricao}")">


                            <!-- IMAGEM -->
                            <div class="ib-category-image">

                                <img src="@Url.Action("Imagem", "GestaoServicos", new { id = servico.Id })"
                                     alt="@servico.Nome"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <div class="ib-category-image-fallback">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 3c3 3 5 6 5 10a5 5 0 0 1-10 0c0-4 2-7 5-10z"></path>
                                        <path d="M9 14c1 2 5 2 6 0"></path>
                                    </svg>

                                </div>

                            </div>


                            <!-- SERVIÇO -->
                            <div class="ib-category-name">

                                <strong>
                                    @servico.Nome
                                </strong>

                                <small>
                                    Serviço #@servico.Id
                                </small>

                            </div>


                            <!-- CATEGORIA -->
                            <div class="ib-service-category">

                                @if (!string.IsNullOrWhiteSpace(servico.CategoriaNome))
                                {
                                    <span>
                                        @servico.CategoriaNome
                                    </span>
                                }
                                else
                                {
                                    <span class="ib-category-empty">
                                        Sem categoria
                                    </span>
                                }

                            </div>


                            <!-- PREÇO -->
                            <div class="ib-service-price">

                                <strong>
                                    @servico.Preco.ToString("C2", cultura)
                                </strong>

                            </div>


                            <!-- DURAÇÃO -->
                            <div class="ib-service-duration">

                                <span>
                                    @servico.DuracaoMinutos min
                                </span>

                            </div>


                            <!-- ESTADO -->
                            <div>

                                @if (servico.Disponivel)
                                {
                                    <span class="ib-category-status active"
                                          data-service-status>

                                        <i></i>
                                        Disponível

                                    </span>
                                }
                                else
                                {
                                    <span class="ib-category-status inactive"
                                          data-service-status>

                                        <i></i>
                                        Indisponível

                                    </span>
                                }

                            </div>


                            <!-- AÇÕES -->
                            <div class="ib-category-actions">

                                <a asp-controller="GestaoServicos"
                                   asp-action="Editar"
                                   asp-route-id="@servico.Id"
                                   class="ib-category-action-btn"
                                   title="Editar serviço">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M4 20h4l11-11-4-4L4 16v4z"></path>
                                        <path d="M13.5 6.5l4 4"></path>
                                    </svg>

                                </a>


                                <form asp-controller="GestaoServicos"
                                      asp-action="@(servico.Disponivel ? "Desativar" : "Ativar")"
                                      asp-route-id="@servico.Id"
                                      method="post"
                                      data-service-state-form>

                                    @Html.AntiForgeryToken()

                                    @if (servico.Disponivel)
                                    {
                                        <button type="submit"
                                                class="ib-category-action-btn danger"
                                                data-service-state-button
                                                title="Desativar serviço">

                                            <svg viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M6 6l12 12"></path>
                                            </svg>

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="ib-category-action-btn"
                                                data-service-state-button
                                                title="Reativar serviço">

                                            <svg viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M8 12l3 3 5-6"></path>
                                            </svg>

                                        </button>
                                    }

                                </form>

                            </div>

                        </div>
                    }

                </div>


                <!-- SEM RESULTADOS -->
                <div id="serviceNoResults"
                     class="ib-category-no-results"
                     style="display:none;">

                    <svg class="ib-empty-icon" viewBox="0 0 24 24">
                        <circle cx="10" cy="10" r="6"></circle>
                        <path d="M14.5 14.5L20 20"></path>
                        <path d="M7 7l6 6"></path>
                    </svg>

                    <strong>
                        Nenhum serviço encontrado
                    </strong>

                    <p>
                        Experimente pesquisar por outro serviço
                        ou categoria.
                    </p>

                </div>

            </div>
            <div class="ib-pagination" id="paginacaoServicos">

    <div class="ib-pagination-info">
        A mostrar
        <strong id="servicoPaginaInicio">0</strong>–<strong id="servicoPaginaFim">0</strong>
        de
        <strong id="servicoTotalFiltrado">0</strong>
    </div>

    <div class="ib-pagination-controls">

        <label class="ib-pagination-size">
            <span>Itens por página</span>

            <select id="servicosPorPagina">
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
            </select>
        </label>

        <div class="ib-pagination-pages">

            <button type="button"
                    id="servicoPaginaAnterior"
                    class="ib-pagination-arrow"
                    aria-label="Página anterior">‹</button>

            <div id="servicoNumerosPaginas"
                 class="ib-pagination-numbers"></div>

            <button type="button"
                    id="servicoPaginaSeguinte"
                    class="ib-pagination-arrow"
                    aria-label="Página seguinte">›</button>

        </div>

    </div>

</div>
        }
        else
        {
            <div class="ib-category-empty-state">

                <span class="material-symbols-outlined">
                    spa
                </span>

                <h3>
                    Ainda não existem serviços
                </h3>

                <p>
                    Crie o primeiro serviço para começar
                    a construir o catálogo do Infinity Beauty.
                </p>

                <a asp-controller="GestaoServicos"
                   asp-action="Criar"
                   class="ib-category-create-btn">

                    Novo serviço

                </a>

            </div>
        }

    </section>

</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const input =
                document.getElementById("serviceSearch");

            const noResults =
                document.getElementById("serviceNoResults");

            const message =
                document.getElementById("serviceMessage");

                const rows =
    Array.from(
        document.querySelectorAll("[data-service-row]")
    );

const paginacao =
    document.getElementById("paginacaoServicos");

const seletorPagina =
    document.getElementById("servicosPorPagina");

const paginaAnterior =
    document.getElementById("servicoPaginaAnterior");

const paginaSeguinte =
    document.getElementById("servicoPaginaSeguinte");

const numerosPaginas =
    document.getElementById("servicoNumerosPaginas");

const paginaInicio =
    document.getElementById("servicoPaginaInicio");

const paginaFim =
    document.getElementById("servicoPaginaFim");

const totalFiltrado =
    document.getElementById("servicoTotalFiltrado");

let paginaAtual = 1;
let itensPorPagina = 10;
let rowsFiltradas = [...rows];


            function normalizeText(value) {

                return (value || "")
                    .toString()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLocaleLowerCase("pt-PT")
                    .trim();
            }


           function criarPaginas(totalPaginas) {

    numerosPaginas.innerHTML = "";

    if (totalPaginas <= 1)
        return;

    for (let numero = 1; numero <= totalPaginas; numero++) {

        const botao = document.createElement("button");

        botao.type = "button";
        botao.textContent = numero;
        botao.className = "ib-pagination-number";

        if (numero === paginaAtual)
            botao.classList.add("active");

        botao.addEventListener("click", function() {
            paginaAtual = numero;
            mostrarPaginaServicos();
        });

        numerosPaginas.appendChild(botao);
    }
}


function mostrarPaginaServicos() {

    rows.forEach(function(row) {
        row.style.display = "none";
    });

    const totalItens = rowsFiltradas.length;

    const totalPaginas =
        Math.max(
            1,
            Math.ceil(totalItens / itensPorPagina)
        );

    if (paginaAtual > totalPaginas)
        paginaAtual = totalPaginas;

    const primeiro =
        (paginaAtual - 1) * itensPorPagina;

    const ultimo =
        Math.min(
            primeiro + itensPorPagina,
            totalItens
        );

    rowsFiltradas
        .slice(primeiro, ultimo)
        .forEach(function(row) {
            row.style.display = "grid";
        });


    totalFiltrado.textContent = totalItens;

    paginaInicio.textContent =
        totalItens === 0
            ? 0
            : primeiro + 1;

    paginaFim.textContent = ultimo;


    paginaAnterior.disabled =
        paginaAtual <= 1;

    paginaSeguinte.disabled =
        paginaAtual >= totalPaginas;


    criarPaginas(totalPaginas);


    if (noResults) {
        noResults.style.display =
            totalItens === 0
                ? "block"
                : "none";
    }


    if (paginacao) {
        paginacao.style.display =
            rows.length > 10
                ? "flex"
                : "none";
    }
}


function filterServices() {

    if (!input)
        return;

    const searchTerm =
        normalizeText(input.value);

    rowsFiltradas =
        rows.filter(function(row) {

            const searchableText =
                normalizeText(
                    row.getAttribute("data-search")
                );

            return searchTerm === "" ||
                searchableText.includes(searchTerm);
        });

    paginaAtual = 1;

    mostrarPaginaServicos();
}


            function showMessage(text, success) {

                if (!message) {
                    return;
                }

                message.className =
                    "ib-category-alert " +
                    (success ? "success" : "error");

                message.innerHTML =
                    success
                        ? `
                    <svg class="ib-alert-icon" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M8 12l3 3 5-6"></path>
                    </svg>
                    <span>${text}</span>
                  `
                        : `
                    <svg class="ib-alert-icon" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v5"></path>
                        <path d="M12 16h.01"></path>
                    </svg>
                    <span>${text}</span>
                  `;

                message.style.display = "flex";


                window.setTimeout(function() {

                    message.style.display = "none";

                }, 3500);
            }


            function updateCounters() {

                const rows =
                    Array.from(
                        document.querySelectorAll(
                            "[data-service-row]"
                        )
                    );

                const disponiveis =
                    rows.filter(
                        row =>
                            row.dataset.serviceActive === "true"
                    ).length;

                const indisponiveis =
                    rows.length - disponiveis;


                const totalElement =
                    document.getElementById("totalServicos");

                const availableElement =
                    document.getElementById("servicosDisponiveis");

                const unavailableElement =
                    document.getElementById("servicosIndisponiveis");


                if (totalElement) {
                    totalElement.textContent = rows.length;
                }

                if (availableElement) {
                    availableElement.textContent = disponiveis;
                }

                if (unavailableElement) {
                    unavailableElement.textContent = indisponiveis;
                }
            }


            document
                .querySelectorAll("[data-service-state-form]")
                .forEach(function(form) {

                    form.addEventListener(
                        "submit",
                        async function(event) {

                            event.preventDefault();


                            const row =
                                form.closest("[data-service-row]");

                            if (!row) {
                                return;
                            }


                            const isActive =
                                row.dataset.serviceActive === "true";


                            const confirmation =
                                isActive
                                    ? "Pretende desativar este serviço?"
                                    : "Pretende reativar este serviço?";


                            if (!confirm(confirmation)) {
                                return;
                            }


                            const button =
                                form.querySelector(
                                    "[data-service-state-button]"
                                );

                            if (button) {
                                button.disabled = true;
                            }


                            try {

                                const response =
                                    await fetch(
                                        form.action,
                                        {
                                            method: "POST",
                                            body: new FormData(form)
                                        }
                                    );


                                const result =
                                    await response.json();


                                if (!response.ok) {

                                    showMessage(
                                        result.mensagem ||
                                        "Não foi possível alterar o estado do serviço.",
                                        false
                                    );

                                    return;
                                }


                                const newActiveState =
                                    !isActive;


                                row.dataset.serviceActive =
                                    newActiveState
                                        ? "true"
                                        : "false";


                                const status =
                                    row.querySelector(
                                        "[data-service-status]"
                                    );


                                if (status) {

                                    status.className =
                                        "ib-category-status " +
                                        (
                                            newActiveState
                                                ? "active"
                                                : "inactive"
                                        );


                                    status.innerHTML =
                                        "<i></i>" +
                                        (
                                            newActiveState
                                                ? "Disponível"
                                                : "Indisponível"
                                        );
                                }


                                form.action =
                                    newActiveState
                                        ? form.action.replace(
                                            "/Ativar/",
                                            "/Desativar/"
                                        )
                                        : form.action.replace(
                                            "/Desativar/",
                                            "/Ativar/"
                                        );


                                if (button) {

                                    button.className =
                                        newActiveState
                                            ? "ib-category-action-btn danger"
                                            : "ib-category-action-btn";


                                    button.title =
                                        newActiveState
                                            ? "Desativar serviço"
                                            : "Reativar serviço";


                                    button.innerHTML =
                                        newActiveState
                                            ? `
                                                        <svg viewBox="0 0 24 24">
                                                            <circle cx="12" cy="12" r="9"></circle>
                                                            <path d="M6 6l12 12"></path>
                                                        </svg>
                                                      `
                                            : `
                                                        <svg viewBox="0 0 24 24">
                                                            <circle cx="12" cy="12" r="9"></circle>
                                                            <path d="M8 12l3 3 5-6"></path>
                                                        </svg>
                                                      `;
                                }

                                if (seletorPagina) {

    seletorPagina.addEventListener(
        "change",
        function() {

            itensPorPagina =
                parseInt(this.value);

            paginaAtual = 1;

            mostrarPaginaServicos();
        }
    );
}


if (paginaAnterior) {

    paginaAnterior.addEventListener(
        "click",
        function() {

            if (paginaAtual > 1) {
                paginaAtual--;
                mostrarPaginaServicos();
            }
        }
    );
}


if (paginaSeguinte) {

    paginaSeguinte.addEventListener(
        "click",
        function() {

            const totalPaginas =
                Math.ceil(
                    rowsFiltradas.length /
                    itensPorPagina
                );

            if (paginaAtual < totalPaginas) {
                paginaAtual++;
                mostrarPaginaServicos();
            }
        }
    );
}
                                updateCounters();

                                showMessage(
                                    result.mensagem ||
                                    "Estado do serviço alterado com sucesso.",
                                    true
                                );

                            }
                            catch {

                                showMessage(
                                    "Ocorreu um erro ao comunicar com o servidor.",
                                    false
                                );
                            }
                            finally {

                                if (button) {
                                    button.disabled = false;
                                }
                            }
                        }
                    );
                });


            if (input) {

                input.addEventListener(
                    "input",
                    filterServices
                );

                filterServices();
            }


            updateCounters();
        });
    </script>
}
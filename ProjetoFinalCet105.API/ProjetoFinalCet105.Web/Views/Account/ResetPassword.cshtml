@model ProjetoFinalCet105.Web.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Redefinir palavra-passe";
    Layout = "_PublicLayout";
}

<section class="ib-login-page">

    <div class="ib-login-container">

        <!-- FORMULÁRIO -->
        <div class="ib-login-panel">

            <div class="ib-login-heading">
                <span>SEGURANÇA DA CONTA</span>

                <h1>Redefinir palavra-passe</h1>

                <p>
                    Escolha uma nova palavra-passe para a sua conta
                    e confirme-a antes de continuar.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post"
                  class="ib-login-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="ib-login-error"></div>

                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="ib-form-group">

                    <label asp-for="NovaPassword">
                        Nova palavra-passe
                    </label>

                    <input asp-for="NovaPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Introduza a nova palavra-passe" />

                    <span asp-validation-for="NovaPassword"
                          class="ib-field-error"></span>

                </div>

                <div class="ib-form-group">

                    <label asp-for="ConfirmarPassword">
                        Confirmar palavra-passe
                    </label>

                    <input asp-for="ConfirmarPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Repita a nova palavra-passe" />

                    <span asp-validation-for="ConfirmarPassword"
                          class="ib-field-error"></span>

                </div>

                <button type="submit"
                        class="ib-login-submit">
                    Alterar palavra-passe
                </button>

            </form>

            <div class="ib-login-register">
                <span>Não pretende alterar agora?</span>

                <a asp-controller="Account"
                   asp-action="Login">
                    Voltar ao login
                </a>
            </div>

        </div>

        <!-- IMAGEM -->
        <div class="ib-login-image">

            <div class="ib-login-image-overlay"></div>

            <div class="ib-login-image-copy">

                <span>INFINITY BEAUTY</span>

                <h2>
                    Beleza hoje,<br />
                    bem-estar sempre.
                </h2>

                <p>
                    Cuidamos de cada detalhe para que a sua
                    experiência seja única.
                </p>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
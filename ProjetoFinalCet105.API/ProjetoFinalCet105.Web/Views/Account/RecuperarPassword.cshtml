@model ProjetoFinalCet105.Web.Models.RecuperarPasswordViewModel

@{
    ViewData["Title"] = "Recuperar palavra-passe";
    Layout = "_PublicLayout";
}

<section class="ib-login-page">

    <div class="ib-login-container">

        <!-- FORMULÁRIO -->
        <div class="ib-login-panel">

            <div class="ib-login-heading">
                <span>RECUPERAÇÃO DE CONTA</span>

                <h1>Recuperar palavra-passe</h1>

                <p>
                    Introduza o email associado à sua conta.
                    Enviaremos as instruções para definir
                    uma nova palavra-passe.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="RecuperarPassword"
                  method="post"
                  class="ib-login-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="ib-login-error"></div>

                <div class="ib-form-group">

                    <label asp-for="Email">Email</label>

                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           placeholder="exemplo@email.com" />

                    <span asp-validation-for="Email"
                          class="ib-field-error"></span>

                </div>

                <button type="submit"
                        class="ib-login-submit">
                    Enviar instruções
                </button>

            </form>

            <div class="ib-login-register">
                <span>Lembrou-se da palavra-passe?</span>

                <a asp-controller="Account"
                   asp-action="Login">
                    Voltar ao login
                </a>
            </div>

        </div>

        <!-- IMAGEM -->
        <div class="ib-login-image">

            <div class="ib-login-image-overlay"></div>

            <div class="ib-login-image-copy">

                <span>INFINITY BEAUTY</span>

                <h2>
                    Beleza hoje,<br />
                    bem-estar sempre.
                </h2>

                <p>
                    Cuidamos de cada detalhe para que a sua
                    experiência seja única.
                </p>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model ProjetoFinalCet105.Web.Models.EditarMarcacaoViewModel

@{
    ViewData["Title"] = "Alterar Marcação";
    Layout = "_FuncionarioLayout";
}

<div class="ib-categories-page">

    <div class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">MINHA AGENDA</span>
            <h1>Alterar Marcação</h1>
            <p>Altere o serviço, data, hora ou observações da marcação.</p>
        </div>

        <a asp-controller="MarcacoesFuncionario"
           asp-action="Detalhes"
           asp-route-id="@Model.Id"
           class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar à marcação
        </a>
    </div>

    <div class="ib-category-panel">

        <div class="ib-category-panel-header">
            <div>
                <span class="ib-section-eyebrow">MARCAÇÃO #@Model.Id</span>
                <h2>Dados da marcação</h2>
            </div>
        </div>

        <form asp-controller="MarcacoesFuncionario"
              asp-action="Editar"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="FuncionarioId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="ib-booking-edit-context">

                <div>
                    <span>Cliente</span>
                    <strong>@Model.ClienteNome</strong>
                </div>

                <div>
                    <span>Profissional</span>
                    <strong>@Model.FuncionarioNome</strong>
                </div>

            </div>

            <div class="ib-booking-edit-grid">

                <div class="ib-category-field">
                    <label asp-for="ServicoId">
                        Serviço <span>*</span>
                    </label>

                    <select asp-for="ServicoId"
                            class="ib-service-select">

                        @foreach (var servico in Model.Servicos)
                        {
                            <option value="@servico.ServicoId">
                                @servico.ServicoNome
                            </option>
                        }

                    </select>

                    <span asp-validation-for="ServicoId"
                          class="ib-field-validation"></span>
                </div>

                <div class="ib-category-field">
                    <label>Data <span>*</span></label>

                    <div class="ib-datepicker" id="ibDatepicker">

                        <button type="button"
                                class="ib-datepicker-trigger"
                                id="ibDatepickerTrigger">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                <path d="M16 3v4M8 3v4M3 10h18"></path>
                            </svg>

                            <span id="ibDatepickerText">
                                @Model.DataHoraInicio.ToString("dd/MM/yyyy")
                            </span>

                            <svg class="ib-datepicker-chevron"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>

                        <div class="ib-datepicker-popup"
                             id="ibDatepickerPopup">

                            <div class="ib-datepicker-header">

                                <strong id="ibCalendarMonth"></strong>

                                <div class="ib-datepicker-nav">
                                    <button type="button"
                                            id="ibCalendarPrev"
                                            aria-label="Mês anterior">
                                        <svg viewBox="0 0 24 24">
                                            <path d="m15 18-6-6 6-6"></path>
                                        </svg>
                                    </button>

                                    <button type="button"
                                            id="ibCalendarNext"
                                            aria-label="Mês seguinte">
                                        <svg viewBox="0 0 24 24">
                                            <path d="m9 18 6-6-6-6"></path>
                                        </svg>
                                    </button>
                                </div>

                            </div>

                            <div class="ib-datepicker-weekdays">
                                <span>D</span>
                                <span>S</span>
                                <span>T</span>
                                <span>Q</span>
                                <span>Q</span>
                                <span>S</span>
                                <span>S</span>
                            </div>

                            <div class="ib-datepicker-days"
                                 id="ibCalendarDays">
                            </div>

                            <div class="ib-datepicker-footer">
                                <button type="button"
                                        id="ibCalendarToday">
                                    Hoje
                                </button>
                            </div>

                        </div>
                    </div>

                    <input type="hidden"
                           id="dataMarcacao"
                           value="@Model.DataHoraInicio.ToString("yyyy-MM-dd")" />

                    <input asp-for="DataHoraInicio"
                           type="hidden"
                           id="DataHoraInicio" />

                    <span asp-validation-for="DataHoraInicio"
                          class="ib-field-validation"></span>
                </div>

                <div class="ib-category-field">
                    <label>Horários disponíveis <span>*</span></label>

                    <div id="horariosDisponiveis" class="ib-booking-slots">
                        <div class="ib-booking-slots-loading">
                            A consultar horários disponíveis...
                        </div>
                    </div>

                    <div id="horarioErro"
                         class="ib-field-validation"
                         style="display:none;">
                        Selecione um horário disponível.
                    </div>
                </div>

            </div>

            <div class="ib-category-field">
                <div class="ib-category-field-label">
                    <label asp-for="Observacoes">
                        Observações
                    </label>

                    <span>Opcional</span>
                </div>

                <textarea asp-for="Observacoes"
                          rows="4"
                          maxlength="500"
                          placeholder="Observações da marcação..."></textarea>

                <span asp-validation-for="Observacoes"
                      class="ib-field-validation"></span>
            </div>

            <div class="ib-booking-edit-actions">

                <a asp-controller="MarcacoesFuncionario"
                   asp-action="Detalhes"
                   asp-route-id="@Model.Id"
                   class="ib-booking-secondary-btn">
                    Cancelar
                </a>

                <button type="submit"
                        class="ib-booking-confirm-btn">
                    Guardar alterações
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ELEMENTOS DA PÁGINA

            const funcionarioId = document.getElementById("FuncionarioId");
            const servico = document.getElementById("ServicoId");
            const data = document.getElementById("dataMarcacao");
            const dataHoraInicio = document.getElementById("DataHoraInicio");
            const container = document.getElementById("horariosDisponiveis");
            const horarioErro = document.getElementById("horarioErro");
            const dataHoraOriginal = dataHoraInicio.value;

let horarioOriginal = "";

if (dataHoraOriginal) {
    const original = new Date(dataHoraOriginal);

    if (!isNaN(original.getTime())) {
        horarioOriginal =
            String(original.getHours()).padStart(2, "0") +
            ":" +
            String(original.getMinutes()).padStart(2, "0");
    }
}

            // ELEMENTOS DO CALENDÁRIO

            const datepicker = document.getElementById("ibDatepicker");
            const datepickerTrigger = document.getElementById("ibDatepickerTrigger");
            const datepickerText = document.getElementById("ibDatepickerText");
            const calendarMonth = document.getElementById("ibCalendarMonth");
            const calendarDays = document.getElementById("ibCalendarDays");
            const calendarPrev = document.getElementById("ibCalendarPrev");
            const calendarNext = document.getElementById("ibCalendarNext");
            const calendarToday = document.getElementById("ibCalendarToday");

            const hoje = new Date();
            hoje.setHours(0, 0, 0, 0);

            let dataSelecionada = data.value
                ? new Date(data.value + "T00:00:00")
                : new Date();

            if (isNaN(dataSelecionada.getTime())) {
                dataSelecionada = new Date();
            }

            let mesVisivel;

            if (dataSelecionada < hoje) {
                mesVisivel = new Date(
                    hoje.getFullYear(),
                    hoje.getMonth(),
                    1
                );
            }
            else {
                mesVisivel = new Date(
                    dataSelecionada.getFullYear(),
                    dataSelecionada.getMonth(),
                    1
                );
            }

            // FUNÇÕES AUXILIARES DO CALENDÁRIO

            function mesmaData(a, b) {
                return a.getFullYear() === b.getFullYear() &&
                       a.getMonth() === b.getMonth() &&
                       a.getDate() === b.getDate();
            }

            function formatarDataInput(date) {
                const ano = date.getFullYear();
                const mes = String(date.getMonth() + 1).padStart(2, "0");
                const dia = String(date.getDate()).padStart(2, "0");

                return `${ano}-${mes}-${dia}`;
            }

            function formatarDataVisual(date) {
                return date.toLocaleDateString("pt-PT", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric"
                });
            }

            // DESENHAR CALENDÁRIO

            function desenharCalendario() {

                calendarDays.innerHTML = "";

                const mesAtual = new Date(
                    hoje.getFullYear(),
                    hoje.getMonth(),
                    1
                );

                calendarPrev.disabled = mesVisivel <= mesAtual;

                calendarMonth.textContent =
                    mesVisivel.toLocaleDateString("pt-PT", {
                        month: "long",
                        year: "numeric"
                    });

                const primeiroDia = new Date(
                    mesVisivel.getFullYear(),
                    mesVisivel.getMonth(),
                    1
                );

                const ultimoDia = new Date(
                    mesVisivel.getFullYear(),
                    mesVisivel.getMonth() + 1,
                    0
                );

                for (let i = 0; i < primeiroDia.getDay(); i++) {
                    const vazio = document.createElement("span");
                    vazio.className = "ib-datepicker-empty";
                    calendarDays.appendChild(vazio);
                }

                for (let dia = 1; dia <= ultimoDia.getDate(); dia++) {

                    const dataDia = new Date(
                        mesVisivel.getFullYear(),
                        mesVisivel.getMonth(),
                        dia
                    );

                    const botao = document.createElement("button");

                    botao.type = "button";
                    botao.className = "ib-datepicker-day";
                    botao.textContent = dia;

                    if (dataDia < hoje) {
                        botao.disabled = true;
                    }

                    if (mesmaData(dataDia, hoje)) {
                        botao.classList.add("today");
                    }

                    if (
                        dataSelecionada >= hoje &&
                        mesmaData(dataDia, dataSelecionada)
                    ) {
                        botao.classList.add("selected");
                    }

                    botao.addEventListener("click", function () {

                        dataSelecionada = new Date(dataDia);

                        data.value =
                            formatarDataInput(dataSelecionada);

                        datepickerText.textContent =
                            formatarDataVisual(dataSelecionada);

                        datepicker.classList.remove("open");

                        desenharCalendario();
                        carregarHorarios();
                    });

                    calendarDays.appendChild(botao);
                }
            }

            // EVENTOS DO CALENDÁRIO

            datepickerTrigger.addEventListener("click", function (event) {

                event.stopPropagation();

                datepicker.classList.toggle("open");

                if (datepicker.classList.contains("open")) {
                    desenharCalendario();
                }
            });

            calendarPrev.addEventListener("click", function (event) {

                event.stopPropagation();

                mesVisivel = new Date(
                    mesVisivel.getFullYear(),
                    mesVisivel.getMonth() - 1,
                    1
                );

                desenharCalendario();
            });

            calendarNext.addEventListener("click", function (event) {

                event.stopPropagation();

                mesVisivel = new Date(
                    mesVisivel.getFullYear(),
                    mesVisivel.getMonth() + 1,
                    1
                );

                desenharCalendario();
            });

            calendarToday.addEventListener("click", function (event) {

                event.stopPropagation();

                dataSelecionada = new Date(hoje);

                mesVisivel = new Date(
                    hoje.getFullYear(),
                    hoje.getMonth(),
                    1
                );

                data.value =
                    formatarDataInput(dataSelecionada);

                datepickerText.textContent =
                    formatarDataVisual(dataSelecionada);

                datepicker.classList.remove("open");

                desenharCalendario();
                carregarHorarios();
            });

            document.addEventListener("click", function (event) {

                if (!datepicker.contains(event.target)) {
                    datepicker.classList.remove("open");
                }
            });

            // HORÁRIOS DISPONÍVEIS

            async function carregarHorarios() {

                const funcionario = funcionarioId.value;
                const servicoId = servico.value;
                const dataEscolhida = data.value;

                horarioErro.style.display = "none";

                if (!funcionario || !servicoId || !dataEscolhida) {

                    container.innerHTML =
                        '<div class="ib-booking-slots-empty">' +
                        'Selecione o serviço e a data.' +
                        '</div>';

                    return;
                }

                container.innerHTML =
                    '<div class="ib-booking-slots-loading">' +
                    'A consultar horários disponíveis...' +
                    '</div>';

                try {

                    const url =
                        '@Url.Action("HorariosDisponiveis", "MarcacoesFuncionario")' +
                        '?funcionarioId=' + encodeURIComponent(funcionario) +
                        '&servicoId=' + encodeURIComponent(servicoId) +
                        '&data=' + encodeURIComponent(dataEscolhida);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error(
                            "Erro ao consultar disponibilidade."
                        );
                    }

                    const horarios = await response.json();

                    if (!horarios || horarios.length === 0) {

                        container.innerHTML =
                            '<div class="ib-booking-slots-empty">' +
                            'Sem horários disponíveis para esta data.' +
                            '</div>';

                        return;
                    }

                    container.innerHTML = "";

                    horarios.forEach(function (horario) {

                        const dataHora = new Date(horario);

                        const horas =
                            String(dataHora.getHours()).padStart(2, "0") +
                            ":" +
                            String(dataHora.getMinutes()).padStart(2, "0");

                        const botao =
                            document.createElement("button");

                        botao.type = "button";
                        botao.className = "ib-booking-slot";
                        botao.textContent = horas;

                        const dataOriginal =
    dataHoraOriginal
        ? new Date(dataHoraOriginal)
        : null;

const mesmaDataOriginal =
    dataOriginal &&
    !isNaN(dataOriginal.getTime()) &&
    dataOriginal.getFullYear() === dataSelecionada.getFullYear() &&
    dataOriginal.getMonth() === dataSelecionada.getMonth() &&
    dataOriginal.getDate() === dataSelecionada.getDate();

if (mesmaDataOriginal && horas === horarioOriginal) {
    botao.classList.add("selected");
}

                        botao.addEventListener("click", function () {

                            document
                                .querySelectorAll(".ib-booking-slot")
                                .forEach(function (b) {
                                    b.classList.remove("selected");
                                });

                            botao.classList.add("selected");

                            dataHoraInicio.value =
                                dataEscolhida + "T" + horas;

                            horarioErro.style.display = "none";
                        });

                        container.appendChild(botao);
                    });
                }
                catch (error) {

                    console.error(error);

                    container.innerHTML =
                        '<div class="ib-booking-slots-empty">' +
                        'Não foi possível consultar os horários disponíveis.' +
                        '</div>';
                }
            }

            // ALTERAÇÕES SERVIÇO / DATA

            servico.addEventListener(
                "change",
                carregarHorarios
            );


            const form = dataHoraInicio.closest("form");

            form.addEventListener("submit", function (event) {

                if (!dataHoraInicio.value) {

                    event.preventDefault();

                    horarioErro.style.display = "block";
                }
            });
            desenharCalendario();
            carregarHorarios();
        });
    </script>
}

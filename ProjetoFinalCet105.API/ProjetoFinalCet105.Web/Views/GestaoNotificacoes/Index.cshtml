@model List<ProjetoFinalCet105.Web.Models.NotificacaoDashboardViewModel>

@{
    Layout = User.IsInRole("Admin")
        ? "_AdminLayout"
        : User.IsInRole("Cliente")
            ? "_ClienteLayout"
            : "_FuncionarioLayout";

    var total = Model?.Count ?? 0;
    var naoLidas = Model?.Count(n => !n.Lida) ?? 0;
    var lidas = Model?.Count(n => n.Lida) ?? 0;
}

<div class="ib-categories-page">

    <!-- CABEÇALHO -->
    <div class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">CENTRAL DE ATIVIDADE</span>
            <h1>Notificações</h1>
            <p>Acompanhe os avisos e atualizações associados à sua conta.</p>
        </div>

        @if (naoLidas > 0)
        {
            <form asp-controller="GestaoNotificacoes"
                  asp-action="MarcarTodasComoLidas"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="ib-fatura-emitir-btn">
                    Marcar todas como lidas
                </button>
            </form>
        }
@if (Model != null && Model.Any())
{
    <form asp-controller="GestaoNotificacoes"
          asp-action="EliminarTodas"
          method="post"
          onsubmit="return confirm('Tem a certeza de que pretende eliminar todas as suas notificações? Esta ação não pode ser anulada.');">
        @Html.AntiForgeryToken()

        <button type="submit"
                class="ib-notification-delete-all">
            <svg width="16"
     height="16"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true">
    <path d="M3 6h18" />
    <path d="M8 6V4h8v2" />
    <path d="M19 6l-1 14H6L5 6" />
    <path d="M10 11v5" />
    <path d="M14 11v5" />
</svg>
<span>Eliminar todas</span>
        </button>
    </form>
}
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- KPIs -->
    <div class="ib-category-kpi-grid">

        <div class="ib-category-kpi-card">
            <span>Total</span>
            <strong>@total</strong>
            <small>Notificações recebidas</small>
        </div>

        <div class="ib-category-kpi-card ib-category-kpi-highlight">
            <span>Não lidas</span>
            <strong>@naoLidas</strong>
            <small>Por consultar</small>
        </div>

        <div class="ib-category-kpi-card">
            <span>Lidas</span>
            <strong>@lidas</strong>
            <small>Já consultadas</small>
        </div>

    </div>

    <!-- PAINEL -->
    <div class="ib-category-panel">

        <div class="ib-category-panel-header">

            <div>
                <span class="ib-section-eyebrow">ATIVIDADE</span>
                <h2>As minhas notificações</h2>
                <p>Consulte o histórico de notificações da sua conta.</p>
            </div>

            <div class="ib-notification-filters">

                <div class="ib-category-search">
                    <input type="text"
                           id="pesquisaNotificacoes"
                           placeholder="Pesquisar notificações..." />
                </div>

                <select id="filtroNotificacoes"
                        class="ib-feedback-filter-select">
                    <option value="">Todas</option>
                    <option value="nao-lida">Não lidas</option>
                    <option value="lida">Lidas</option>
                </select>

            </div>

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="ib-mensagens-empty">

                <div class="ib-mensagens-empty-icon">
                    <svg viewBox="0 0 24 24"
                         width="27"
                         height="27"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                        <path d="M10 21h4" />
                    </svg>
                </div>

                <strong>Sem notificações</strong>
                <span>Não existem notificações para apresentar.</span>

            </div>
        }
        else
        {
            <div class="ib-notification-list">

                @foreach (var notificacao in Model.OrderByDescending(n => n.DataCriacao))
                {
                    <div class="ib-notification-item @(notificacao.Lida ? "lida" : "nao-lida")"
                         data-status="@(notificacao.Lida ? "lida" : "nao-lida")"
                         data-search="@($"{notificacao.Titulo} {notificacao.Mensagem}".ToLower())">

                        <!-- ÍCONE -->
                        <div class="ib-notification-icon">

                            <svg viewBox="0 0 24 24"
                                 width="20"
                                 height="20"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                <path d="M10 21h4" />
                            </svg>

                        </div>

                        <!-- CONTEÚDO -->
                        <div class="ib-notification-content">

                            <div class="ib-notification-title">

                                <strong>@notificacao.Titulo</strong>

                                @if (!notificacao.Lida)
                                {
                                    <span class="ib-notification-new">
                                        Nova
                                    </span>
                                }

                            </div>

                            <p>@notificacao.Mensagem</p>

                            <div class="ib-notification-date">
                                @notificacao.DataCriacao.ToString("dd/MM/yyyy · HH:mm")
                            </div>

                        </div>

                        <!-- AÇÃO -->
                        <div class="ib-notification-actions">

                            @if (!notificacao.Lida)
                            {
                                <form asp-controller="GestaoNotificacoes"
                                      asp-action="MarcarComoLida"
                                      asp-route-id="@notificacao.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="ib-notification-read-btn"
                                            title="Marcar como lida">

                                        <svg viewBox="0 0 24 24"
                                             width="17"
                                             height="17"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8">
                                            <path d="M4 12l5 5L20 6" />
                                        </svg>

                                        Marcar como lida
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="ib-notification-read-label">

                                    <svg viewBox="0 0 24 24"
                                         width="15"
                                         height="15"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8">
                                        <path d="M4 12l5 5L20 6" />
                                    </svg>

                                    Lida
                                </span>
                            }

                        <form asp-controller="GestaoNotificacoes" asp-action="Eliminar" method="post" onsubmit="return confirm('Tem a certeza de que pretende eliminar esta notificação?');">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@notificacao.Id" />

    <button type="submit"
        class="ib-notification-delete"
        title="Eliminar notificação"
        aria-label="Eliminar notificação">
    <svg width="15"
         height="15"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <path d="M3 6h18" />
        <path d="M8 6V4h8v2" />
        <path d="M19 6l-1 14H6L5 6" />
        <path d="M10 11v5" />
        <path d="M14 11v5" />
    </svg>
</button>
</form>

                        </div>

                    </div>
                }

            </div>

            <div id="semResultadosNotificacoes"
                 class="ib-mensagens-empty"
                 style="display:none;">

                <strong>Nenhuma notificação encontrada</strong>
                <span>Não existem resultados para os filtros selecionados.</span>

            </div>

                        <div id="paginacaoNotificacoes"
                 class="ib-pagination">

                <div class="ib-pagination-info">
                    A mostrar
                    <strong id="notificacoesInicio">0</strong>–<strong id="notificacoesFim">0</strong>
                    de
                    <strong id="notificacoesTotal">0</strong>
                </div>

                <div class="ib-pagination-controls">

                    <label for="notificacoesPorPagina">
                        Itens por página
                    </label>

                    <select id="notificacoesPorPagina"
                            class="ib-pagination-select">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                    </select>

                    <div id="notificacoesPaginas"
                         class="ib-pagination-pages">
                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const pesquisa =
            document.getElementById("pesquisaNotificacoes");

        const filtro =
            document.getElementById("filtroNotificacoes");

        const notificacoes =
            Array.from(
                document.querySelectorAll(".ib-notification-item")
            );

        const semResultados =
            document.getElementById("semResultadosNotificacoes");

        const paginacao =
            document.getElementById("paginacaoNotificacoes");

        const itensPorPaginaSelect =
            document.getElementById("notificacoesPorPagina");

        const paginasContainer =
            document.getElementById("notificacoesPaginas");

        const inicioElement =
            document.getElementById("notificacoesInicio");

        const fimElement =
            document.getElementById("notificacoesFim");

        const totalElement =
            document.getElementById("notificacoesTotal");

        let paginaAtual = 1;


        function obterFiltradas() {

            const termo =
                pesquisa
                    ? pesquisa.value.toLowerCase().trim()
                    : "";

            const estado =
                filtro
                    ? filtro.value
                    : "";

            return notificacoes.filter(function (notificacao) {

                const texto =
                    notificacao.dataset.search || "";

                const status =
                    notificacao.dataset.status || "";

                const correspondePesquisa =
                    !termo || texto.includes(termo);

                const correspondeEstado =
                    !estado || status === estado;

                return correspondePesquisa &&
                       correspondeEstado;
            });
        }


        function criarBotaoPagina(texto, pagina, ativo, desativado) {

            const button =
                document.createElement("button");

            button.type = "button";
            button.textContent = texto;
            button.className = "ib-pagination-btn";

            if (ativo) {
                button.classList.add("active");
            }

            button.disabled = desativado;

            button.addEventListener("click", function () {

                if (desativado)
                    return;

                paginaAtual = pagina;
                atualizar();
            });

            return button;
        }


        function atualizar() {

            const filtradas =
                obterFiltradas();

            const total =
                filtradas.length;

            const itensPorPagina =
                Number(itensPorPaginaSelect?.value || 10);

            const totalPaginas =
                Math.max(
                    1,
                    Math.ceil(total / itensPorPagina)
                );

            if (paginaAtual > totalPaginas) {
                paginaAtual = totalPaginas;
            }

            if (paginaAtual < 1) {
                paginaAtual = 1;
            }


            /* Esconde todas primeiro */
            notificacoes.forEach(function (notificacao) {
                notificacao.style.display = "none";
            });


            const inicio =
                (paginaAtual - 1) * itensPorPagina;

            const fim =
                Math.min(
                    inicio + itensPorPagina,
                    total
                );


            /* Mostra apenas os itens da página atual */
            filtradas
                .slice(inicio, fim)
                .forEach(function (notificacao) {
                    notificacao.style.display = "";
                });


            /* Estado sem resultados */
            if (semResultados) {
                semResultados.style.display =
                    total === 0
                        ? "flex"
                        : "none";
            }


            /* Informação "A mostrar X–Y de Z" */
            if (inicioElement) {
                inicioElement.textContent =
                    total === 0
                        ? "0"
                        : (inicio + 1).toString();
            }

            if (fimElement) {
                fimElement.textContent =
                    fim.toString();
            }

            if (totalElement) {
                totalElement.textContent =
                    total.toString();
            }


            /* Paginação só aparece quando necessária */
            if (paginacao) {
                paginacao.style.display =
                    total > itensPorPagina
                        ? "flex"
                        : "none";
            }


            /* Botões */
            if (!paginasContainer)
                return;

            paginasContainer.innerHTML = "";


            if (total <= itensPorPagina)
                return;


            /* Anterior */
            paginasContainer.appendChild(
                criarBotaoPagina(
                    "‹",
                    paginaAtual - 1,
                    false,
                    paginaAtual === 1
                )
            );


            /* Números das páginas */
            for (let pagina = 1;
                 pagina <= totalPaginas;
                 pagina++) {

                paginasContainer.appendChild(
                    criarBotaoPagina(
                        pagina.toString(),
                        pagina,
                        pagina === paginaAtual,
                        false
                    )
                );
            }


            /* Seguinte */
            paginasContainer.appendChild(
                criarBotaoPagina(
                    "›",
                    paginaAtual + 1,
                    false,
                    paginaAtual === totalPaginas
                )
            );
        }


        if (pesquisa) {
            pesquisa.addEventListener("input", function () {
                paginaAtual = 1;
                atualizar();
            });
        }


        if (filtro) {
            filtro.addEventListener("change", function () {
                paginaAtual = 1;
                atualizar();
            });
        }


        if (itensPorPaginaSelect) {
            itensPorPaginaSelect.addEventListener(
                "change",
                function () {
                    paginaAtual = 1;
                    atualizar();
                }
            );
        }


        atualizar();

    });
</script>
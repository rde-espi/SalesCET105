@model ProjetoFinalCet105.Web.Models.CompetenciaFormViewModel

@{
    ViewData["Title"] = "Editar Competência";
    Layout = "_AdminLayout";
}

<div class="ib-category-form-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">EQUIPA</span>
            <h1>Editar Competência</h1>
            <p>Atualize os dados e o estado da competência profissional.</p>
        </div>

        <a asp-controller="GestaoCompetencias"
           asp-action="Index"
           class="ib-category-back-btn">

            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>

            Voltar às competências
        </a>
    </section>


    <form asp-controller="GestaoCompetencias"
          asp-action="Editar"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="ib-category-form-validation"></div>


        <div class="ib-category-form-grid">

            <section class="ib-category-form-card">

                <header class="ib-category-form-card-header">

                    <div class="ib-category-form-card-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 20h4L19 9l-4-4L4 16v4z"></path>
                            <path d="M13.5 6.5l4 4"></path>
                        </svg>
                    </div>

                    <div>
                        <span class="ib-section-eyebrow">INFORMAÇÃO</span>
                        <h2>Dados da competência</h2>
                        <p>Edite o nome e a descrição da competência.</p>
                    </div>

                </header>


                <div class="ib-category-field">
                    <label asp-for="Nome">
                        Nome <span>*</span>
                    </label>

                    <input asp-for="Nome" />

                    <span asp-validation-for="Nome"
                          class="ib-field-validation"></span>
                </div>


                <div class="ib-category-field">

                    <div class="ib-category-field-label">
                        <label asp-for="Descricao">Descrição</label>
                        <span>Opcional</span>
                    </div>

                    <textarea asp-for="Descricao"
                              rows="6"></textarea>

                    <span asp-validation-for="Descricao"
                          class="ib-field-validation"></span>
                </div>

            </section>


            <section class="ib-category-image-card">

                <header>
                    <span class="ib-section-eyebrow">ESTADO</span>
                    <h2>Disponibilidade</h2>
                    <p>Controle a utilização desta competência no sistema.</p>
                </header>


                <div class="ib-employee-option">

                    <div class="ib-employee-option-content">
                        <strong>Competência ativa</strong>

                        <span>
                            Quando ativa, pode ser associada aos profissionais.
                        </span>
                    </div>

                    <label class="ib-employee-switch">
                        <input asp-for="Ativa" />
                        <span class="ib-employee-switch-slider"></span>
                    </label>

                </div>


                @if (Model.Ativa)
                {
                    <div class="ib-employee-edit-info">

                        <div class="ib-employee-edit-info-icon">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 8v5"></path>
                                <path d="M12 16h.01"></path>
                            </svg>
                        </div>

                        <div>
                            <strong>Desativar competência</strong>
                            <p>
                                A competência deixa de estar disponível para
                                novas associações.
                            </p>
                        </div>

                    </div>
                }

            </section>

        </div>


        <footer class="ib-category-form-footer">

            <a asp-controller="GestaoCompetencias"
               asp-action="Index"
               class="ib-category-cancel-btn">
                Cancelar
            </a>

            <button type="submit"
                    class="ib-category-save-btn">

                <svg viewBox="0 0 24 24">
                    <path d="M5 12l4 4L19 6"></path>
                </svg>

                Guardar alterações
            </button>

        </footer>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
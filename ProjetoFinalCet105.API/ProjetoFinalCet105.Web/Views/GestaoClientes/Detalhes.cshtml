@model ProjetoFinalCet105.Web.Models.ClienteDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes do Cliente";
    Layout = "_AdminLayout";

    var cliente = Model.Cliente;
    var marcacoes = Model.Marcacoes ?? new();

    var iniciais = string.Join("",
        (cliente.NomeCompleto ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(n => n[0].ToString().ToUpper()));

    if (string.IsNullOrWhiteSpace(iniciais))
        iniciais = "CL";

    var agora = DateTime.Now;

    var proximaMarcacao = marcacoes
        .Where(m =>
            m.DataHoraInicio >= agora &&
            !string.Equals(m.EstadoMarcacaoNome, "Cancelada",
                StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(m.EstadoMarcacaoNome, "Não Compareceu",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(m => m.DataHoraInicio)
        .FirstOrDefault();

    var ultimaVisita = marcacoes
        .Where(m =>
            string.Equals(m.EstadoMarcacaoNome, "Concluida",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(m.EstadoMarcacaoNome, "Concluída",
                StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(m => m.DataHoraInicio)
        .FirstOrDefault();
}

<div class="ib-categories-page">

    <section class="ib-category-form-heading">
        <div>
            <span class="ib-section-eyebrow">CLIENTES</span>
            <h1>Detalhes do Cliente</h1>
            <p>Consulte os dados, marcações e histórico do cliente.</p>
        </div>

        <a asp-controller="GestaoClientes"
           asp-action="Index"
           class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar aos clientes
        </a>
    </section>


    <!-- PERFIL DO CLIENTE -->
    <section class="ib-category-panel">

        <div class="ib-client-profile">

            <div class="ib-client-profile-identity">

                <div class="ib-employee-avatar ib-client-profile-avatar">
                    <span class="ib-employee-initials">@iniciais</span>
                </div>

                <span class="ib-section-eyebrow">CLIENTE</span>

                <div class="ib-client-since">
                    <span>Cliente desde</span>
                    <strong>
                        @(cliente.DataCriacao.Year > 1
                            ? cliente.DataCriacao.ToString("dd/MM/yyyy")
                            : "—")
                    </strong>
                </div>

            </div>


            <div class="ib-client-profile-content">

                <div class="ib-client-profile-header">
                    <div>
                        <h2>@cliente.NomeCompleto</h2>
                        <span class="ib-client-email">@cliente.Email</span>
                    </div>

                    <span class="ib-category-status @(cliente.Ativo ? "active" : "inactive")">
                        @(cliente.Ativo ? "Ativo" : "Inativo")
                    </span>
                </div>


                <div class="ib-client-info-grid">

                    <div class="ib-client-info-group">
                        <span class="ib-section-eyebrow">CONTACTOS</span>

                        <div class="ib-client-info-item">
                            <span>Telefone</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(cliente.Telefone)
                                    ? "Não indicado"
                                    : cliente.Telefone)
                            </strong>
                        </div>
                    </div>


                    <div class="ib-client-info-group">
                        <span class="ib-section-eyebrow">DADOS PESSOAIS</span>

                        <div class="ib-client-info-item">
                            <span>NIF</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(cliente.Contribuinte)
                                    ? "Não indicado"
                                    : cliente.Contribuinte)
                            </strong>
                        </div>

                        <div class="ib-client-info-item">
                            <span>Morada</span>
                            <strong>
                                @if (string.IsNullOrWhiteSpace(cliente.Morada))
                                {
                                    <text>Não indicada</text>
                                }
                                else
                                {
                                    @cliente.Morada

                                    @if (!string.IsNullOrWhiteSpace(cliente.CodigoPostal) ||
                                         !string.IsNullOrWhiteSpace(cliente.Localidade))
                                    {
                                        <br />
                                        <span>
                                            @cliente.CodigoPostal
                                            @if (!string.IsNullOrWhiteSpace(cliente.CodigoPostal) &&
                                                 !string.IsNullOrWhiteSpace(cliente.Localidade))
                                            {
                                                <text> · </text>
                                            }
                                            @cliente.Localidade
                                        </span>
                                    }
                                }
                            </strong>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>


    <!-- INDICADORES -->
    <div class="ib-category-kpi-grid">

        <article class="ib-category-kpi-card">
            <span>Marcações</span>
            <strong>@marcacoes.Count</strong>
            <small>Total registado</small>
        </article>

        <article class="ib-category-kpi-card">
            <span>Próxima marcação</span>

            @if (proximaMarcacao != null)
            {
                <strong>@proximaMarcacao.DataHoraInicio.ToString("dd/MM")</strong>
                <small>
                    @proximaMarcacao.DataHoraInicio.ToString("HH:mm")
                    · @proximaMarcacao.ServicoNome
                </small>
            }
            else
            {
                <strong>—</strong>
                <small>Sem marcação futura</small>
            }
        </article>

        <article class="ib-category-kpi-card ib-category-kpi-highlight">
            <span>Última visita</span>

            @if (ultimaVisita != null)
            {
                <strong>@ultimaVisita.DataHoraInicio.ToString("dd/MM")</strong>
                <small>@ultimaVisita.ServicoNome</small>
            }
            else
            {
                <strong>—</strong>
                <small>Sem visitas concluídas</small>
            }
        </article>

    </div>


    <!-- HISTÓRICO -->
    <section class="ib-category-panel">

        <header class="ib-category-panel-header">
            <div>
                <span class="ib-section-eyebrow">ATIVIDADE</span>
                <h2>Histórico do Cliente</h2>
                <p>Marcações e serviços associados a este cliente.</p>
            </div>
        </header>


        @if (!marcacoes.Any())
        {
            <div class="ib-client-empty">
                <strong>Sem marcações registadas</strong>
                <span>Este cliente ainda não possui histórico de marcações.</span>
            </div>
        }
        else
        {
            <div class="ib-client-history">

                <div class="ib-client-history-header">
                    <span>Data</span>
                    <span>Serviço</span>
                    <span>Profissional</span>
                    <span>Estado</span>
                    <span>Valor</span>
                </div>

                @foreach (var marcacao in marcacoes)
                {
                    var temDesconto =
                        marcacao.ValorDesconto.HasValue &&
                        marcacao.ValorDesconto.Value > 0;

                    <div class="ib-client-history-row">

                        <div class="ib-client-history-date">
                            <strong>@marcacao.DataHoraInicio.ToString("dd/MM/yyyy")</strong>
                            <span>
                                @marcacao.DataHoraInicio.ToString("HH:mm")
                                – @marcacao.DataHoraFim.ToString("HH:mm")
                            </span>
                        </div>

                        <div>
                            <strong>@marcacao.ServicoNome</strong>

                            @if (!string.IsNullOrWhiteSpace(marcacao.PromoCode))
                            {
                                <small>Promo: @marcacao.PromoCode</small>
                            }
                        </div>

                        <div>
                            <span>@marcacao.FuncionarioNome</span>
                        </div>

                        @{
                            var estadoClasse = marcacao.EstadoMarcacaoNome
                                ?.Trim()
                                .ToLowerInvariant() switch
                            {
                                "pendente" => "pending",
                                "confirmada" => "confirmed",
                                "concluida" => "completed",
                                "concluída" => "completed",
                                "cancelada" => "cancelled",
                                "não compareceu" => "no-show",
                                "nao compareceu" => "no-show",
                                _ => "default"
                            };
                        }

                        <div>
                            <span class="ib-booking-status @estadoClasse">
                                @marcacao.EstadoMarcacaoNome
                            </span>
                        </div>

                        <div class="ib-client-history-price">

                            @if (temDesconto)
                            {
                                <small>
                                    Desconto:
                                    @marcacao.ValorDesconto!.Value.ToString("0.00") €
                                </small>
                            }

                            <strong>@marcacao.Preco.ToString("0.00") €</strong>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>
@model ProjetoFinalCet105.Web.Models.ClienteViewModel

@{
    ViewData["Title"] = "Detalhes do Cliente";
    Layout = "_AdminLayout";

    var nomes = Model.NomeCompleto
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    var iniciais = string.Join("", nomes
        .Take(2)
        .Select(n => char.ToUpper(n[0])));
}

<div class="ib-categories-page">

    <div class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">CLIENTES</span>
            <h1>Detalhes do Cliente</h1>
            <p>Consulte a informação e atividade do cliente na Infinity Beauty.</p>
        </div>

        <a asp-controller="GestaoClientes"
           asp-action="Index"
           class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar aos clientes
        </a>
    </div>

    <div class="ib-category-panel">

        <div class="d-flex align-items-center gap-4 mb-4">

            <div class="ib-employee-avatar"
                 style="width:72px;height:72px;font-size:20px;">
                <span class="ib-employee-initials">
                    @iniciais
                </span>
            </div>

            <div>
                <span class="ib-section-eyebrow">CLIENTE</span>
                <h2 class="mb-1">@Model.NomeCompleto</h2>

                @if (Model.Ativo)
                {
                    <span class="ib-category-status active">
                        <i></i>
                        Ativo
                    </span>
                }
                else
                {
                    <span class="ib-category-status inactive">
                        <i></i>
                        Inativo
                    </span>
                }
            </div>

        </div>

        <hr />

        <div class="row g-4 mt-1">

            <div class="col-lg-6">
                <span class="ib-section-eyebrow">CONTACTOS</span>

                <div class="mt-3">
                    <small class="text-muted">Email</small>
                    <div>
                        <strong>@Model.Email</strong>
                    </div>
                </div>

                <div class="mt-3">
                    <small class="text-muted">Telefone</small>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Telefone))
                        {
                            <strong>@Model.Telefone</strong>
                        }
                        else
                        {
                            <span class="text-muted">Não indicado</span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="ib-section-eyebrow">DADOS PESSOAIS</span>

                <div class="mt-3">
                    <small class="text-muted">NIF</small>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Contribuinte))
                        {
                            <strong>@Model.Contribuinte</strong>
                        }
                        else
                        {
                            <span class="text-muted">Não indicado</span>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <small class="text-muted">Morada</small>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.Morada))
                        {
                            <strong>@Model.Morada</strong>

                            @if (!string.IsNullOrWhiteSpace(Model.CodigoPostal) ||
                                 !string.IsNullOrWhiteSpace(Model.Localidade))
                            {
                                <div class="text-muted">
                                    @Model.CodigoPostal @Model.Localidade
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Não indicada</span>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>

    <div class="ib-category-kpi-grid mt-4">

        <div class="ib-category-kpi-card">
            <div>
                <span>CLIENTE DESDE</span>

                <strong style="font-size:18px;">
                    @if (Model.DataCriacao.Year > 1)
                    {
                        @Model.DataCriacao.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </strong>

                <small>Data de registo</small>
            </div>
        </div>

        <div class="ib-category-kpi-card">
            <div>
                <span>ÚLTIMA ATUALIZAÇÃO</span>

                <strong style="font-size:18px;">
                    @if (Model.DataAtualizacao.HasValue &&
                         Model.DataAtualizacao.Value.Year > 1)
                    {
                        @Model.DataAtualizacao.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span>—</span>
                    }
                </strong>

                <small>Atualização do perfil</small>
            </div>
        </div>

        <div class="ib-category-kpi-card
            @(Model.Ativo ? "ib-category-kpi-highlight" : "")">
            <div>
                <span>ESTADO DA CONTA</span>
                <strong style="font-size:18px;">
                    @(Model.Ativo ? "Ativa" : "Inativa")
                </strong>
                <small>Estado atual do cliente</small>
            </div>
        </div>

    </div>

    <div class="ib-category-panel mt-4">

        <div class="ib-category-panel-header">
            <div>
                <span class="ib-section-eyebrow">ATIVIDADE</span>
                <h2>Histórico do Cliente</h2>
                <p>
                    Marcações, serviços realizados e atividade do cliente
                    na Infinity Beauty.
                </p>
            </div>
        </div>

        <div class="ib-category-empty-state">
            <svg viewBox="0 0 24 24" width="35" height="35">
                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>

            <h3>Atividade do cliente</h3>
            <p>
                No próximo passo vamos ligar esta área às marcações
                existentes na API.
            </p>
        </div>

    </div>

</div>

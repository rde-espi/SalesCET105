@model List<ProjetoFinalCet105.Web.Models.MeuHorarioViewModel>

@{
    ViewData["Title"] = "Meu Horário";
    Layout = "~/Views/Shared/_FuncionarioLayout.cshtml";

    string NomeDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "Segunda-feira",
        DayOfWeek.Tuesday => "Terça-feira",
        DayOfWeek.Wednesday => "Quarta-feira",
        DayOfWeek.Thursday => "Quinta-feira",
        DayOfWeek.Friday => "Sexta-feira",
        DayOfWeek.Saturday => "Sábado",
        DayOfWeek.Sunday => "Domingo",
        _ => ""
    };

    var dias = new[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}

<div class="ib-meu-horario-page">

    <div class="ib-meu-horario-heading">
        <div>
            <span class="ib-section-eyebrow">AGENDA</span>
            <h1>Meu Horário</h1>
            <p>Consulte o seu horário semanal de trabalho.</p>
        </div>

        <div class="ib-meu-horario-summary">
            <span>SEMANA DE TRABALHO</span>
            <strong>
                @dias.Count(dia => Model.Any(h => h.DiaSemana == dia))
                dias com horário
            </strong>
        </div>
    </div>


    <div class="ib-meu-horario-panel">

        <div class="ib-meu-horario-panel-header">
            <div>
                <span class="ib-section-eyebrow">HORÁRIO SEMANAL</span>
                <h2>Disponibilidade de trabalho</h2>
            </div>

            <span class="ib-meu-horario-info">
                Segunda-feira — Domingo
            </span>
        </div>


        <div class="ib-meu-horario-list">

            @foreach (var dia in dias)
            {
                var horariosDia = Model
                    .Where(h => h.DiaSemana == dia)
                    .OrderBy(h => h.HoraInicio)
                    .ToList();

                var temHorario = horariosDia.Any();

                <div class="ib-meu-horario-day @(temHorario ? "is-working" : "is-off")">

                    <div class="ib-meu-horario-day-name">
                        <span class="ib-meu-horario-day-marker"></span>

                       <div>
                           <strong>@NomeDia(dia)</strong>
                           
                           @if (temHorario)
                           {
                               <span>Horário de trabalho</span>
                           }
                           </div>
                    </div>


                    <div class="ib-meu-horario-periods">

                        @if (temHorario)
                        {
                            foreach (var horario in horariosDia)
                            {
                                <div class="ib-meu-horario-period">
                                    <span class="ib-meu-horario-clock">
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9"></circle>
                                            <path d="M12 7v5l3 2"></path>
                                        </svg>
                                    </span>

                                    <strong>
                                        @horario.HoraInicio.ToString(@"hh\:mm")
                                        <span>—</span>
                                        @horario.HoraFim.ToString(@"hh\:mm")
                                    </strong>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="ib-meu-horario-off-label">
                                Folga
                            </span>
                        }

                    </div>


                    <div class="ib-meu-horario-status">
                        @if (temHorario)
                        {
                            <span class="is-active">
                                Em serviço
                            </span>
                        }
                        else
                        {
                            <div class="ib-meu-horario-status">
    @if (temHorario)
    {
        <span class="is-active">
            Em serviço
        </span>
    }
</div>
                        }
                    </div>

                </div>
            }

        </div>

    </div>

</div>
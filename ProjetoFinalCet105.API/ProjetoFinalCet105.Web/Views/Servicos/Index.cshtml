@model ProjetoFinalCet105.Web.Models.ServicosPublicoViewModel

@{
    ViewData["Title"] = "Serviços";
    Layout = "_PublicLayout";

    var categoriaSelecionada = Model.CategoriaSelecionadaId;

    var servicosFiltrados = Model.Servicos.AsEnumerable();

    if (categoriaSelecionada.HasValue)
    {
        servicosFiltrados = servicosFiltrados
            .Where(s => s.CategoriaId == categoriaSelecionada.Value);
    }

    var resultados = servicosFiltrados.ToList();
}

<section class="ib-services-page">

    <!-- HERO -->
    <header class="ib-services-hero">

        <span class="ib-section-eyebrow">
            INFINITY BEAUTY
        </span>

        <h1>Os nossos serviços</h1>

        <p>
            Descubra tratamentos pensados para cuidar de si,
            do seu bem-estar e da sua beleza.
        </p>

    </header>


    <!-- PESQUISA -->
    <div class="ib-services-toolbar">

        <div class="ib-services-search">

            <svg class="ib-services-search-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">

                <circle cx="11"
                        cy="11"
                        r="7"></circle>

                <path d="m20 20-4-4"></path>

            </svg>

            <input type="search"
                   id="pesquisaServico"
                   placeholder="Pesquisar serviço..."
                   autocomplete="off" />

        </div>

    </div>


    <!-- CATEGORIAS -->
    <nav class="ib-services-categories"
         aria-label="Categorias de serviços">

        <a asp-controller="Servicos"
           asp-action="Index"
           class="@(!categoriaSelecionada.HasValue ? "active" : "")">
            Todos
        </a>

        @foreach (var categoria in Model.Categorias)
        {
            <a asp-controller="Servicos"
               asp-action="Index"
               asp-route-categoriaId="@categoria.Id"
               class="@(categoriaSelecionada == categoria.Id ? "active" : "")">

                @categoria.Nome

            </a>
        }

    </nav>


    <!-- CONTEÚDO -->
    <div class="ib-services-content">


        @if (categoriaSelecionada.HasValue)
        {
            <!-- CATEGORIA SELECIONADA -->

            <div class="ib-services-result-header">

                <div>

                    <span class="ib-section-eyebrow">
                        SERVIÇOS
                    </span>

                    <h2>
                        @(Model.CategoriaSelecionada?.Nome ?? "Serviços")
                    </h2>

                </div>

                <span class="ib-services-result-count"
                      id="contadorServicos">

                    @resultados.Count
                    @(resultados.Count == 1 ? "serviço" : "serviços")

                </span>

            </div>


            @if (resultados.Any())
            {
                <div class="ib-services-grid"
                     id="servicosGrid">

                    @foreach (var servico in resultados)
                    {
                        <article class="ib-service-card"
                        data-servico
                        data-nome="@servico.Nome"
                        data-categoria="@servico.CategoriaNome"
                        data-descricao="@(servico.Descricao ?? "")"
                        role="link"
                        tabindex="0"
                        onclick="window.location.href='@Url.Action("Detalhes", "Servicos", new { id = servico.Id })'"
                        onkeydown="if(event.key === 'Enter') window.location.href='@Url.Action("Detalhes", "Servicos", new { id = servico.Id })'">

                            <div class="ib-service-card-image">

                                <img src="@Url.Action(
                                            "Imagem",
                                            "Servicos",
                                            new { id = servico.Id })"
                                     alt="@servico.Nome"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <div class="ib-service-card-placeholder"
                                     style="display:none;">

                                    <span>
                                        @servico.Nome
                                    </span>

                                </div>

                            </div>


                            <div class="ib-service-card-body">

                                <span class="ib-service-card-category">
                                    @servico.CategoriaNome
                                </span>

                                <h3>
                                    @servico.Nome
                                </h3>


                                <div class="ib-service-card-footer">

                                    <span>
                                        @servico.DuracaoMinutos min
                                    </span>

                                    <strong>
                                        @servico.Preco.ToString("C")
                                    </strong>

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <!-- SEM RESULTADOS DA PESQUISA -->
                <div class="ib-services-empty"
                     id="semResultadosPesquisa"
                     style="display:none;">

                    <h3>
                        Nenhum serviço encontrado
                    </h3>

                    <p>
                        Experimente alterar os termos da pesquisa.
                    </p>

                </div>
            }
            else
            {
                <div class="ib-services-empty">

                    <h3>
                        Nenhum serviço disponível
                    </h3>

                    <p>
                        Não existem serviços disponíveis nesta categoria.
                    </p>

                    <a asp-controller="Servicos"
                       asp-action="Index">

                        Ver todos os serviços

                    </a>

                </div>
            }
        }
        else
        {
            <!-- VISÃO GERAL POR CATEGORIA -->

            @foreach (var categoria in Model.Categorias)
            {
                var servicosCategoria = Model.Servicos
                    .Where(s => s.CategoriaId == categoria.Id)
                    .Take(4)
                    .ToList();

                if (servicosCategoria.Any())
                {
                    <section class="ib-services-category-section"
                             data-categoria-section>

                        <div class="ib-services-category-header">

                            <div>

                                <span class="ib-section-eyebrow">
                                    CATEGORIA
                                </span>

                                <h2>
                                    @categoria.Nome
                                </h2>

                            </div>


                            <a asp-controller="Servicos"
                               asp-action="Index"
                               asp-route-categoriaId="@categoria.Id"
                               class="ib-services-view-category">

                                Ver categoria →

                            </a>

                        </div>


                        <div class="ib-services-grid">

                            @foreach (var servico in servicosCategoria)
                            {
                                <article class="ib-service-card"
                                data-servico
                                data-nome="@servico.Nome"
                                data-categoria="@servico.CategoriaNome"
                                data-descricao="@(servico.Descricao ?? "")"
                                role="link"
                                tabindex="0"
                                onclick="window.location.href='@Url.Action("Detalhes", "Servicos", new { id = servico.Id })'"
                                onkeydown="if(event.key === 'Enter') window.location.href='@Url.Action("Detalhes", "Servicos", new { id = servico.Id })'">

                                    <div class="ib-service-card-image">

                                        <img src="@Url.Action(
                                                    "Imagem",
                                                    "Servicos",
                                                    new { id = servico.Id })"
                                             alt="@servico.Nome"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                        <div class="ib-service-card-placeholder"
                                             style="display:none;">

                                            <span>
                                                @servico.Nome
                                            </span>

                                        </div>

                                    </div>


                                    <div class="ib-service-card-body">

                                        <span class="ib-service-card-category">
                                            @servico.CategoriaNome
                                        </span>

                                        <h3>
                                            @servico.Nome
                                        </h3>


                                        <div class="ib-service-card-footer">

                                            <span>
                                                @servico.DuracaoMinutos min
                                            </span>

                                            <strong>
                                                @servico.Preco.ToString("C")
                                            </strong>

                                        </div>

                                    </div>

                                </article>
                            }

                        </div>

                    </section>
                }
            }


            <!-- SEM RESULTADOS DA PESQUISA -->
            <div class="ib-services-empty"
                 id="semResultadosPesquisa"
                 style="display:none;">

                <h3>
                    Nenhum serviço encontrado
                </h3>

                <p>
                    Experimente alterar os termos da pesquisa.
                </p>

            </div>
        }

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            const pesquisa =
                document.getElementById('pesquisaServico');

            const cards =
                document.querySelectorAll('[data-servico]');

            const secoesCategorias =
                document.querySelectorAll('[data-categoria-section]');

            const semResultados =
                document.getElementById('semResultadosPesquisa');

            const contador =
                document.getElementById('contadorServicos');


            if (!pesquisa || !cards.length) {
                return;
            }


            function normalizarTexto(texto) {

                return (texto || '')
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .trim();
            }


            function filtrarServicos() {

                const termo =
                    normalizarTexto(pesquisa.value);

                let totalVisiveis = 0;


                /* FILTRAR CARDS */

                cards.forEach(card => {

                    const nome =
                        normalizarTexto(card.dataset.nome);

                    const categoria =
                        normalizarTexto(card.dataset.categoria);

                    const descricao =
                        normalizarTexto(card.dataset.descricao);


                    const corresponde =
                        !termo ||
                        nome.includes(termo) ||
                        categoria.includes(termo) ||
                        descricao.includes(termo);


                    card.style.display =
                        corresponde ? '' : 'none';


                    if (corresponde) {
                        totalVisiveis++;
                    }

                });


                

                secoesCategorias.forEach(secao => {

                    const cardsDaSecao =
                        secao.querySelectorAll('[data-servico]');


                    const temResultado =
                        Array.from(cardsDaSecao).some(card =>
                            card.style.display !== 'none'
                        );


                    secao.style.display =
                        temResultado ? '' : 'none';

                });


                

                if (semResultados) {

                    semResultados.style.display =
                        totalVisiveis === 0
                            ? 'block'
                            : 'none';
                }


                

                if (contador) {

                    contador.textContent =
                        totalVisiveis === 1
                            ? '1 serviço'
                            : `${totalVisiveis} serviços`;
                }

            }


            pesquisa.addEventListener(
                'input',
                filtrarServicos
            );

        });

    </script>
}
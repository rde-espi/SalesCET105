@model ProjetoFinalCet105.Web.Models.NovaMarcacaoAdminViewModel

@{
    ViewData["Title"] = "Nova Marcação";
    Layout = "_AdminLayout";
}

<div class="ib-categories-page">

    <div class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">AGENDA</span>
            <h1>Nova Marcação</h1>
            <p>Registe uma nova marcação para um cliente.</p>
        </div>

        <a asp-controller="GestaoMarcacoes"
           asp-action="Index"
           class="ib-category-back-btn">
            <svg viewBox="0 0 24 24">
                <path d="M19 12H5"></path>
                <path d="M11 6l-6 6 6 6"></path>
            </svg>
            Voltar às marcações
        </a>
    </div>

    <div class="ib-category-panel">

        <div class="ib-category-panel-header">
            <div>
                <span class="ib-section-eyebrow">NOVA MARCAÇÃO</span>
                <h2>Dados da marcação</h2>
            </div>
        </div>

        <form asp-controller="GestaoMarcacoes"
              asp-action="Criar"
              method="post"
              id="formNovaMarcacao">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="ib-booking-edit-grid">

                <!-- CLIENTE -->
                <div class="ib-category-field">
                    <label asp-for="ClienteId">
                        Cliente <span>*</span>
                    </label>

                    <select asp-for="ClienteId"
        id="ClienteId"
        class="ib-service-select">
                        <option value="">Selecione o cliente</option>

                        @foreach (var cliente in Model.Clientes)
                        {
                            <option value="@cliente.Id">
                                @cliente.NomeCompleto
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ClienteId"
                          class="ib-field-validation"></span>
                </div>

                <!-- SERVIÇO -->
                <div class="ib-category-field">
                    <label asp-for="ServicoId">
                        Serviço <span>*</span>
                    </label>

                    <select asp-for="ServicoId"
                            id="ServicoId"
                            class="ib-service-select">
                        <option value="">Selecione o serviço</option>

                        @foreach (var servico in Model.Servicos)
                        {
                            <option value="@servico.Id">
                                @servico.Nome
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ServicoId"
                          class="ib-field-validation"></span>
                </div>

                <!-- PROFISSIONAL -->
                <div class="ib-category-field">
                    <label asp-for="FuncionarioId">
                        Profissional <span>*</span>
                    </label>

                    <select asp-for="FuncionarioId"
        id="FuncionarioId"
        class="ib-service-select"
        disabled>
                        <option value="">
                            Selecione primeiro o serviço
                        </option>
                    </select>

                    <span asp-validation-for="FuncionarioId"
                          class="ib-field-validation"></span>
                </div>

                <!-- DATA -->
                <div class="ib-category-field">
                    <label>
                        Data <span>*</span>
                    </label>

                    <div class="ib-datepicker" id="ibDatepicker">

                        <button type="button"
                                class="ib-datepicker-trigger"
                                id="ibDatepickerTrigger">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                <path d="M16 3v4M8 3v4M3 10h18"></path>
                            </svg>

                            <span id="ibDatepickerText">
                                Selecione a data
                            </span>

                            <svg class="ib-datepicker-chevron"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>

                        <div class="ib-datepicker-popup"
                             id="ibDatepickerPopup">

                            <div class="ib-datepicker-header">

                                <strong id="ibCalendarMonth"></strong>

                                <div class="ib-datepicker-nav">

                                    <button type="button"
                                            id="ibCalendarPrev"
                                            aria-label="Mês anterior">
                                        <svg viewBox="0 0 24 24">
                                            <path d="m15 18-6-6 6-6"></path>
                                        </svg>
                                    </button>

                                    <button type="button"
                                            id="ibCalendarNext"
                                            aria-label="Mês seguinte">
                                        <svg viewBox="0 0 24 24">
                                            <path d="m9 18 6-6-6-6"></path>
                                        </svg>
                                    </button>

                                </div>
                            </div>

                            <div class="ib-datepicker-weekdays">
                                <span>D</span>
                                <span>S</span>
                                <span>T</span>
                                <span>Q</span>
                                <span>Q</span>
                                <span>S</span>
                                <span>S</span>
                            </div>

                            <div class="ib-datepicker-days"
                                 id="ibCalendarDays">
                            </div>

                            <div class="ib-datepicker-footer">
                                <button type="button"
                                        id="ibCalendarToday">
                                    Hoje
                                </button>
                            </div>

                        </div>
                    </div>

                    <input type="hidden"
                           id="dataMarcacao" />

                    <input asp-for="DataHoraInicio"
                           type="hidden"
                           id="DataHoraInicio" />

                    <span asp-validation-for="DataHoraInicio"
                          class="ib-field-validation"></span>
                </div>

            </div>

            <!-- HORÁRIOS -->
            <div class="ib-category-field">
                <label>
                    Horários disponíveis <span>*</span>
                </label>

                <div id="horariosDisponiveis"
                     class="ib-booking-slots">

                    <div class="ib-booking-slots-empty">
                        Selecione o serviço, o profissional e a data.
                    </div>

                </div>

                <div id="horarioErro"
                     class="ib-field-validation"
                     style="display:none;">
                    Selecione um horário disponível.
                </div>
            </div>

            <!-- OBSERVAÇÕES -->
            <div class="ib-category-field">

                <div class="ib-category-field-label">
                    <label asp-for="Observacoes">
                        Observações
                    </label>

                    <span>Opcional</span>
                </div>

                <textarea asp-for="Observacoes"
                          rows="4"
                          maxlength="500"
                          placeholder="Observações da marcação..."></textarea>

                <span asp-validation-for="Observacoes"
                      class="ib-field-validation"></span>
            </div>

            <div class="ib-booking-edit-actions">

                <a asp-controller="GestaoMarcacoes"
                   asp-action="Index"
                   class="ib-booking-secondary-btn">
                    Cancelar
                </a>

                <button type="submit"
                        class="ib-booking-confirm-btn">
                    Criar marcação
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const servico = document.getElementById("ServicoId");
            const funcionario = document.getElementById("FuncionarioId");
            const data = document.getElementById("dataMarcacao");
            const dataHoraInicio = document.getElementById("DataHoraInicio");

            const container =
                document.getElementById("horariosDisponiveis");

            const horarioErro =
                document.getElementById("horarioErro");

            // =====================================================
            // PROFISSIONAIS POR SERVIÇO
            // =====================================================

            async function carregarProfissionais() {

                const servicoId = servico.value;

                funcionario.innerHTML =
                    '<option value="">Selecione o profissional</option>';

                funcionario.disabled = true;

                dataHoraInicio.value = "";

                container.innerHTML =
                    '<div class="ib-booking-slots-empty">' +
                    'Selecione o serviço, o profissional e a data.' +
                    '</div>';

                if (!servicoId)
                    return;

                funcionario.innerHTML =
                    '<option value="">A consultar profissionais...</option>';

                try {

                    const url =
                        '@Url.Action("ProfissionaisPorServico", "GestaoMarcacoes")' +
                        '?servicoId=' +
                        encodeURIComponent(servicoId);

                    const response = await fetch(url);

                    if (!response.ok)
                        throw new Error();

                    const profissionais = await response.json();

                    funcionario.innerHTML =
                        '<option value="">Selecione o profissional</option>';

                    if (!profissionais ||
                        profissionais.length === 0) {

                        funcionario.innerHTML =
                            '<option value="">Sem profissionais disponíveis</option>';

                        return;
                    }

                    profissionais.forEach(function (profissional) {

                        const option =
                            document.createElement("option");

                        option.value = profissional.id;
                        option.textContent =
                            profissional.nomeCompleto;

                        funcionario.appendChild(option);
                    });

                    funcionario.disabled = false;
                }
                catch {

                    funcionario.innerHTML =
                        '<option value="">Não foi possível carregar</option>';
                }
            }

            // =====================================================
            // CALENDÁRIO
            // =====================================================

            const datepicker =
                document.getElementById("ibDatepicker");

            const datepickerTrigger =
                document.getElementById("ibDatepickerTrigger");

            const datepickerText =
                document.getElementById("ibDatepickerText");

            const calendarMonth =
                document.getElementById("ibCalendarMonth");

            const calendarDays =
                document.getElementById("ibCalendarDays");

            const calendarPrev =
                document.getElementById("ibCalendarPrev");

            const calendarNext =
                document.getElementById("ibCalendarNext");

            const calendarToday =
                document.getElementById("ibCalendarToday");

            const hoje = new Date();
            hoje.setHours(0, 0, 0, 0);

            let dataSelecionada = null;

            let mesVisivel =
                new Date(
                    hoje.getFullYear(),
                    hoje.getMonth(),
                    1
                );

            function mesmaData(a, b) {
                return a.getFullYear() === b.getFullYear() &&
                       a.getMonth() === b.getMonth() &&
                       a.getDate() === b.getDate();
            }

            function formatarDataInput(date) {

                const ano = date.getFullYear();

                const mes =
                    String(date.getMonth() + 1)
                        .padStart(2, "0");

                const dia =
                    String(date.getDate())
                        .padStart(2, "0");

                return `${ano}-${mes}-${dia}`;
            }

            function formatarDataVisual(date) {

                return date.toLocaleDateString(
                    "pt-PT",
                    {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric"
                    }
                );
            }

            function desenharCalendario() {

                calendarDays.innerHTML = "";

                const mesAtual =
                    new Date(
                        hoje.getFullYear(),
                        hoje.getMonth(),
                        1
                    );

                calendarPrev.disabled =
                    mesVisivel <= mesAtual;

                calendarMonth.textContent =
                    mesVisivel.toLocaleDateString(
                        "pt-PT",
                        {
                            month: "long",
                            year: "numeric"
                        }
                    );

                const primeiroDia =
                    new Date(
                        mesVisivel.getFullYear(),
                        mesVisivel.getMonth(),
                        1
                    );

                const ultimoDia =
                    new Date(
                        mesVisivel.getFullYear(),
                        mesVisivel.getMonth() + 1,
                        0
                    );

                for (
                    let i = 0;
                    i < primeiroDia.getDay();
                    i++
                ) {
                    const vazio =
                        document.createElement("span");

                    vazio.className =
                        "ib-datepicker-empty";

                    calendarDays.appendChild(vazio);
                }

                for (
                    let dia = 1;
                    dia <= ultimoDia.getDate();
                    dia++
                ) {

                    const dataDia =
                        new Date(
                            mesVisivel.getFullYear(),
                            mesVisivel.getMonth(),
                            dia
                        );

                    const botao =
                        document.createElement("button");

                    botao.type = "button";
                    botao.className =
                        "ib-datepicker-day";

                    botao.textContent = dia;

                    if (dataDia < hoje)
                        botao.disabled = true;

                    if (mesmaData(dataDia, hoje))
                        botao.classList.add("today");

                    if (
                        dataSelecionada &&
                        mesmaData(
                            dataDia,
                            dataSelecionada
                        )
                    ) {
                        botao.classList.add(
                            "selected"
                        );
                    }

                    botao.addEventListener(
                        "click",
                        function () {

                            dataSelecionada =
                                new Date(dataDia);

                            data.value =
                                formatarDataInput(
                                    dataSelecionada
                                );

                            datepickerText.textContent =
                                formatarDataVisual(
                                    dataSelecionada
                                );

                            datepicker.classList.remove(
                                "open"
                            );

                            desenharCalendario();
                            carregarHorarios();
                        }
                    );

                    calendarDays.appendChild(botao);
                }
            }

            datepickerTrigger.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    datepicker.classList.toggle(
                        "open"
                    );

                    if (
                        datepicker.classList.contains(
                            "open"
                        )
                    ) {
                        desenharCalendario();
                    }
                }
            );

            calendarPrev.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    mesVisivel =
                        new Date(
                            mesVisivel.getFullYear(),
                            mesVisivel.getMonth() - 1,
                            1
                        );

                    desenharCalendario();
                }
            );

            calendarNext.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    mesVisivel =
                        new Date(
                            mesVisivel.getFullYear(),
                            mesVisivel.getMonth() + 1,
                            1
                        );

                    desenharCalendario();
                }
            );

            calendarToday.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    dataSelecionada =
                        new Date(hoje);

                    mesVisivel =
                        new Date(
                            hoje.getFullYear(),
                            hoje.getMonth(),
                            1
                        );

                    data.value =
                        formatarDataInput(
                            dataSelecionada
                        );

                    datepickerText.textContent =
                        formatarDataVisual(
                            dataSelecionada
                        );

                    datepicker.classList.remove(
                        "open"
                    );

                    desenharCalendario();
                    carregarHorarios();
                }
            );

            document.addEventListener(
                "click",
                function (event) {

                    if (!datepicker.contains(event.target))
                        datepicker.classList.remove("open");
                }
            );

            // =====================================================
            // HORÁRIOS DISPONÍVEIS
            // =====================================================

            async function carregarHorarios() {

                const funcionarioId =
                    funcionario.value;

                const servicoId =
                    servico.value;

                const dataEscolhida =
                    data.value;

                horarioErro.style.display =
                    "none";

                dataHoraInicio.value = "";

                if (
                    !funcionarioId ||
                    !servicoId ||
                    !dataEscolhida
                ) {

                    container.innerHTML =
                        '<div class="ib-booking-slots-empty">' +
                        'Selecione o serviço, o profissional e a data.' +
                        '</div>';

                    return;
                }

                container.innerHTML =
                    '<div class="ib-booking-slots-loading">' +
                    'A consultar horários disponíveis...' +
                    '</div>';

                try {

                    const url =
                        '@Url.Action("HorariosDisponiveis", "GestaoMarcacoes")' +
                        '?funcionarioId=' +
                        encodeURIComponent(funcionarioId) +
                        '&servicoId=' +
                        encodeURIComponent(servicoId) +
                        '&data=' +
                        encodeURIComponent(dataEscolhida);

                    const response =
                        await fetch(url);

                    if (!response.ok)
                        throw new Error();

                    const horarios =
                        await response.json();

                    if (
                        !horarios ||
                        horarios.length === 0
                    ) {

                        container.innerHTML =
                            '<div class="ib-booking-slots-empty">' +
                            'Sem horários disponíveis para esta data.' +
                            '</div>';

                        return;
                    }

                    container.innerHTML = "";

                    horarios.forEach(
                        function (horario) {

                            const dataHora =
                                new Date(horario);

                            const horas =
                                String(
                                    dataHora.getHours()
                                ).padStart(2, "0") +
                                ":" +
                                String(
                                    dataHora.getMinutes()
                                ).padStart(2, "0");

                            const botao =
                                document.createElement(
                                    "button"
                                );

                            botao.type = "button";
                            botao.className =
                                "ib-booking-slot";

                            botao.textContent =
                                horas;

                            botao.addEventListener(
                                "click",
                                function () {

                                    document
                                        .querySelectorAll(
                                            ".ib-booking-slot"
                                        )
                                        .forEach(
                                            function (b) {
                                                b.classList.remove(
                                                    "selected"
                                                );
                                            }
                                        );

                                    botao.classList.add(
                                        "selected"
                                    );

                                    dataHoraInicio.value =
                                        dataEscolhida +
                                        "T" +
                                        horas;

                                    horarioErro.style.display =
                                        "none";
                                }
                            );

                            container.appendChild(
                                botao
                            );
                        }
                    );
                }
                catch {

                    container.innerHTML =
                        '<div class="ib-booking-slots-empty">' +
                        'Não foi possível consultar os horários disponíveis.' +
                        '</div>';
                }
            }

            // =====================================================
            // ALTERAÇÕES
            // =====================================================

            servico.addEventListener(
                "change",
                carregarProfissionais
            );

            funcionario.addEventListener(
                "change",
                carregarHorarios
            );

            // =====================================================
            // VALIDAÇÃO FINAL
            // =====================================================

            const form =
                document.getElementById(
                    "formNovaMarcacao"
                );

            form.addEventListener(
                "submit",
                function (event) {

                    if (!dataHoraInicio.value) {

                        event.preventDefault();

                        horarioErro.style.display =
                            "block";
                    }
                }
            );

            // =====================================================
            // INICIALIZAÇÃO
            // =====================================================

            desenharCalendario();
        });
    </script>
}
@model List<ProjetoFinalCet105.Web.Models.CategoriaViewModel>

@{
    ViewData["Title"] = "Categorias";
    Layout = User.IsInRole("Admin")
    ? "_AdminLayout"
    : "_FuncionarioLayout";

    var totalCategorias = Model?.Count ?? 0;
    var categoriasAtivas = Model?.Count(c => c.Ativa) ?? 0;
    var categoriasInativas = Model?.Count(c => !c.Ativa) ?? 0;
}

<div class="ib-categories-page">

    <!-- Cabeçalho -->
    <section class="ib-categories-heading">
        <div>
            <span class="ib-section-eyebrow">CATÁLOGO</span>
            <h1>Gestão de Categorias</h1>
            <p>
                Organize as categorias utilizadas para agrupar
                os serviços do Infinity Beauty.
            </p>
        </div>

        <a asp-controller="Categorias"
   asp-action="Create"
   class="ib-category-create-btn">
    Nova categoria
</a>
    </section>

    <!-- KPI -->
    <section class="ib-category-kpi-grid">

        <!-- Total -->
        <article class="ib-category-kpi-card">
            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                    <path d="M8 8h8M8 12h8M8 16h5"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">
                <span>Total de categorias</span>
                <strong>@totalCategorias</strong>
                <small>Categorias registadas</small>
            </div>
        </article>

        <!-- Ativas -->
        <article class="ib-category-kpi-card">
            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 12l3 3 5-6"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">
                <span>Categorias ativas</span>
                <strong id="activeCategoriesCount">@categoriasAtivas</strong>
                <small>Disponíveis no catálogo</small>
            </div>
        </article>

        <!-- Inativas -->
        <article class="ib-category-kpi-card ib-category-kpi-highlight">
            <div class="ib-category-kpi-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M8 8l8 8M16 8l-8 8"></path>
                </svg>
            </div>

            <div class="ib-category-kpi-content">
                <span>Categorias inativas</span>
                <strong id="inactiveCategoriesCount">@categoriasInativas</strong>
                <small>Ocultas do catálogo</small>
            </div>
        </article>

    </section>

    <!-- Mensagens -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="ib-category-alert success">
            <svg class="ib-category-alert-icon"
                 viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8 12l3 3 5-6"></path>
            </svg>
            <span>@TempData["Sucesso"]</span>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="ib-category-alert error">
            <span class="material-symbols-outlined">
                error
            </span>
            <span>@TempData["Erro"]</span>
        </div>
    }

    <!-- Listagem -->
    <section class="ib-category-panel">

        <header class="ib-category-panel-header">

            <div>
                <span class="ib-section-eyebrow">CATEGORIAS</span>
                <h2>Categorias de serviços</h2>
                <p>
                    Consulte e faça a gestão das categorias existentes.
                </p>
            </div>

            <div class="ib-category-search">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-4-4"></path>
                </svg>

                <input type="search"
                       id="categorySearch"
                       placeholder="Pesquisar categoria..."
                       autocomplete="off" />
            </div>

        </header>

        @if (Model != null && Model.Any())
        {
            <div class="ib-category-table">

                <div class="ib-category-table-header">
                    <span>Imagem</span>
                    <span>Categoria</span>
                    <span>Descrição</span>
                    <span>Estado</span>
                    <span></span>
                </div>

                <div id="categoryRows">

                    @foreach (var categoria in Model.OrderBy(c => c.Nome))
                    {
                        <div class="ib-category-row"
                             data-category-row
                             data-category-id="@categoria.Id"
                             data-category-active="@categoria.Ativa.ToString().ToLower()"
                             data-search="@($"{categoria.Nome} {categoria.Descricao}")">

                            <div class="ib-category-image">

                                <img src="@Url.Action(    "Imagem",
                                                                              "Categorias",
                                                                              new { id = categoria.Id })"
                                     alt="@categoria.Nome"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <div class="ib-category-image-fallback">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 21c0-6 3-10 8-12-1 6-4 10-8 12z"></path>
                                        <path d="M12 21c0-6-3-10-8-12 1 6 4 10 8 12z"></path>
                                        <path d="M12 20V5"></path>
                                    </svg>
                                </div>

                            </div>

                            <div class="ib-category-name">
                                <strong>@categoria.Nome</strong>
                                <small>Categoria #@categoria.Id</small>
                            </div>

                            <div class="ib-category-description">
                                @if (!string.IsNullOrWhiteSpace(categoria.Descricao))
                                {
                                    <span>@categoria.Descricao</span>
                                }
                                else
                                {
                                    <span class="ib-category-empty">
                                        Sem descrição
                                    </span>
                                }
                            </div>

                            <div>
                                <span class="ib-category-status @(categoria.Ativa ? "active" : "inactive")" data-category-status>
                                    <i></i>
                                    <span data-category-status-text>@(categoria.Ativa ? "Ativa" : "Inativa")</span>
                                </span>
                            </div>

                            <div class="ib-category-actions">

                                <a asp-controller="Categorias"
                                   asp-action="Editar"
                                   asp-route-id="@categoria.Id"
                                   class="ib-category-action-btn"
                                   title="Editar categoria">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M4 20h4l11-11-4-4L4 16v4z"></path>
                                        <path d="M13.5 6.5l4 4"></path>
                                    </svg>
                                </a>

                                @if (categoria.Ativa)
                                {
                                    <form asp-controller="Categorias"
                                          asp-action="Desativar"
                                          asp-route-id="@categoria.Id"
                                          method="post"
                                          class="ib-category-status-form"
                                          data-category-action="deactivate"
                                          data-category-name="@categoria.Nome">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="ib-category-action-btn danger" title="Desativar categoria">
                                            <svg viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Categorias"
                                          asp-action="Ativar"
                                          asp-route-id="@categoria.Id"
                                          method="post"
                                          class="ib-category-status-form"
                                          data-category-action="activate"
                                          data-category-name="@categoria.Nome">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="ib-category-action-btn activate" title="Reativar categoria">
                                            <svg viewBox="0 0 24 24">
                                                <path d="M4 12a8 8 0 1 0 2.3-5.7"></path>
                                                <path d="M4 5v5h5"></path>
                                            </svg>
                                        </button>
                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>

                <div id="categoryNoResults"
                     class="ib-category-no-results"
                     style="display:none;">
                    <svg class="ib-empty-icon" viewBox="0 0 24 24">
                        <circle cx="10" cy="10" r="6"></circle>
                        <path d="M14.5 14.5L20 20"></path>
                        <path d="M7 7l6 6"></path>
                    </svg>
                    <strong>Nenhuma categoria encontrada</strong>
                    <p>
                        Experimente pesquisar por outro nome ou descrição.
                    </p>
                </div>

            </div>

            <div class="ib-pagination" id="paginacaoCategorias">

    <div class="ib-pagination-info">
        A mostrar
        <strong id="categoriaPaginaInicio">0</strong>–<strong id="categoriaPaginaFim">0</strong>
        de
        <strong id="categoriaTotalFiltrado">0</strong>
    </div>

    <div class="ib-pagination-controls">

        <label class="ib-pagination-size">
            <span>Itens por página</span>

            <select id="categoriasPorPagina">
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
            </select>
        </label>

        <div class="ib-pagination-pages">

            <button type="button"
                    id="categoriaPaginaAnterior"
                    class="ib-pagination-arrow"
                    aria-label="Página anterior">
                ‹
            </button>

            <div id="categoriaNumerosPaginas"
                 class="ib-pagination-numbers">
            </div>

            <button type="button"
                    id="categoriaPaginaSeguinte"
                    class="ib-pagination-arrow"
                    aria-label="Página seguinte">
                ›
            </button>

        </div>

    </div>

</div>
        }
        else
        {
            <div class="ib-category-empty-state">
                <span class="material-symbols-outlined">
                    Categorias
                </span>

                <h3>Ainda não existem categorias</h3>

                <p>
                    Crie a primeira categoria para começar
                    a organizar os serviços.
                </p>

                <a asp-controller="Categorias"
                   asp-action="Criar"
                   class="ib-category-create-btn">
                    Nova categoria
                </a>
            </div>
        }

    </section>

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const input = document.getElementById("categorySearch");

            const rows = Array.from(document.querySelectorAll("[data-category-row]"));

            const noResults = document.getElementById("categoryNoResults");
            const paginacao =
    document.getElementById("paginacaoCategorias");

const seletorPagina =
    document.getElementById("categoriasPorPagina");

const paginaAnterior =
    document.getElementById("categoriaPaginaAnterior");

const paginaSeguinte =
    document.getElementById("categoriaPaginaSeguinte");

const numerosPaginas =
    document.getElementById("categoriaNumerosPaginas");

const paginaInicio =
    document.getElementById("categoriaPaginaInicio");

const paginaFim =
    document.getElementById("categoriaPaginaFim");

const totalFiltrado =
    document.getElementById("categoriaTotalFiltrado");

let paginaAtual = 1;
let itensPorPagina = 10;
let rowsFiltradas = [...rows];

            if (!input || rows.length === 0) {
                return;
            }

            function normalizeText(value) {
                return (value || "")
                    .toString()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLocaleLowerCase("pt-PT")
                    .trim();
            }

            function criarPaginas(totalPaginas) {

    numerosPaginas.innerHTML = "";

    if (totalPaginas <= 1)
        return;

    for (let numero = 1; numero <= totalPaginas; numero++) {

        const botao = document.createElement("button");

        botao.type = "button";
        botao.textContent = numero;
        botao.className = "ib-pagination-number";

        if (numero === paginaAtual)
            botao.classList.add("active");

        botao.addEventListener("click", function() {
            paginaAtual = numero;
            mostrarPaginaCategorias();
        });

        numerosPaginas.appendChild(botao);
    }
}


function mostrarPaginaCategorias() {

    rows.forEach(function(row) {
        row.style.display = "none";
    });

    const totalItens = rowsFiltradas.length;

    const totalPaginas =
        Math.max(
            1,
            Math.ceil(totalItens / itensPorPagina)
        );

    if (paginaAtual > totalPaginas)
        paginaAtual = totalPaginas;

    const primeiro =
        (paginaAtual - 1) * itensPorPagina;

    const ultimo =
        Math.min(
            primeiro + itensPorPagina,
            totalItens
        );

    rowsFiltradas
        .slice(primeiro, ultimo)
        .forEach(function(row) {
            row.style.display = "grid";
        });

    totalFiltrado.textContent = totalItens;

    paginaInicio.textContent =
        totalItens === 0
            ? 0
            : primeiro + 1;

    paginaFim.textContent = ultimo;

    paginaAnterior.disabled =
        paginaAtual <= 1;

    paginaSeguinte.disabled =
        paginaAtual >= totalPaginas;

    criarPaginas(totalPaginas);

    if (noResults) {
        noResults.style.display =
            totalItens === 0
                ? "block"
                : "none";
    }

    if (paginacao) {
        paginacao.style.display =
            rows.length > 10
                ? "flex"
                : "none";
    }
}


function filterCategories() {

    const searchTerm =
        normalizeText(input.value);

    rowsFiltradas =
        rows.filter(function(row) {

            const searchableText =
                normalizeText(
                    row.getAttribute("data-search")
                );

            return searchTerm === "" ||
                searchableText.includes(searchTerm);
        });

    paginaAtual = 1;

    mostrarPaginaCategorias();
}

            function updateCategoryState(row, form, isActive) {

                const status = row.querySelector("[data-category-status]");
                const statusText = row.querySelector("[data-category-status-text]");
                const button = form.querySelector("button");
                const activeCount = document.getElementById("activeCategoriesCount");
                const inactiveCount = document.getElementById("inactiveCategoriesCount");

                row.dataset.categoryActive = isActive.toString();

                status.classList.toggle("active", isActive);
                status.classList.toggle("inactive", !isActive);
                statusText.textContent = isActive ? "Ativa" : "Inativa";

                if (activeCount && inactiveCount) {
                    let active = Number(activeCount.textContent);
                    let inactive = Number(inactiveCount.textContent);

                    activeCount.textContent = isActive ? active + 1 : active - 1;
                    inactiveCount.textContent = isActive ? inactive - 1 : inactive + 1;
                }

                if (isActive) {
                    form.action = `/Categorias/Desativar/${row.dataset.categoryId}`;
                    form.dataset.categoryAction = "deactivate";

                    button.classList.remove("activate");
                    button.classList.add("danger");
                    button.title = "Desativar categoria";

                    button.querySelector("svg").innerHTML = `
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M6 6l12 12"></path>
                `;
                }
                else {
                    form.action = `/Categorias/Ativar/${row.dataset.categoryId}`;
                    form.dataset.categoryAction = "activate";

                    button.classList.remove("danger");
                    button.classList.add("activate");
                    button.title = "Reativar categoria";

                    button.querySelector("svg").innerHTML = `
                    <path d="M4 12a8 8 0 1 0 2.3-5.7"></path>
                    <path d="M4 5v5h5"></path>
                `;
                }
            }

            function showCategoryMessage(message, success) {

                let alertBox = document.getElementById("categoryAjaxAlert");

                if (!alertBox) {
                    alertBox = document.createElement("div");
                    alertBox.id = "categoryAjaxAlert";

                    const panel = document.querySelector(".ib-category-panel");
                    panel.parentNode.insertBefore(alertBox, panel);
                }

                alertBox.className = success
                    ? "ib-category-alert success"
                    : "ib-category-alert error";

                alertBox.innerHTML = `
                <span>${message}</span>
            `;

                clearTimeout(window.categoryAlertTimeout);

                window.categoryAlertTimeout = setTimeout(function() {
                    alertBox.remove();
                }, 3500);
            }


            input.addEventListener(
    "input",
    filterCategories
);


if (seletorPagina) {

    seletorPagina.addEventListener(
        "change",
        function() {

            itensPorPagina =
                parseInt(this.value);

            paginaAtual = 1;

            mostrarPaginaCategorias();
        }
    );
}


if (paginaAnterior) {

    paginaAnterior.addEventListener(
        "click",
        function() {

            if (paginaAtual > 1) {
                paginaAtual--;
                mostrarPaginaCategorias();
            }
        }
    );
}


if (paginaSeguinte) {

    paginaSeguinte.addEventListener(
        "click",
        function() {

            const totalPaginas =
                Math.ceil(
                    rowsFiltradas.length /
                    itensPorPagina
                );

            if (paginaAtual < totalPaginas) {
                paginaAtual++;
                mostrarPaginaCategorias();
            }
        }
    );
}


filterCategories();

const statusForms =
    document.querySelectorAll(".ib-category-status-form");

            statusForms.forEach(function(form) {

                form.addEventListener("submit", async function(event) {

                    event.preventDefault();

                    const row = form.closest("[data-category-row]");
                    const button = form.querySelector("button");
                    const action = form.dataset.categoryAction;
                    const categoryName = form.dataset.categoryName;

                    const message = action === "activate"
                        ? `Pretende reativar a categoria «${categoryName}»?`
                        : `Pretende desativar a categoria «${categoryName}»?`;

                    if (!confirm(message)) {
                        return;
                    }

                    button.disabled = true;

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: new FormData(form)
                        });

                        if (!response.ok) {
                            const error = await response.json();
                            alert(error.mensagem || "Não foi possível alterar o estado da categoria.");
                            return;
                        }

                        const result = await response.json();
                        const isActivating = action === "activate";

                        updateCategoryState(row, form, isActivating);
                        showCategoryMessage(result.mensagem, true);
                    }
                    catch (error) {
                        console.error(error);
                        showCategoryMessage("Ocorreu um erro ao alterar o estado da categoria.", false);
                    }
                    finally {
                        button.disabled = false;
                    }
                });
            });
        });
    </script>
}
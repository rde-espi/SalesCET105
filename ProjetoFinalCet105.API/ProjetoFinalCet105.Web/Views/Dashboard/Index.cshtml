            <div class="ib-client-row">

                <div class="ib-person-avatar">DF</div>

                <div class="ib-client-info">
                    <strong>Diogo Ferreira</strong>
                    <span>diogoferreira@email.com</span>
                </div>

                <div class="ib-client-date">
                    <span>Hoje</span>

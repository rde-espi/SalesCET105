                </div>

                <div class="ib-notification-info">
                    <strong>Avaliação recebida</strong>
                    <span>Cliente Carla Mendes avaliou com 5 estrelas</span>
                </div>

                <span class="ib-notification-time">
                    há 2 horas
                </span>

            </div>


            <div class="ib-notification-row">

                <div class="ib-notification-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                    </svg>
                </div>

                <div class="ib-notification-info">
                    <strong>Indisponibilidade aprovada</strong>
                    <span>Indisponibilidade de Ana Costa aprovada</span>
                </div>

                <span class="ib-notification-time">

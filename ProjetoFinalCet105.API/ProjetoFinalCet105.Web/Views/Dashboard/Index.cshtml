@model DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var hoje = DateTime.Now;

    var cultura =
        new System.Globalization.CultureInfo("pt-PT");

    var dataFormatada =
        hoje.ToString(
            "dddd, d 'de' MMMM 'de' yyyy",
            cultura);

    dataFormatada =
        char.ToUpper(dataFormatada[0]) +
        dataFormatada.Substring(1);


    // =========================
    // EVOLUÇÃO DA FATURAÇÃO
    // =========================

    var labelsFaturacao =
        Model.EvolucaoMensal
            .Select(x => x.NomeMes)
            .ToList();

    var valoresFaturacao =
        Model.EvolucaoMensal
            .Select(x => x.Total)
            .ToList();


    // =========================
    // FATURAÇÃO POR CATEGORIA
    // =========================

    var labelsCategorias =
        Model.FaturacaoPorCategoria
            .Select(x => x.NomeCategoria)
            .ToList();

    var valoresCategorias =
        Model.FaturacaoPorCategoria
            .Select(x => x.TotalFaturado)
            .ToList();

    var evolucaoCompletaJson = JsonSerializer.Serialize(Model.EvolucaoMensalCompleta.Select(x => new
    {
        ano = x.Ano,
        mes = x.Mes,
        total = x.Total
    }));

    var totalFaturacaoCategorias =
        Model.FaturacaoPorCategoria
            .Sum(x => x.TotalFaturado);


}

<!-- =========================
     CABEÇALHO DASHBOARD
========================= -->

<section class="ib-dashboard-header">

    <div class="ib-dashboard-welcome">

        <h1>
            Bem-vinda, @User.Identity?.Name!
        </h1>

        <p>
            Aqui tem um resumo da atividade do Infinity Beauty.
        </p>

    </div>


    <div class="ib-dashboard-date">

        <div class="ib-dashboard-date-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">

                <rect x="3"
                      y="5"
                      width="18"
                      height="16"
                      rx="2">
                </rect>

                <path d="M8 3v4M16 3v4M3 10h18"></path>

                <path d="M8 14h2M12 14h2M16 14h1"></path>

            </svg>

        </div>


        <div>

            <strong>
                @dataFormatada
            </strong>

            <span>
                “Cuidar de si é um ato de amor.”
            </span>

        </div>

    </div>

</section>

<div class="ib-dashboard-tabs" role="tablist">

    <button type="button"
            class="ib-dashboard-tab active"
            data-dashboard-tab="overview">
        Visão Geral
    </button>

    <button type="button"
            class="ib-dashboard-tab"
            data-dashboard-tab="finance">
        Financeiro
    </button>

    <button type="button"
            class="ib-dashboard-tab"
            data-dashboard-tab="agenda">
        Agenda
    </button>

    <button type="button"
            class="ib-dashboard-tab"
            data-dashboard-tab="clients">
        Clientes
    </button>

    <button type="button"
            class="ib-dashboard-tab"
            data-dashboard-tab="team">
        Equipa
    </button>

</div>

<section class="ib-dashboard-tab-content active" data-dashboard-content="overview">

    <!-- =========================
     KPI CARDS
========================= -->

    <section class="ib-dashboard-kpis">

        <!-- MARCAÇÕES -->

        <article class="ib-kpi-card">

            <div class="ib-kpi-icon">

                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                    <path d="M8 3v4M16 3v4M3 10h18"></path>
                    <path d="M8 14h2M12 14h2"></path>
                </svg>

            </div>

            <div class="ib-kpi-content">

                <strong class="ib-kpi-value">
                    @(Model.Agenda?.TotalMarcacoesMes ?? 0)
                </strong>

                <span class="ib-kpi-label">
                    Marcações este mês
                </span>

                <div class="ib-kpi-comparison">
                    <span>Dados atuais</span>
                </div>

            </div>

        </article>


        <!-- CLIENTES -->

        <article class="ib-kpi-card">

            <div class="ib-kpi-icon">

                <svg viewBox="0 0 24 24">

                    <circle cx="9"
                            cy="8"
                            r="4">
                    </circle>

                    <circle cx="17"
                            cy="10"
                            r="3">
                    </circle>

                    <path d="M2 21c0-4 3-7 7-7s7 3 7 7"></path>

                    <path d="M16 15c3 0 5 2 5 5"></path>

                </svg>

            </div>

            <div class="ib-kpi-content">

                <strong class="ib-kpi-value">
                    @(Model.Clientes?.NovosClientesMes ?? 0)
                </strong>

                <span class="ib-kpi-label">
                    Novos clientes este mês
                </span>

                <div class="ib-kpi-comparison">
                    <span>Dados atuais</span>
                </div>

            </div>

        </article>


        <!-- FATURAÇÃO -->

        <article class="ib-kpi-card">

            <div class="ib-kpi-icon ib-kpi-euro">
                €
            </div>

            <div class="ib-kpi-content">

                <strong class="ib-kpi-value">
                    @(Model.Financeiro?.FaturacaoHoje.ToString("C2",
                        new System.Globalization.CultureInfo("pt-PT")) ?? "0,00 €")
                </strong>

                <span class="ib-kpi-label">
                    Faturação hoje
                </span>

                <div class="ib-kpi-comparison">
                    <span>Dados atuais</span>
                </div>

            </div>

        </article>


        <!-- OCUPAÇÃO -->

        <article class="ib-kpi-card">

            <div class="ib-kpi-icon">

                <svg viewBox="0 0 24 24">

                    <path d="M4 20V13"></path>
                    <path d="M10 20V9"></path>
                    <path d="M16 20V5"></path>

                </svg>

            </div>

            <div class="ib-kpi-content">

                <strong class="ib-kpi-value">
                    @($"{Model.Agenda?.TaxaOcupacao ?? 0:0.#}%")
                </strong>

                <span class="ib-kpi-label">
                    Taxa de ocupação
                </span>

                <div class="ib-kpi-comparison">
                    <span>Este mês</span>
                </div>

            </div>

        </article>


        <!-- AVALIAÇÃO -->

        <article class="ib-kpi-card">

            <div class="ib-kpi-icon ib-kpi-euro">
                €
            </div>

            <div class="ib-kpi-content">

                <strong class="ib-kpi-value">
                    @(Model.Financeiro?.ResultadoMes.ToString(
                        "C2",
                        new System.Globalization.CultureInfo("pt-PT"))
                        ?? "0,00 €")
                </strong>

                <span class="ib-kpi-label">
                    Resultado do mês
                </span>

                <div class="ib-kpi-comparison">
                    <span>
                        Após despesas
                    </span>
                </div>

            </div>

        </article>

    </section>
    <!-- =========================
     DASHBOARD - ANALYTICS
========================= -->

    <section class="ib-dashboard-analytics">

        <!-- EVOLUÇÃO DA FATURAÇÃO -->

        <article class="ib-dashboard-panel ib-revenue-panel">

            <div class="ib-panel-header">

                <h2>Evolução da faturação</h2>

                <select class="ib-dashboard-period"
                        aria-label="Período da faturação">
                    <option>Últimos 6 meses</option>
                    <option>Últimos 12 meses</option>
                    <option>Este ano</option>
                </select>

            </div>

            <div class="ib-revenue-chart">
                <canvas id="revenueChart"></canvas>
            </div>

        </article>


        <!-- FATURAÇÃO POR CATEGORIA -->

        <article class="ib-dashboard-panel ib-category-panel">

            <div class="ib-panel-header">
                <h2>Faturação por categoria</h2>
            </div>

            <div class="ib-category-chart-content">

                <div class="ib-donut-wrapper">

                    <canvas id="categoryChart"></canvas>

                    <div class="ib-donut-center">
                        <strong>
                            @totalFaturacaoCategorias.ToString(
                                "N0",
                                new System.Globalization.CultureInfo("pt-PT")) €
                        </strong>

                        <span>faturado</span>
                    </div>

                </div>

                <div class="ib-category-legend">

                    @if (Model.FaturacaoPorCategoria.Any())
                    {
                        var indiceCategoria = 0;

                        foreach (var categoria in Model.FaturacaoPorCategoria)
                        {
                            var percentagem =
                                totalFaturacaoCategorias > 0
                                    ? categoria.TotalFaturado /
                                      totalFaturacaoCategorias * 100
                                    : 0;

                            <div>
                                <span class="ib-legend-dot"
                                      data-category-index="@indiceCategoria">
                                </span>

                                <span class="ib-legend-name">
                                    @categoria.NomeCategoria
                                </span>

                                <strong>
                                    @percentagem.ToString("0.#")%
                                </strong>
                            </div>

                            indiceCategoria++;
                        }
                    }
                    else
                    {
                        <span class="ib-dashboard-empty">
                            Sem dados de faturação.
                        </span>
                    }

                </div>

            </div>

        </article>


        <!-- SERVIÇOS MAIS FATURADOS -->

        <article class="ib-dashboard-panel ib-top-services-panel">

            <div class="ib-panel-header">
                <h2>Serviços mais faturados</h2>
            </div>


            <div class="ib-top-services-list">

                @if (Model.ServicosMaisFaturados.Any())
                {
                    var posicao = 1;

                    foreach (var servico in Model.ServicosMaisFaturados)
                    {
                        var iniciais = string.Join("",
                            servico.NomeServico
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));

                        <div class="ib-service-rank">

                            <span class="ib-rank-number">
                                @posicao
                            </span>

                            <div class="ib-service-avatar">
                                @iniciais
                            </div>

                            <div class="ib-service-info">
                                <strong>@servico.NomeServico</strong>

                                <span>
                                    @servico.Quantidade
                                    @(servico.Quantidade == 1 ? "serviço" : "serviços")
                                </span>
                            </div>

                            <strong class="ib-service-value">
                                @servico.TotalFaturado.ToString(
                                    "C2",
                                    new System.Globalization.CultureInfo("pt-PT"))
                            </strong>

                        </div>

                        posicao++;
                    }
                }
                else
                {
                    <div class="ib-dashboard-empty">
                        Ainda não existem dados de faturação.
                    </div>
                }

            </div>

        </article>

    </section>
    <!-- =========================
     DASHBOARD - ATIVIDADE
========================= -->

    <section class="ib-dashboard-activity">

        <!-- AGENDA DE HOJE -->

        <article class="ib-dashboard-panel ib-agenda-panel">

            <div class="ib-panel-header">

                <h2>Agenda de hoje</h2>

                <a href="#" class="ib-panel-link">
                    Ver calendário
                </a>

            </div>


            <div class="ib-agenda-list">

                @if (Model.MarcacoesHoje.Any())
                {
                    foreach (var marcacao in Model.MarcacoesHoje)
                    {
                        var iniciaisCliente = string.Join("",
                            marcacao.ClienteNome
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));

                        var estadoCss =
                            marcacao.EstadoMarcacaoNome.ToLower() switch
                            {
                                "confirmada" => "ib-status-confirmed",
                                "pendente" => "ib-status-pending",
                                "em curso" => "ib-status-progress",
                                "concluída" => "ib-status-confirmed",
                                "cancelada" => "ib-status-cancelled",
                                _ => ""
                            };

                        <div class="ib-agenda-item">

                            <div class="ib-agenda-time">
                                <strong>
                                    @marcacao.DataHoraInicio.ToString("HH:mm")
                                </strong>

                                <span>
                                    @marcacao.DataHoraFim.ToString("HH:mm")
                                </span>
                            </div>

                            <div class="ib-person-avatar">
                                @iniciaisCliente
                            </div>

                            <div class="ib-agenda-info">

                                <strong>
                                    @marcacao.ClienteNome
                                </strong>

                                <span>
                                    @marcacao.ServicoNome
                                </span>

                                <small>
                                    @marcacao.FuncionarioNome
                                </small>

                            </div>

                            <span class="ib-status @estadoCss">
                                @marcacao.EstadoMarcacaoNome
                            </span>

                            <button class="ib-row-options"
                                    type="button"
                                    aria-label="Opções">
                                •••
                            </button>

                        </div>
                    }
                }
                else
                {
                    <div class="ib-dashboard-empty">
                        Não existem marcações para hoje.
                    </div>
                }

            </div>

        </article>


        <!-- ÚLTIMOS CLIENTES -->

        <article class="ib-dashboard-panel ib-clients-panel">

            <div class="ib-panel-header">

                <h2>Últimos clientes</h2>

                <a href="#" class="ib-panel-link">
                    Ver todos
                </a>

            </div>


            <div class="ib-recent-clients">

                @if (Model.UltimosClientes.Any())
                {
                    foreach (var cliente in Model.UltimosClientes)
                    {
                        var iniciais = string.Join("",
                            cliente.NomeCompleto
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));

                        var dataCliente =
                            cliente.DataCriacao.Date == DateTime.Today
                                ? "Hoje"
                                : cliente.DataCriacao.ToString("dd/MM/yyyy");

                        <div class="ib-client-row">

                            <div class="ib-person-avatar">
                                @iniciais
                            </div>

                            <div class="ib-client-info">

                                <strong>
                                    @cliente.NomeCompleto
                                </strong>

                                <span>
                                    @cliente.Email
                                </span>

                            </div>

                            <div class="ib-client-date">

                                <span>
                                    @dataCliente
                                </span>

                                <strong>
                                    @cliente.DataCriacao.ToString("HH:mm")
                                </strong>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="ib-dashboard-empty">
                        Ainda não existem clientes registados.
                    </div>
                }

            </div>

        </article>


        <!-- DESEMPENHO DA EQUIPA -->

        <article class="ib-dashboard-panel ib-team-panel">

            <div class="ib-panel-header">

                <h2>Desempenho da equipa</h2>

                <a href="#" class="ib-panel-link">
                    Ver equipa
                </a>

            </div>

            <div class="ib-team-list">

                @if (Model.Equipa.Any())
                {
                    foreach (var funcionario in Model.Equipa.Take(5))
                    {
                        var iniciais = string.Join("",
                            funcionario.NomeFuncionario
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));

                        <div class="ib-team-row">

                            <div class="ib-person-avatar">
                                @iniciais
                            </div>

                            <div class="ib-team-info">

                                <strong>
                                    @funcionario.NomeFuncionario
                                </strong>

                                <span>
                                    @funcionario.MarcacoesConcluidas
                                    @(funcionario.MarcacoesConcluidas == 1
                                        ? "serviço concluído"
                                        : "serviços concluídos")
                                </span>

                            </div>

                            <div class="ib-team-performance">

                                <strong>
                                    @funcionario.TotalFaturado.ToString("N2", cultura) €
                                </strong>

                                <span>
                                    ★ @funcionario.AvaliacaoMedia.ToString("N1", cultura)
                                </span>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="ib-dashboard-empty">
                        Ainda não existem dados de desempenho da equipa.
                    </div>
                }

            </div>

        </article>

    </section>
</section>

<section class="ib-dashboard-tab-content" data-dashboard-content="finance">

    <div class="ib-dashboard-section-header">
        <div>
            <span class="ib-section-eyebrow">Análise financeira</span>
            <h2>Financeiro</h2>
            <p>
                Acompanhe a faturação, despesas e desempenho financeiro
                do Infinity Beauty.
            </p>
        </div>
    </div>

    @if (Model.Financeiro != null)
    {
        <!-- RESUMO PRINCIPAL -->
        <div class="ib-finance-main-grid">

            <article class="ib-finance-main-card">
                <span class="ib-finance-label">Faturação hoje</span>
                <strong>
                    @Model.Financeiro.FaturacaoHoje.ToString("N2", cultura) €
                </strong>
                <small>Receita do dia</small>
            </article>

            <article class="ib-finance-main-card">
                <span class="ib-finance-label">Esta semana</span>
                <strong>
                    @Model.Financeiro.FaturacaoSemana.ToString("N2", cultura) €
                </strong>
                <small>Faturação semanal</small>
            </article>

            <article class="ib-finance-main-card">
                <span class="ib-finance-label">Este mês</span>
                <strong>
                    @Model.Financeiro.FaturacaoMes.ToString("N2", cultura) €
                </strong>
                <small>Faturação mensal</small>
            </article>

            @{
                var classeResultado = Model.Financeiro.ResultadoMes switch
                {
                    > 0 => "positive",
                    < 0 => "negative",
                    _ => "neutral"
                };
            }

            <article class="ib-finance-main-card ib-finance-result @classeResultado">

                <span class="ib-finance-label">
                    Resultado do mês
                </span>

                <strong>
                    @Model.Financeiro.ResultadoMes.ToString("N2", cultura) €
                </strong>

                <small>
                    @if (Model.Financeiro.ResultadoMes > 0)
                    {
                        <text>Resultado positivo após despesas</text>
                    }
                    else if (Model.Financeiro.ResultadoMes < 0)
                    {
                        <text>Despesas superiores à faturação</text>
                    }
                    else
                    {
                        <text>Faturação e despesas equilibradas</text>
                    }
                </small>

            </article>

        </div>


        <!-- INDICADORES -->
        <div class="ib-finance-secondary-grid">

            <article class="ib-finance-small-card">
                <span>Despesas do mês</span>
                <strong>
                    @Model.Financeiro.DespesasMes.ToString("N2", cultura) €
                </strong>
            </article>

            <article class="ib-finance-small-card">
                <span>Ticket médio</span>
                <strong>
                    @Model.Financeiro.TicketMedioMes.ToString("N2", cultura) €
                </strong>
            </article>

            <article class="ib-finance-small-card">
                <span>Total de faturas</span>
                <strong>
                    @Model.Financeiro.TotalFaturasMes
                </strong>
            </article>

            <article class="ib-finance-small-card">
                <span>Margem</span>
                <strong>
                    @Model.Financeiro.MargemPercentualMes.ToString("N1", cultura)%
                </strong>
            </article>

        </div>


        <!-- ANÁLISE FISCAL -->
        <article class="ib-dashboard-panel ib-finance-tax">

            <div class="ib-panel-header">
                <div>
                    <h2>Distribuição fiscal</h2>
                    <span>Faturação do mês por identificação fiscal</span>
                </div>
            </div>

            <div class="ib-tax-grid">

                <div class="ib-tax-block">

                    <span>Com NIF</span>

                    <strong>
                        @Model.Financeiro.ValorComNifMes.ToString("N2", cultura) €
                    </strong>

                    <small>
                        @Model.Financeiro.FaturasComNifMes
                        @(Model.Financeiro.FaturasComNifMes == 1
                            ? "fatura"
                            : "faturas")
                    </small>

                </div>

                <div class="ib-tax-divider"></div>

                <div class="ib-tax-block">

                    <span>Sem NIF</span>

                    <strong>
                        @Model.Financeiro.ValorSemNifMes.ToString("N2", cultura) €
                    </strong>

                    <small>
                        @Model.Financeiro.FaturasSemNifMes
                        @(Model.Financeiro.FaturasSemNifMes == 1
                            ? "fatura"
                            : "faturas")
                    </small>

                </div>

            </div>

        </article>

        <div class="ib-finance-analysis-header">
            <div>
                <span class="ib-section-eyebrow">Tendências e desempenho</span>
                <h2>Análise financeira</h2>
            </div>

            <select id="financePeriod"
                    class="ib-dashboard-period"
                    aria-label="Período da análise financeira">

                <option value="6">Últimos 6 meses</option>
                <option value="12">Últimos 12 meses</option>
                <option value="year">Este ano</option>

            </select>
        </div>

        <div class="ib-finance-analysis-grid">

            <!-- EVOLUÇÃO -->
            <article class="ib-dashboard-panel ib-finance-evolution">

                <div class="ib-panel-header">
                    <div>
                        <h2>Evolução da faturação</h2>
                        <span>Receita faturada ao longo do período</span>
                    </div>
                </div>

                <div class="ib-chart-container ib-finance-chart">
                    <canvas id="financeRevenueChart"></canvas>
                </div>

            </article>


            <!-- CATEGORIAS -->
            <article class="ib-dashboard-panel">

                <div class="ib-panel-header">
                    <div>
                        <h2>Faturação por categoria</h2>
                        <span>Distribuição da receita por área</span>
                    </div>
                </div>

                @if (Model.FaturacaoPorCategoria.Any())
                {
                    var totalCategoriasFinanceiro =
                        Model.FaturacaoPorCategoria.Sum(x => x.TotalFaturado);

                    <div class="ib-finance-category-list">

                        @foreach (var categoria in
                            Model.FaturacaoPorCategoria
                                .OrderByDescending(x => x.TotalFaturado))
                        {
                            var percentagem =
                                totalCategoriasFinanceiro > 0
                                    ? categoria.TotalFaturado /
                                      totalCategoriasFinanceiro * 100
                                    : 0;

                            <div class="ib-finance-category-row">

                                <div class="ib-finance-category-head">
                                    <strong>@categoria.NomeCategoria</strong>

                                    <span>
                                        @categoria.TotalFaturado.ToString("N2", cultura) €
                                    </span>
                                </div>

                                <div class="ib-finance-progress">
                                    <span style="width:@percentagem.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                </div>

                                <small>
                                    @percentagem.ToString("N1", cultura)% da faturação
                                </small>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="ib-dashboard-empty">
                        Ainda não existem dados de faturação por categoria.
                    </div>
                }

            </article>

        </div>
        <article class="ib-dashboard-panel ib-finance-services-panel">

            <div class="ib-panel-header">
                <div>
                    <h2>Serviços mais faturados</h2>
                    <span>Serviços com maior contribuição para a receita</span>
                </div>
            </div>

            @if (Model.ServicosMaisFaturados.Any())
            {
                <div class="ib-finance-services-table">

                    <div class="ib-finance-table-head">
                        <span>Serviço</span>
                        <span>Quantidade</span>

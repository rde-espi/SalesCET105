                    •••
                </button>

            </div>


            <div class="ib-agenda-item">

                <div class="ib-agenda-time">
                    <strong>14:00</strong>
                    <span>15:00</span>
                </div>

                <div class="ib-person-avatar">AR</div>

                <div class="ib-agenda-info">
                    <strong>Ana Ribeiro</strong>
                    <span>Massagem Relaxante</span>
                    <small>João Pereira</small>
                </div>

                <span class="ib-status ib-status-confirmed">
                    Confirmada
                </span>

                <button class="ib-row-options"
                        type="button"
                        aria-label="Opções">
                    •••
                </button>

            </div>


            <div class="ib-agenda-item">

                <div class="ib-agenda-time">
                    <strong>16:00</strong>
                    <span>16:45</span>
                </div>

                <div class="ib-person-avatar">SA</div>

                <div class="ib-agenda-info">
                    <strong>Sofia Almeida</strong>
                    <span>Coloração</span>
                    <small>Ana Costa</small>
                </div>

                <span class="ib-status ib-status-pending">
                    Pendente
                </span>

                <button class="ib-row-options"
                        type="button"
                        aria-label="Opções">
                    •••
                </button>

            </div>

        </div>

    </article>


    <!-- ÚLTIMOS CLIENTES -->

    <article class="ib-dashboard-panel ib-clients-panel">

        <div class="ib-panel-header">

            <h2>Últimos clientes</h2>

            <a href="#" class="ib-panel-link">
                Ver todos
            </a>

        </div>


        <div class="ib-recent-clients">

            <div class="ib-client-row">

                <div class="ib-person-avatar">MC</div>

                <div class="ib-client-info">
                    <strong>Mariana Costa</strong>
                    <span>marianacosta@email.com</span>
                </div>

                <div class="ib-client-date">
                    <span>Hoje</span>

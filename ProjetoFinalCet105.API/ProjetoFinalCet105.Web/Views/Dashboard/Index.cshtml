                </span>

            </div>

        </div>

    </article>

</section>
@section Scripts {

    <script>

        /* =========================
           FATURAÇÃO
        ========================= */

        const revenueCanvas =
            document.getElementById("revenueChart");

        if (revenueCanvas) {

            new Chart(revenueCanvas, {

                type: "line",

                data: {

                    labels: [
                        "Abr",
                        "Mai",
                        "Jun",
                        "Jul",
                        "Ago",
                        "Set"
                    ],

                    datasets: [{
                        data: [
                            2200,
                            3400,
                            4700,
                            4100,
                            5800,
                            7500
                        ],

                        borderColor: "#b57d27",

                        backgroundColor:
                            "rgba(216, 176, 113, 0.15)",

                        borderWidth: 2,

                        pointRadius: 3,

                        pointBackgroundColor:
                            "#b57d27",

                        pointBorderColor:
                            "#b57d27",

                        fill: true,

                        tension: 0
                    }]
                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        x: {

                            grid: {
                                color:
                                    "rgba(80, 70, 55, 0.07)"
                            },

                            ticks: {
                                color: "#777168",

                                font: {
                                    size: 9
                                }
                            }

                        },

                        y: {

                            beginAtZero: true,

                            grid: {
                                color:
                                    "rgba(80, 70, 55, 0.08)"
                            },

                            ticks: {

                                color: "#777168",

                                font: {
                                    size: 9
                                },

                                callback: function(value) {

                                    return new Intl.NumberFormat(
                                        "pt-PT"
                                    ).format(value) + " €";
                                }

                            }

                        }

                    }

                }

            });

        }


        /* =========================
           CATEGORIAS
        ========================= */

        const categoryCanvas =
            document.getElementById("categoryChart");

        if (categoryCanvas) {

            new Chart(categoryCanvas, {

                type: "doughnut",

                data: {

                    labels: [
                        "Cabelo",
                        "Estética",
                        "Unhas",
                        "Wellness",
                        "Outros"
                    ],

                    datasets: [{

                        data: [
                            35,
                            28,
                            18,
                            12,
                            7
                        ],

                        backgroundColor: [
                            "#aa7928",
                            "#cf9d48",
                            "#edc77d",
                            "#dfad58",
                            "#d8d3ca"
                        ],

                        borderColor:
                            "#fffdfa",

                        borderWidth: 1

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: "67%",

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {

                            callbacks: {

                                label: function(context) {
                                    return context.label +
                                        ": " +
                                        context.raw +
                                        "%";
                                }

                            }

                        }

                    }

                }

            });

        }

    </script>

}
                    <span>09:45</span>
                </div>

                <div class="ib-person-avatar">MS</div>

                <div class="ib-agenda-info">
                    <strong>Maria Silva</strong>
                    <span>Limpeza de Pele</span>
                    <small>Ana Costa</small>
                </div>

                <span class="ib-status ib-status-progress">
                    Em curso
                </span>

                <button class="ib-row-options"
                        type="button"
                        aria-label="Opções">
                    •••
                </button>

            </div>


            <div class="ib-agenda-item">

                <div class="ib-agenda-time">
                    <strong>10:00</strong>

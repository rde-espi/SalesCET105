@section Scripts {
    <script>
        /* =========================================================
           DADOS RAZOR -> JAVASCRIPT
        ========================================================= */
        const overviewRevenueLabels = @Html.Raw(JsonSerializer.Serialize(labelsFaturacao));
        const overviewRevenueValues = @Html.Raw(JsonSerializer.Serialize(valoresFaturacao));
        const financeRevenueData = @Html.Raw(evolucaoCompletaJson);
        const categoryLabels = @Html.Raw(JsonSerializer.Serialize(labelsCategorias));
        const categoryValues = @Html.Raw(JsonSerializer.Serialize(valoresCategorias));

        /* =========================================================
           FUNÇÕES AUXILIARES
        ========================================================= */
        function formatCurrency(value, maximumFractionDigits = 2) {
            return new Intl.NumberFormat('pt-PT', {
                style: 'currency',
                currency: 'EUR',
                maximumFractionDigits: maximumFractionDigits
            }).format(Number(value) || 0);
        }

        function getMonthlyRevenue(year, month) {
            const item = financeRevenueData.find(x =>
                x.ano === year && x.mes === month
            );

            return item ? Number(item.total) : 0;
        }

        function buildRevenuePeriod(period) {
            const today = new Date();
            const currentYear = today.getFullYear();
            const currentMonth = today.getMonth() + 1;
            const dates = [];

            if (period === 'year') {
                for (let month = 1; month <= currentMonth; month++) {
                    dates.push({
                        year: currentYear,
                        month: month
                    });
                }
            } else {
                const months = period === '12' ? 12 : 6;

                for (let i = months - 1; i >= 0; i--) {
                    const date = new Date(
                        currentYear,
                        currentMonth - 1 - i,
                        1
                    );

                    dates.push({
                        year: date.getFullYear(),
                        month: date.getMonth() + 1
                    });
                }
            }

            const labels = dates.map(item => {
                const date = new Date(item.year, item.month - 1, 1);

                return date.toLocaleDateString('pt-PT', {
                    month: 'short',
                    year: period === '12' ? '2-digit' : undefined
                });
            });

            const values = dates.map(item =>
                getMonthlyRevenue(item.year, item.month)
            );

            return { labels, values };
        }

        function calculateRevenueScale(values) {
            const numericValues = values.map(value => Number(value) || 0);
            const maxValue = Math.max(...numericValues, 0);

            if (maxValue <= 0) {
                return {
                    min: 0,
                    max: 5,
                    step: 1
                };
            }

            // Aproximadamente 5 intervalos entre 0 e o valor máximo.
            const rawStep = maxValue / 5;
            const magnitude = Math.pow(
                10,
                Math.floor(Math.log10(rawStep))
            );
            const normalizedStep = rawStep / magnitude;

            let niceStep;

            if (normalizedStep <= 1) {
                niceStep = 1;
            } else if (normalizedStep <= 2) {
                niceStep = 2;
            } else if (normalizedStep <= 5) {
                niceStep = 5;
            } else {
                niceStep = 10;
            }

            const step = niceStep * magnitude;
            let max = Math.ceil(maxValue / step) * step;

            // Garante espaço visual acima do maior ponto quando ele cai
            // exatamente no último tick.
            if (max === maxValue) {
                max += step;
            }

            return {
                min: 0,
                max: max,
                step: step
            };
        }

        /* =========================================================
           VISÃO GERAL - EVOLUÇÃO DA FATURAÇÃO
        ========================================================= */
        const revenueCanvas = document.getElementById('revenueChart');
        let overviewRevenueChart = null;

        if (revenueCanvas) {
            overviewRevenueChart = new Chart(revenueCanvas, {
                type: 'line',
                data: {
                    labels: overviewRevenueLabels,
                    datasets: [{
                        label: 'Faturação',
                        data: overviewRevenueValues,
                        borderColor: '#b57d27',
                        backgroundColor: 'rgba(216, 176, 113, 0.15)',
                        borderWidth: 2,
                        pointRadius: 3,
                        pointBackgroundColor: '#b57d27',
                        pointBorderColor: '#b57d27',
                        fill: true,
                        tension: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: context => formatCurrency(context.raw)
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(80, 70, 55, 0.07)'
                            },
                            ticks: {
                                color: '#777168',
                                font: {
                                    size: 9
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(80, 70, 55, 0.08)'
                            },
                            ticks: {
                                color: '#777168',
                                font: {
                                    size: 9
                                },
                                callback: value => formatCurrency(value, 0)
                            }
                        }
                    }
                }
            });
        }

        /* =========================================================
           VISÃO GERAL - FATURAÇÃO POR CATEGORIA
        ========================================================= */
        const categoryCanvas = document.getElementById('categoryChart');

        if (categoryCanvas && categoryValues.length > 0) {
            const categoryColors = [
                '#aa7928',
                '#cf9d48',
                '#edc77d',
                '#dfad58',
                '#d8d3ca',
                '#8f6728',
                '#bea256',
                '#e4c894'
            ];

            new Chart(categoryCanvas, {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryValues,
                        backgroundColor: categoryLabels.map(
                            (_, index) => categoryColors[index % categoryColors.length]
                        ),
                        borderColor: '#fffdfa',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '67%',
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce(
                                        (sum, value) => sum + Number(value),
                                        0
                                    );
                                    const value = Number(context.raw);
                                    const percentage = total > 0
                                        ? (value / total) * 100
                                        : 0;

                                    return `${context.label}: ${formatCurrency(value)} (${percentage.toFixed(1)}%)`;
                                }
                            }
                        }
                    }
                }
            });

            document
                .querySelectorAll('.ib-legend-dot[data-category-index]')
                .forEach(dot => {
                    const index = Number(dot.dataset.categoryIndex);
                    dot.style.backgroundColor =
                        categoryColors[index % categoryColors.length];
                });
        }

        /* =========================================================
           FINANCEIRO - EVOLUÇÃO DA FATURAÇÃO
        ========================================================= */
        const financeRevenueCanvas = document.getElementById('financeRevenueChart');
        let financeRevenueChart = null;

        if (financeRevenueCanvas) {
            financeRevenueChart = new Chart(financeRevenueCanvas, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Faturação',
                        data: [],
                        borderColor: '#D8B071',
                        backgroundColor: 'rgba(216, 176, 113, 0.10)',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#D8B071',
                        pointBorderColor: '#D8B071',
                        tension: 0.35,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            top: 8,
                            right: 8,
                            bottom: 30,
                            left: 4
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: context => formatCurrency(context.raw)
                            }
                        }
                    },
                    scales: {
                        x: {
                            display: true,
                            offset: true,

                            grid: {
                                display: false,
                                drawBorder: true
                            },

                            border: {
                                display: true,
                                color: 'rgba(80, 70, 55, 0.18)'
                            },

                            ticks: {
                                display: true,
                                color: '#777168',
                                padding: 10,
                                maxRotation: 0,
                                minRotation: 0
                            }
                        },
                        y: {
                            min: 0,
                            max: 5,
                            grid: {
                                color: 'rgba(80, 70, 55, 0.08)'
                            },
                            ticks: {
                                stepSize: 1,
                                padding: 8,
                                color: '#777168',
                                callback: function(value) {

                                    if (value >= 1000000) {
                                        return (value / 1000000)
                                            .toLocaleString('pt-PT', {
                                                maximumFractionDigits: 1
                                            }) + ' M€';
                                    }

                                    if (value >= 1000) {
                                        return (value / 1000)
                                            .toLocaleString('pt-PT', {
                                                maximumFractionDigits: 1
                                            }) + ' mil €';
                                    }

                                    return value.toLocaleString('pt-PT', {
                                        maximumFractionDigits: 0
                                    }) + ' €';
                                }
                            }
                        }
                    }
                }
            });
        }

        function updateFinanceRevenueChart(period) {
            if (!financeRevenueChart) {
                return;
            }

            const data = buildRevenuePeriod(period);
            const scale = calculateRevenueScale(data.values);

            financeRevenueChart.data.labels = data.labels;
            financeRevenueChart.data.datasets[0].data = data.values;

            financeRevenueChart.options.scales.y.min = scale.min;
            financeRevenueChart.options.scales.y.max = scale.max;
            financeRevenueChart.options.scales.y.ticks.stepSize = scale.step;

            financeRevenueChart.update();
        }

        const financePeriod = document.getElementById('financePeriod');

        if (financePeriod && financeRevenueChart) {
            financePeriod.addEventListener('change', function() {
                updateFinanceRevenueChart(this.value);
            });

            updateFinanceRevenueChart(financePeriod.value);
        }

        /* =========================================================
           SEPARADORES DO DASHBOARD
        ========================================================= */
        const dashboardTabs = document.querySelectorAll('[data-dashboard-tab]');
        const dashboardContents = document.querySelectorAll('[data-dashboard-content]');

        dashboardTabs.forEach(tab => {
            tab.addEventListener('click', function() {
                const target = this.dataset.dashboardTab;

                dashboardTabs.forEach(item => {
                    item.classList.remove('active');
                });

                dashboardContents.forEach(content => {
                    content.classList.remove('active');
                });

                this.classList.add('active');

                const targetContent = document.querySelector(
                    `[data-dashboard-content="${target}"]`
                );

                targetContent?.classList.add('active');

                // Charts criados dentro de tabs escondidos precisam de resize
                // depois de o respetivo conteúdo ficar visível.
                window.setTimeout(() => {
                    if (target === 'overview') {
                        overviewRevenueChart?.resize();
                        Chart.getChart('categoryChart')?.resize();
                    }

                    if (target === 'finance') {
                        financeRevenueChart?.resize();
                    }
                }, 50);
            });
        });
    </script>
}

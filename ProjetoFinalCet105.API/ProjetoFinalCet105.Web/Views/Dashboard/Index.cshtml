@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var hoje = DateTime.Now;

    var cultura = new System.Globalization.CultureInfo("pt-PT");

    var dataFormatada =
        hoje.ToString("dddd, d 'de' MMMM 'de' yyyy", cultura);

    dataFormatada =
        char.ToUpper(dataFormatada[0]) + dataFormatada.Substring(1);
}

<!-- =========================
     CABEÇALHO DASHBOARD
========================= -->

<section class="ib-dashboard-header">

    <div class="ib-dashboard-welcome">

        <h1>
            Bem-vinda, @User.Identity?.Name!
        </h1>

        <p>
            Aqui tem um resumo da atividade do Infinity Beauty.
        </p>

    </div>


    <div class="ib-dashboard-date">

        <div class="ib-dashboard-date-icon">

            <svg viewBox="0 0 24 24"
                 aria-hidden="true">

                <rect x="3"
                      y="5"
                      width="18"
                      height="16"
                      rx="2">
                </rect>

                <path d="M8 3v4M16 3v4M3 10h18"></path>

                <path d="M8 14h2M12 14h2M16 14h1"></path>

            </svg>

        </div>


        <div>

            <strong>
                @dataFormatada
            </strong>

            <span>
                “Cuidar de si é um ato de amor.”
            </span>

        </div>

    </div>

</section>


<!-- =========================
     KPI CARDS
========================= -->

<section class="ib-dashboard-kpis">

    <!-- MARCAÇÕES -->

    <article class="ib-kpi-card">

        <div class="ib-kpi-icon">

            <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                <path d="M8 3v4M16 3v4M3 10h18"></path>
                <path d="M8 14h2M12 14h2"></path>
            </svg>

        </div>

        <div class="ib-kpi-content">

            <strong class="ib-kpi-value">
                28
            </strong>

            <span class="ib-kpi-label">
                Marcações hoje
            </span>

            <div class="ib-kpi-comparison positive">
                <strong>▲ +12%</strong>
                <span>vs. semana anterior</span>
            </div>

        </div>

    </article>


    <!-- CLIENTES -->

    <article class="ib-kpi-card">

        <div class="ib-kpi-icon">

            <svg viewBox="0 0 24 24">

                <circle cx="9"
                        cy="8"
                        r="4">
                </circle>

                <circle cx="17"
                        cy="10"
                        r="3">
                </circle>

                <path d="M2 21c0-4 3-7 7-7s7 3 7 7"></path>

                <path d="M16 15c3 0 5 2 5 5"></path>

            </svg>

        </div>

        <div class="ib-kpi-content">

            <strong class="ib-kpi-value">
                42
            </strong>

            <span class="ib-kpi-label">
                Clientes esta semana
            </span>

            <div class="ib-kpi-comparison positive">
                <strong>▲ +8%</strong>
                <span>vs. semana anterior</span>
            </div>

        </div>

    </article>


    <!-- FATURAÇÃO -->

    <article class="ib-kpi-card">

        <div class="ib-kpi-icon ib-kpi-euro">
            €
        </div>

        <div class="ib-kpi-content">

            <strong class="ib-kpi-value">
                1.250,00 €
            </strong>

            <span class="ib-kpi-label">
                Faturação hoje
            </span>

            <div class="ib-kpi-comparison positive">
                <strong>▲ +15%</strong>
                <span>vs. semana anterior</span>
            </div>

        </div>

    </article>


    <!-- OCUPAÇÃO -->

    <article class="ib-kpi-card">

        <div class="ib-kpi-icon">

            <svg viewBox="0 0 24 24">

                <path d="M4 20V13"></path>
                <path d="M10 20V9"></path>
                <path d="M16 20V5"></path>

            </svg>

        </div>

        <div class="ib-kpi-content">

            <strong class="ib-kpi-value">
                78%
            </strong>

            <span class="ib-kpi-label">
                Taxa de ocupação
            </span>

            <div class="ib-kpi-comparison positive">
                <strong>▲ +6%</strong>
                <span>vs. semana anterior</span>
            </div>

        </div>

    </article>


    <!-- AVALIAÇÃO -->

    <article class="ib-kpi-card">

        <div class="ib-kpi-icon">

            <svg viewBox="0 0 24 24">

                <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z"></path>

            </svg>

        </div>

        <div class="ib-kpi-content">

            <strong class="ib-kpi-value">
                4,8
            </strong>

            <span class="ib-kpi-label">
                Avaliação média
            </span>

            <div class="ib-kpi-comparison positive">
                <strong>▲ +0,2</strong>
                <span>vs. mês anterior</span>
            </div>

        </div>

    </article>

</section>
<!-- =========================
     DASHBOARD - ANALYTICS
========================= -->

<section class="ib-dashboard-analytics">

    <!-- EVOLUÇÃO DA FATURAÇÃO -->

    <article class="ib-dashboard-panel ib-revenue-panel">

        <div class="ib-panel-header">

            <h2>Evolução da faturação</h2>

            <select class="ib-dashboard-period"
                    aria-label="Período da faturação">
                <option>Últimos 6 meses</option>
                <option>Últimos 12 meses</option>
                <option>Este ano</option>
            </select>

        </div>

        <div class="ib-revenue-chart">
            <canvas id="revenueChart"></canvas>
        </div>

    </article>


    <!-- MARCAÇÕES POR CATEGORIA -->

    <article class="ib-dashboard-panel ib-category-panel">

        <div class="ib-panel-header">
            <h2>Marcações por categoria</h2>
        </div>

        <div class="ib-category-chart-content">

            <div class="ib-donut-wrapper">

                <canvas id="categoryChart"></canvas>

                <div class="ib-donut-center">
                    <strong>128</strong>
                    <span>marcações</span>
                </div>

            </div>


            <div class="ib-category-legend">

                <div>
                    <span class="ib-legend-dot category-1"></span>
                    <span class="ib-legend-name">Cabelo</span>
                    <strong>35%</strong>
                </div>

                <div>
                    <span class="ib-legend-dot category-2"></span>
                    <span class="ib-legend-name">Estética</span>
                    <strong>28%</strong>
                </div>

                <div>
                    <span class="ib-legend-dot category-3"></span>
                    <span class="ib-legend-name">Unhas</span>
                    <strong>18%</strong>
                </div>

                <div>
                    <span class="ib-legend-dot category-4"></span>
                    <span class="ib-legend-name">Wellness</span>
                    <strong>12%</strong>
                </div>

                <div>
                    <span class="ib-legend-dot category-5"></span>
                    <span class="ib-legend-name">Outros</span>
                    <strong>7%</strong>
                </div>

            </div>

        </div>

    </article>


    <!-- SERVIÇOS MAIS FATURADOS -->

    <article class="ib-dashboard-panel ib-top-services-panel">

        <div class="ib-panel-header">
            <h2>Serviços mais faturados</h2>
        </div>


        <div class="ib-top-services">

            <div class="ib-top-service">

                <span class="ib-service-position">1</span>

                <div class="ib-service-placeholder">
                    TF
                </div>

                <div class="ib-service-info">
                    <strong>Tratamento Facial</strong>
                    <span>28 marcações</span>
                </div>

                <strong class="ib-service-revenue">
                    420,00 €
                </strong>

            </div>


            <div class="ib-top-service">

                <span class="ib-service-position">2</span>

                <div class="ib-service-placeholder">
                    MR
                </div>

                <div class="ib-service-info">
                    <strong>Massagem Relaxante</strong>
                    <span>24 marcações</span>
                </div>

                <strong class="ib-service-revenue">
                    360,00 €
                </strong>

            </div>


            <div class="ib-top-service">

                <span class="ib-service-position">3</span>

                <div class="ib-service-placeholder">
                    MG
                </div>

                <div class="ib-service-info">
                    <strong>Manicure Gel</strong>
                    <span>31 marcações</span>
                </div>

                <strong class="ib-service-revenue">
                    310,00 €
                </strong>

            </div>


            <div class="ib-top-service">

                <span class="ib-service-position muted">4</span>

                <div class="ib-service-placeholder">
                    CF
                </div>

                <div class="ib-service-info">
                    <strong>Corte Feminino</strong>
                    <span>19 marcações</span>
                </div>

                <strong class="ib-service-revenue">
                    280,00 €
                </strong>

            </div>


            <div class="ib-top-service">

                <span class="ib-service-position muted">5</span>

                <div class="ib-service-placeholder">
                    LP
                </div>

                <div class="ib-service-info">
                    <strong>Limpeza de Pele</strong>
                    <span>18 marcações</span>
                </div>

                <strong class="ib-service-revenue">
                    250,00 €
                </strong>

            </div>

        </div>

    </article>

</section>
<!-- =========================
     DASHBOARD - ATIVIDADE
========================= -->

<section class="ib-dashboard-activity">

    <!-- AGENDA DE HOJE -->


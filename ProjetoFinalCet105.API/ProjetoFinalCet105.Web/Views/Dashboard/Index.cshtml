                </div>

                <div class="ib-person-avatar">JP</div>

                <div class="ib-agenda-info">
                    <strong>Joana Pereira</strong>
                    <span>Manicure Gel</span>
                    <small>Sofia Almeida</small>
                </div>

                <span class="ib-status ib-status-confirmed">
                    Confirmada
                </span>

                <button class="ib-row-options"
                        type="button"
                        aria-label="Opções">
                    •••
                </button>

            </div>


            <div class="ib-agenda-item">

                <div class="ib-agenda-time">
                    <strong>11:15</strong>
                    <span>12:00</span>
                </div>

                <div class="ib-person-avatar">CM</div>

                <div class="ib-agenda-info">
                    <strong>Carla Mendes</strong>

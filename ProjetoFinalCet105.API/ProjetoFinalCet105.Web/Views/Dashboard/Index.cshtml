                </div>

            </div>


            <div class="ib-client-row">

                <div class="ib-person-avatar">RS</div>

                <div class="ib-client-info">
                    <strong>Rui Santos</strong>
                    <span>ruisantos@email.com</span>
                </div>

                <div class="ib-client-date">
                    <span>Hoje</span>
                    <strong>15:10</strong>
                </div>

            </div>


            <div class="ib-client-row">

                <div class="ib-person-avatar">CM</div>

                <div class="ib-client-info">
                    <strong>Carla Mendes</strong>
                    <span>carlamendes@email.com</span>
                </div>

                <div class="ib-client-date">
